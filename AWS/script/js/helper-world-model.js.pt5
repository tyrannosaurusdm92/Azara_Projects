function vitality(input={}){const f={intergenerationalTransmission:clamp(input.intergenerationalTransmission??input.transmission??1),absoluteSpeakers:clamp(input.absoluteSpeakersNormalized??input.speakers??.8),speakerProportion:clamp(input.speakerProportion??.8),domains:clamp(input.domains??.8),newMedia:clamp(input.newMedia??.6),educationLiteracy:clamp(input.educationLiteracy??.5),governmentPolicy:clamp(input.governmentPolicy??.5),communityAttitudes:clamp(input.communityAttitudes??.7),documentation:clamp(input.documentation??.4)};const w={intergenerationalTransmission:.24,absoluteSpeakers:.08,speakerProportion:.1,domains:.14,newMedia:.08,educationLiteracy:.1,governmentPolicy:.08,communityAttitudes:.1,documentation:.08};let score=0;for(const k of VITALITY_FACTORS)score+=f[k]*w[k];const status=score>.86?STATUS[0]:score>.72?STATUS[1]:score>.58?STATUS[2]:score>.44?STATUS[3]:score>.3?STATUS[4]:score>.16?STATUS[5]:score>.05?STATUS[6]:STATUS[7];return {score,status,factors:f,note:'Worldbuilding heuristic only. Following UNESCO-style guidance, no single factor determines real language vitality; community evidence and intergenerational transmission require separate attention.'};}
function applyEvent(v,event={}){const x=clone(v.factors||v),i=clamp(event.intensity??.5),plus=(k,n)=>x[k]=clamp((x[k]??.5)+n*i);switch(event.type){case'migration':case'diaspora':plus('domains',-.08);plus('speakerProportion',-.12);plus('newMedia',.04);break;case'urbanization':plus('domains',-.08);plus('speakerProportion',-.08);plus('newMedia',.08);break;case'conquest':case'colonization':plus('governmentPolicy',-.18);plus('domains',-.13);plus('communityAttitudes',-.05);break;case'mass-schooling':plus('educationLiteracy',event.languageOfEducation==='target'?.2:-.14);plus('intergenerationalTransmission',event.languageOfEducation==='target'?.06:-.08);break;case'language-ban':plus('governmentPolicy',-.3);plus('domains',-.22);plus('educationLiteracy',-.2);break;case'official-recognition':plus('governmentPolicy',.25);plus('domains',.12);break;case'revitalization':plus('communityAttitudes',.24);plus('educationLiteracy',.2);plus('newMedia',.18);plus('intergenerationalTransmission',.12);break;case'printing':case'broadcast-media':case'internet':plus('newMedia',.2);plus('documentation',.08);break;case'population-collapse':case'epidemic':case'war':plus('absoluteSpeakers',-.26);plus('intergenerationalTransmission',-.1);break;case'literacy-campaign':plus('educationLiteracy',.28);plus('documentation',.14);break;case'prestige-shift':plus('communityAttitudes',Number(event.direction||-1)*.18);plus('domains',Number(event.direction||-1)*.12);break;}return vitality(x);}
function history(base={},events=[],years=1500){let v=vitality(base),out=[{year:0,...v,event:null}];for(const e of [...events].sort((a,b)=>(a.year||0)-(b.year||0)).filter(e=>(e.year||0)<=years)){v=applyEvent(v,e);out.push({year:e.year,...v,event:clone(e)});}if(out.at(-1).year!==years)out.push({year:years,...v,event:null});return out;}
function dialectTree(opts={}){const r=rng(opts.seed||'dialects'),years=Number(opts.years||1500),root={id:'d0',name:opts.rootName||'Proto dialect continuum',year:0,parent:null,innovations:[],children:[]},nodes=[root];let frontier=[root],next=1;for(let y=Number(opts.interval||250);y<=years;y+=Number(opts.interval||250)){const nf=[];for(const p of frontier){const split=r()<clamp(opts.splitChance??.42),count=split?2:1;for(let c=0;c<count;c++){const id=`d${next++}`,n={id,name:`${opts.name||'Dialect'} ${id.toUpperCase()}`,year:Math.min(y,years),parent:p.id,innovations:[],children:[],region:pick(r,opts.regions||['north','south','east','west','central','coastal','highland','river']),register:pick(r,['vernacular','regional standard','urban koine','rural conservative'])};p.children.push(id);nodes.push(n);nf.push(n);}}frontier=nf;}return {rootId:'d0',nodes};}
function diffuseInnovation(tree,innovation={},opts={}){const r=rng(opts.seed||innovation.id||innovation.name||'innovation'),nodes=clone(tree.nodes||[]),origin=opts.origin||pick(r,nodes).id,rate=clamp(opts.rate??.55),blocked=new Set(opts.blockedRegions||[]),adopted=new Set([origin]);let changed=true;while(changed){changed=false;for(const n of nodes){if(adopted.has(n.id)||blocked.has(n.region))continue;const parent=n.parent,related=adopted.has(parent)||nodes.some(x=>adopted.has(x.id)&&x.parent===n.parent);if(related&&r()<rate){adopted.add(n.id);changed=true;}}}for(const n of nodes)if(adopted.has(n.id))n.innovations=[...(n.innovations||[]),clone(innovation)];return {...tree,nodes,innovationSpread:{origin,adopted:[...adopted]}};}
function koineize(varieties=[],opts={}){const r=rng(opts.seed||'koine'),features={};for(const v of varieties)for(const [k,val] of Object.entries(v.features||v.grammar||{})){(features[k]??=[]).push(val);}const selected={};for(const [k,vals] of Object.entries(features)){const freq=new Map();for(const v of vals)freq.set(JSON.stringify(v),(freq.get(JSON.stringify(v))||0)+1);const best=[...freq].sort((a,b)=>b[1]-a[1]);selected[k]=JSON.parse((r()<clamp(opts.leveling??.72)?best[0]:pick(r,best))[0]);}return {type:'koine',features:selected,processes:['mixing','leveling','reallocation','simplification'],sources:varieties.map(v=>v.name||v.id||'variety')};}
function registerSystem(opts={}){const r=rng(opts.seed||'register'),levels=opts.levels||['intimate','casual','neutral','formal','ceremonial'];return levels.map((name,i)=>({name,index:i,pronounStrategy:pick(r,['same pronouns','honorific pronoun','title avoidance','kin term','name/title alternation']),lexicalReplacementRate:Number((i/(levels.length*5)).toFixed(2)),phonologicalReduction:i<2?'high':i>3?'low':'medium',tabooSensitivity:i>2?'higher':'ordinary'}));}
function languageShiftScenario(input={}){const h=history(input.vitality||{},input.events||[],input.years||1500),last=h.at(-1),outcome=last.score>.55?'continued community transmission':last.score>.18?'shift underway / restricted transmission':'dormancy or transmission break';return {history:h,outcome,revivalLevers:['intergenerational use','community-controlled education','new-media domains','literacy/materials','public domains and policy','documentation','community prestige/attitudes'],caveat:'These are scenario levers, not a prescription for real communities.'};}
