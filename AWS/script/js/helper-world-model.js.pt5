const CORE=Object.freeze(['I','you','person','woman','man','child','name','mother','father','friend','water','fire','sun','moon','star','earth','stone','tree','seed','leaf','root','dog','bird','fish','blood','bone','heart','head','eye','ear','mouth','tooth','hand','foot','eat','drink','see','hear','know','think','say','go','come','give','take','sleep','die','live','big','small','good','bad','new','old','one','two','many','all','not','who','what','where','when','day','night','rain','wind','road','house','food','work','trade','law','story','song','love','fear','anger','joy','color','red','black','white','green','blue','metal','cloth','boat','horse','king','spirit','god','market','school','book','machine']);
const SEMANTIC=Object.freeze(['broadening','narrowing','metaphor','metonymy','amelioration','pejoration','taboo replacement','euphemism','hyperbole','understatement','specialization','generalization','grammaticalization']);
const SLANG=Object.freeze(['clipping','initialism','acronym','blend','reduplication','rhyming substitution','semantic inversion','intensifier renewal','respelling','conversion','back-formation','affixation','compound','borrowing','calque','code-switch insertion']);
