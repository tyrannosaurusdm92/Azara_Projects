function slang(lexicon=[],opts={}){if(!lexicon.length)return[];const r=rng(opts.seed||`slang:${opts.year||0}`),n=Math.max(1,Number(opts.count||3)),out=[];for(let i=0;i<n;i++){const a=pick(r,lexicon),b=pick(r,lexicon),process=opts.process||pick(r,SLANG);let f=a.form||'';if(process==='clipping')f=f.slice(0,Math.max(1,Math.ceil(f.length*(.45+r()*.25))));else if(process==='blend')f=f.slice(0,Math.ceil(f.length/2))+(b.form||'').slice(Math.floor((b.form||'').length/2));else if(process==='reduplication')f=f+'-'+f;else if(process==='initialism')f=String(a.meaning||a.form).split(/\s+/).map(x=>x[0]).join('').toLowerCase();else if(process==='acronym')f=String(a.meaning||a.form).split(/\s+/).map(x=>x[0]).join('').toLowerCase();else if(process==='respelling')f=f.replace(/ə/g,'a').replace(/ks/g,'x').replace(/ph/g,'f');else if(process==='compound')f=`${a.form}-${b.form}`;else if(process==='affixation')f=(r()<.5?'na-':'')+f+(r()<.5?'-ik':'');else if(process==='rhyming substitution')f=(b.form||f)+' '+f;else if(process==='semantic inversion')f=f;out.push({id:`slang-${opts.year||0}-${i}`,form:f,meaning:opts.meaning||`slang sense associated with ${a.meaning}`,origin:'slang',formedYear:opts.year||0,process,community:opts.community||pick(r,['youth','urban','occupational','diaspora','online','music scene','regional']),register:'informal'});}return out;}
