(function(global){'use strict';
const clamp=(x,a=0,b=1)=>Math.max(a,Math.min(b,Number(x)||0));
const clone=x=>x==null?x:JSON.parse(JSON.stringify(x));
const COMMONNESS={very_common:0,common:1,less_common:2,uncommon:3,rare:4};
const SOUND_CHANGES=Object.freeze([
 {id:'assimilation',domain:'phonology',description:'A segment becomes more like a neighbor in place, manner, voicing, nasality, rounding or other features.',contexts:['adjacent','across weak boundary'],effects:['feature spreading']},
 {id:'dissimilation',domain:'phonology',description:'Similar nearby sounds become less alike.',contexts:['repeated features','longer words'],effects:['feature replacement','deletion']},
 {id:'lenition',domain:'phonology',description:'Consonants weaken, often in intervocalic or low-prominence positions.',path:['stop','affricate','fricative','approximant','zero']},
 {id:'fortition',domain:'phonology',description:'Segments strengthen, often at prominent boundaries.',path:['approximant','fricative','affricate','stop']},
 {id:'palatalization',domain:'phonology',description:'Consonants shift toward palatal/postalveolar realizations near front vowels or /j/.'},
 {id:'debuccalization',domain:'phonology',description:'Place features weaken toward glottal sounds or zero.'},
 {id:'vowel-reduction',domain:'phonology',description:'Unstressed vowels centralize, shorten or delete.'},
 {id:'syncope',domain:'phonology',description:'A medial segment, commonly an unstressed vowel, deletes.'},
 {id:'apocope',domain:'phonology',description:'Word-final material deletes.'},
 {id:'aphaeresis',domain:'phonology',description:'Word-initial material deletes.'},
 {id:'epenthesis',domain:'phonology',description:'A segment is inserted to repair a cluster or syllable pattern.'},
 {id:'prothesis',domain:'phonology',description:'A segment is added word-initially.'},
 {id:'paragoge',domain:'phonology',description:'A segment is added word-finally.'},
 {id:'metathesis',domain:'phonology',description:'Segments exchange order.'},
 {id:'haplology',domain:'phonology',description:'One of two similar adjacent syllables/morphemes disappears.'},
 {id:'merger',domain:'phonology',description:'Previously contrastive sounds converge.'},
 {id:'split',domain:'phonology',description:'Conditioned variants become independent contrasts after conditioning is obscured.'},
 {id:'chain-shift',domain:'phonology',description:'Several contrasts move through phonetic space while avoiding or resolving collisions.'},
 {id:'tonogenesis',domain:'phonology',description:'Pitch distinctions become lexical/grammatical tone after consonant or phonation cues weaken.'},
 {id:'tone-loss',domain:'phonology',description:'Tone contrasts collapse or are replaced by other cues.'},
