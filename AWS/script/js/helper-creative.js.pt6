let familyNames;if(Array.isArray(opts.familyNames)&&opts.familyNames.length)familyNames=[...opts.familyNames];else if(opts.lastName!==undefined&&opts.lastName!==null)familyNames=[opts.lastName];else{const fc=P.NameStructureEngine.familyCount(r.fork('family-count'),structure,opts);familyNames=structure.icelandicPatronymic?icelandicFamilies(r.fork('iceland-family'),row,fc,explicitPresentation==='neutral'?'neutral':sourceForm):uniquePick(r.fork('family'),familyPool,fc)}
if(!familyNames.length&&uncovered&&!opts.firstName)familyNames=['Person'];
const last=familyNames.join(' ')||null,additional=[],pairAnalyses=[],secondCount=P.NameStructureEngine.secondGivenCount(r.fork('second-count'),structure,opts),role=structure.middleRole;
if(opts.middleName!==undefined&&opts.middleName!==null){additional.push(opts.middleName)}else if(Array.isArray(opts.additionalGivenNames)&&opts.additionalGivenNames.length){additional.push(...opts.additionalGivenNames)}else if(secondCount>0){
