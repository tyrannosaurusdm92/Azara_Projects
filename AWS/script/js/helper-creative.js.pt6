/* ===== People+Places source: 06y-name-flow-engine.js ===== */
(function(g){"use strict";const P=g.PeoplePlaces,D=g.PEOPLE_NAME_PAIRING_DATA||{};
function plain(s){return String(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z'-]/g,'')}
function englishSyllables(name){let s=plain(name).replace(/[^a-z]/g,'');if(!s)return null;if(s.length<=3)return 1;let n=(s.match(/[aeiouy]+/g)||[]).length;if(/e$/.test(s)&&!/[^aeiouy]le$/.test(s)&&n>1)n--;if(/(?:ed|es)$/.test(s)&&!/(ted|ded|ses|zes|ches|shes)$/.test(s)&&n>1)n--;return Math.max(1,n)}
function seam(a,b){a=plain(a);b=plain(b);if(!a||!b)return{score:0,reasons:[]};let score=0,reasons=[];const ae=a.at(-1),bs=b[0],v='aeiouy';if(ae===bs){score-=3;reasons.push('repeated boundary sound')}else if(v.includes(ae)&&v.includes(bs)){score-=1.5;reasons.push('vowel-to-vowel seam')}else{score+=1;reasons.push('clean name boundary')}
const tail2=a.slice(-2),start2=b.slice(0,2);if(tail2===start2){score-=2;reasons.push('repeated two-letter seam')}return{score,reasons}}
function rhymePenalty(a,b){a=plain(a);b=plain(b);if(!a||!b||a===b)return a===b?-20:0;let p=0;if(a.length>=3&&b.length>=3&&a.slice(-3)===b.slice(-3))p-=4;else if(a.length>=2&&b.length>=2&&a.slice(-2)===b.slice(-2))p-=2;return p}
function rhythm(first,middle){const a=englishSyllables(first),b=englishSyllables(middle);if(!a||!b)return{score:0,reasons:[]};let score=0,reasons=[];if(a===1){if(b>=2&&b<=4){score+=5;reasons.push('short-first/longer-middle rhythm')}else if(b===1){score-=2;reasons.push('two clipped one-syllable beats')}}else if(a===2){if(b===1||b===3){score+=4;reasons.push('contrasting syllable rhythm')}else if(b===2){score+=1;reasons.push('even two-two rhythm')}}else if(a>=3){if(b===1){score+=5;reasons.push('long-first/short-middle reset')}else if(b===2){score+=3;reasons.push('long-first/two-syllable balance')}else if(b>=3){score-=0.5;reasons.push('longer paired cadence')}}return{score,reasons,firstSyllables:a,middleSyllables:b}}
function publicEvidence(first,middle){const rec=D.publicPairEvidence?.[first]?.[middle];return rec?{score:Number(rec.weight)||0,sources:rec.sources||[]}:{score:0,sources:[]}}
function commonMiddleScore(name){const count=Number(D.commonMiddleUsage?.[name])||0;return count?Math.min(6,Math.log2(count+1)*.7):0}
function eraScore(a,b){const A=D.englishEraIndex?.[a],B=D.englishEraIndex?.[b];if(!A||!B)return{score:0,reasons:[]};const spanA=(A.yearMax||0)-(A.yearMin||0),spanB=(B.yearMax||0)-(B.yearMin||0),diff=Math.abs((A.yearPeak||0)-(B.yearPeak||0));let score=0,reasons=[];if(spanA>=100||spanB>=100){score+=1;reasons.push('at least one long-running name')}if(diff<=12){score+=3;reasons.push('similar historical popularity era')}else if(diff<=28){score+=1.5;reasons.push('compatible historical popularity era')}else if(diff>=65&&spanA<80&&spanB<80){score-=1;reasons.push('strongly separated popularity eras')}return{score,reasons,peakDifference:diff}}
function score(first,middle,last,opts={}){if(!middle||plain(first)===plain(middle))return{score:-99,reasons:['duplicate name'],publicSources:[]};let total=0,reasons=[];const profile=opts.phoneticProfile||'light',language=String(opts.language||'').split(/[-_]/)[0];if(profile==='english'||language==='en'){const r=rhythm(first,middle);total+=r.score;reasons.push(...r.reasons);const e=eraScore(first,middle);total+=e.score;reasons.push(...e.reasons);const c=commonMiddleScore(middle);if(c){total+=c;reasons.push('documented as a commonly used middle name in a public survey')}const pe=publicEvidence(first,middle);if(pe.score){total+=pe.score;reasons.push('directional public pairing evidence')}const sm=seam(first,middle);total+=sm.score;reasons.push(...sm.reasons);total+=rhymePenalty(first,middle);if(last){const ml=seam(middle,last);total+=ml.score*.65;if(ml.score<0)reasons.push('middle-to-family-name seam needs care')}}else if(profile==='romance-light'||profile==='light'){const sm=seam(first,middle);total+=sm.score*.5;total+=rhymePenalty(first,middle)*.5;reasons.push(...sm.reasons)}
if(plain(first)[0]===plain(middle)[0]){total-=.5;reasons.push('alliterative initials')}return{score:Math.round(total*100)/100,reasons:[...new Set(reasons)],publicSources:publicEvidence(first,middle).sources,firstSyllables:englishSyllables(first),middleSyllables:englishSyllables(middle)}}
function rank(first,candidates,last,opts={}){const seen=new Set(),rows=[];for(const c of candidates||[]){if(!c||seen.has(c)||plain(c)===plain(first))continue;seen.add(c);rows.push({name:c,...score(first,c,last,opts)})}rows.sort((a,b)=>b.score-a.score||a.name.localeCompare(b.name));return rows}
function choose(random,first,candidates,last,opts={}){const rows=rank(first,candidates,last,opts);if(!rows.length)return{value:null,analysis:null};const top=rows.slice(0,Math.min(60,rows.length)),floor=Math.min(...top.map(x=>x.score));const weighted=top.map(x=>({...x,weight:Math.pow(Math.max(.5,x.score-floor+1),1.35)})),pick=random.weighted(weighted)||weighted[0];return{value:pick.name,analysis:{score:pick.score,reasons:pick.reasons,publicSources:pick.publicSources,rank:rows.findIndex(x=>x.name===pick.name)+1,candidateCount:rows.length}}}
P.register('NameFlowEngine',{plain,englishSyllables,seam,rhythm,score,rank,choose});})(window);



