/* ===== People+Places source: 28-event-engine.js ===== */
(function(g){"use strict";const P=g.PeoplePlaces,U=P.Utils;
const events=[
 {id:'good-conversation',valence:.55,arousal:.35,summary:'had a satisfying conversation',tags:['social']},
 {id:'deadline',valence:-.45,arousal:.78,summary:'felt pressure from a deadline',tags:['work']},
 {id:'quiet-evening',valence:.45,arousal:.15,summary:'had a quiet evening to decompress',tags:['home']},
 {id:'unexpected-expense',valence:-.5,arousal:.6,summary:'dealt with an unexpected expense',tags:['money']},
 {id:'creative-breakthrough',valence:.82,arousal:.7,summary:'made a breakthrough on a creative project',tags:['hobby','achievement']},
 {id:'missed-connection',valence:-.3,arousal:.4,summary:'missed a chance to connect with someone',tags:['social']},
 {id:'good-news',valence:.85,arousal:.72,summary:'received good news',tags:['life']},
 {id:'small-kindness',valence:.62,arousal:.3,summary:'experienced a small act of kindness',tags:['social']},
 {id:'household-annoyance',valence:-.22,arousal:.45,summary:'dealt with an annoying household problem',tags:['home']},
 {id:'learned-something',valence:.5,arousal:.45,summary:'learned something genuinely useful',tags:['learning']}
];
function generate(world,person,random){const e={...random.pick(events),at:new Date(world.clock).toISOString(),personId:person.id,id:U.uid('evt')};return e}
function apply(world,event){const p=world.people.find(x=>x.id===event.personId);if(!p)return;p.mood=P.MoodEngine.apply(p,{valence:event.valence,arousal:event.arousal,weight:.22,summary:event.summary});P.MemoryStore.add(p,{kind:event.tags.includes('achievement')?'achievement':'episodic',summary:event.summary,tags:event.tags,emotionalWeight:Math.min(1,Math.abs(event.valence)+.15),salience:.45,createdAt:event.at});world.events.push(event);world.events=world.events.slice(-2000)}
P.register('EventEngine',{events,generate,apply});})(window);


/* ===== People+Places source: 29-world-model.js ===== */
(function(g){"use strict";const P=g.PeoplePlaces,U=P.Utils;
function create(seed='people-places-world'){return{schema:'people-places-world-v2',id:U.uid('world'),seed:String(seed),createdAt:U.nowISO(),updatedAt:U.nowISO(),clock:new Date().toISOString(),people:[],places:[],relationships:[],events:[],notes:[],settings:{simulationSpeed:1,socialDensity:.16,romanceEnabled:true,modes:P.WorldModeEngine.profile({realistic:true})}}}
function person(world,id){return world.people.find(x=>x.id===id)}function place(world,id){return world.places.find(x=>x.id===id)}
function validate(world){const issues=[],pids=new Set(world.people.map(x=>x.id)),lids=new Set(world.places.map(x=>x.id));for(const e of world.relationships)if(!pids.has(e.aId)||!pids.has(e.bId))issues.push(`Broken relationship ${e.id}`);for(const p of world.people){if(p.life.homePlaceId&&!lids.has(p.life.homePlaceId))issues.push(`${p.id} has missing home`);if(p.life.age<18&&P.RelationshipEngine.romanticLinks(world,p.id).length)issues.push(`${p.id} is a minor with an adult-romance edge`);if(!['realistic','fantasy','scifi'].includes(p.settingProfile?.mode))issues.push(`${p.id} has invalid setting mode`)}for(const x of world.places)if(!['realistic','fantasy','scifi'].includes(x.mode||'realistic'))issues.push(`${x.id} has invalid place mode`);return{ok:issues.length===0,issues}}
P.register('WorldModel',{create,person,place,validate});})(window);


/* ===== People+Places source: 30-person-generator.js ===== */
(function(g){"use strict";const P=g.PeoplePlaces,U=P.Utils;
function generate(seed,opts={}){const random=new P.Random(seed),mode=opts.mode||'realistic',life=P.LifeEngine.generate(random,opts.age),sentient=P.SpeculativePersonEngine.chooseSentient(random.fork('sentient'),mode,opts),name=mode==='realistic'?P.NameEngine.generate(random,opts):P.SpeculativeNameEngine.generate(random,sentient,opts),identity=P.IdentityEngine.generate(random,life.age,opts),personality=P.PersonalityEngine.generate(random,opts),interests=P.InterestSkillEngine.generate(random,personality,life.age),baseDescription=P.PhysicalDescriptionEngine.generate(random,life.age,opts),physicalDescription=P.SpeculativePersonEngine.adaptPhysicalDescription(baseDescription,sentient,random),mood=P.MoodEngine.generate(random),workEducation=P.SpeculativePersonEngine.adaptWorkEducation(P.WorkEducationEngine.generate(random,life,interests),mode,random),id=opts.id||`person-${U.slug(name.full)}-${random.int(1000,9999)}`;const person={schema:'people-places-person-v2',id,seed:String(seed),name,settingProfile:P.SpeculativePersonEngine.settingProfile(sentient,mode),life:{...life,workEducation,homePlaceId:null,homeAssignment:'',workPlaceId:null,workAssignment:'',schoolPlaceId:null,schoolAssignment:''},identity,physicalDescription,personality,interests,mood,memory:{profile:personality.traits.includes('forgetful')?'forgetful':personality.traits.includes('observant')?'observant':'average',records:[],working:[]},knowledge:{facts:{},people:{},places:{},topics:{}},routine:null,currentPlaceId:null,conversation:{turn:0,transcript:[]},createdAt:U.nowISO()};P.MemoryStore.add(person,{kind:'semantic',summary:`My name is ${name.full}.`,tags:['identity','name'],salience:1,confidence:1,emotionalWeight:.2});P.MemoryStore.add(person,{kind:'semantic',summary:`I am a ${sentient.name}.`,tags:['setting','sentient-type'],salience:.8,confidence:1,emotionalWeight:.05});P.MemoryStore.add(person,{kind:'preference',summary:`I enjoy ${U.joinNatural(interests.hobbies.slice(0,3))}.`,tags:['hobbies','preference'],salience:.65,confidence:.98,emotionalWeight:.3});return person}
P.register('PersonGenerator',{generate});})(window);


/* ===== People+Places source: 31-world-generator.js ===== */
(function(g){"use strict";const P=g.PeoplePlaces;
const realPools={home:['apartment','house','townhouse','condominium','shared house','dormitory','assisted living residence'],school:['school','university'],work:['office','shop','restaurant','cafe','clinic','workshop','warehouse','factory','community center','library','studio']};
function ensurePlace(world,random,mode,role,context,extra={}){let kind=extra.kind||null;if(mode==='realistic'&&!kind)kind=random.pick(realPools[role]||P.Catalogs.placeKinds);const p=P.LocationEngine.generate(random,{mode,role,kind,typeId:extra.typeId,settingContext:context,city:context?.cityName,notes:extra.notes||''});world.places.push(p);return p}
function eligible(place,mode,role){return (place.mode||'realistic')===mode&&(place.useRoles||[]).includes(role)}
function assign(world,person,random,context){const mode=person.settingProfile.mode,r=random.fork(`assign-${person.id}`);let home=world.places.find(x=>eligible(x,mode,'home')&&x.residents.length<Math.min(12,Math.max(2,x.capacity||6)));if(!home||r.chance(.34))home=ensurePlace(world,r,mode,'home',context);home.residents.push(person.id);person.life.homePlaceId=home.id;person.life.homeAssignment=P.LocationEngine.assignmentFor(home,r.fork('home-assignment'));person.currentPlaceId=home.id;const we=person.life.workEducation;if(we.education.status==='enrolled'){let s=world.places.find(x=>eligible(x,mode,'school')&&x.students.length<120);if(!s||r.chance(.3))s=ensurePlace(world,r,mode,'school',context);s.students.push(person.id);person.life.schoolPlaceId=s.id;person.life.schoolAssignment=P.LocationEngine.assignmentFor(s,r.fork('school-assignment'))}if(we.work.status==='employed'){let w=world.places.find(x=>eligible(x,mode,'work')&&x.workers.length<Math.min(80,Math.max(10,x.capacity||35)));if(!w||r.chance(.3))w=ensurePlace(world,r,mode,'work',context);w.workers.push(person.id);person.life.workPlaceId=w.id;person.life.workAssignment=P.LocationEngine.assignmentFor(w,r.fork('work-assignment'))}person.routine=P.RoutineEngine.generate(r,person)}
function fantasyRoot(r){return `${r.pick(['Alder','Ember','Silver','Thorn','Moon','River','Star','Willow'])}${r.pick(['reach','vale','march','mere','hollow','crown'])}`}
function realRoot(r){return `${r.pick(['Alder','Briar','Crescent','Fair','Glen','Harbor','Lake','Maple','North','Pine','River','Stone','West'])}${r.pick(['bridge','haven','field','view','port','wood','ridge','ford','dale','mont','bury'])}`}
function makeContext(r,profile){const x=profile.modes;if(profile.primary==='realistic')return{primaryMode:'realistic',regionName:'Unspecified region',cityName:null,layers:profile.layers};if(profile.primary==='fantasy'){const realm=fantasyRoot(r);return{primaryMode:'fantasy',realmName:`${realm} Realm`,settlementName:null,regionName:`${realm} Realm`,cityName:x.realistic?realRoot(r):null,layers:profile.layers}}const system=`${r.pick(['Aster','Kepler','Orion','Vesper','Helios','Nadir','Cygnus','Pioneer'])}-${r.int(2,999)} System`;return{primaryMode:'scifi',systemName:system,anchorName:null,realmName:x.fantasy?`${fantasyRoot(r)} Enclave`:null,settlementName:x.fantasy?`${fantasyRoot(r.fork('settlement'))} Ward`:null,regionName:system,cityName:x.realistic?realRoot(r):null,layers:profile.layers}}
function hasType(world,id){return world.places.some(x=>x.locationTypeId===id)}
function addSignature(world,r,profile,context,mode,typeId,kind){if(mode!=='realistic'&&hasType(world,typeId))return;ensurePlace(world,r.fork(`signature-${mode}-${typeId||kind}`),mode,'general',context,{typeId,kind,notes:'Mode-signature place ensuring the selected world layer is materially represented.'})}
function ensureModeSignatures(world,r,profile,context){const x=profile.modes;if(x.scifi){for(const id of ['orbital-station','exploration-starship','planetary-colony','asteroid-belt'])addSignature(world,r,profile,context,'scifi',id)}if(x.fantasy){for(const id of ['enchanted-village','tavern','guild-hall'])addSignature(world,r,profile,context,'fantasy',id)}if(x.realistic&&profile.selected.length>1){addSignature(world,r,profile,context,'realistic',null,'community center');addSignature(world,r,profile,context,'realistic',null,'cafe')}}
function generate(seed='people-places',opts={}){const world=P.WorldModel.create(seed),r=new P.Random(seed),count=Math.max(1,Math.min(500,Number(opts.peopleCount||24))),profile=P.WorldModeEngine.profile(opts.modes||{realistic:true});world.settings.modes=profile;const context=makeContext(r.fork('setting-context'),profile);world.settings.setting=context;const hub=P.LocationEngine.generate(r.fork('primary-hub'),{mode:profile.primary,role:'hub',settingContext:context,kind:profile.primary==='realistic'?'community center':null});world.places.push(hub);if(profile.primary==='realistic')context.cityName=hub.geography.city;else if(profile.primary==='fantasy'){context.settlementName=hub.name;hub.geography.city=hub.name}else{context.anchorName=hub.name;hub.geography.city=hub.name}world.settings.setting={...context,anchorPlaceId:hub.id,anchorName:hub.name};ensureModeSignatures(world,r.fork('mode-signatures'),profile,context);
const personModes=P.WorldModeEngine.allocateModes(r.fork('person-mode-plan'),profile,count);for(let i=0;i<count;i++){const mode=personModes[i]||profile.primary,person=P.PersonGenerator.generate(`${seed}|person|${i}`,{...(opts.personDefaults||{}),mode,worldModes:profile.selected});world.people.push(person);assign(world,person,r,context)}
const extra=Math.max(4,Math.round(count/3)),placeModes=P.WorldModeEngine.allocateModes(r.fork('place-mode-plan'),profile,extra);for(let i=0;i<extra;i++){const mode=placeModes[i]||profile.primary;world.places.push(P.LocationEngine.generate(r.fork(`extra-${i}`),{mode,role:'general',settingContext:context,city:context.cityName}))}P.SocialGraphEngine.build(world,r,{socialDensity:opts.socialDensity});for(const p of world.people){const links=P.RelationshipEngine.linksFor(world,p.id);for(const e of links.slice(0,4)){const other=world.people.find(x=>x.id===P.RelationshipEngine.other(e,p.id));if(other)P.MemoryStore.add(p,{kind:'social',summary:`${other.name.first} is my ${e.kind}.`,entities:[other.id],tags:['relationship',e.kind],salience:.65,confidence:.95,emotionalWeight:e.closeness/100})}}world.updatedAt=new Date().toISOString();return world}
P.register('WorldGenerator',{generate,assign,ensureModeSignatures});})(window);



/* ===== People+Places source: 32-world-simulator.js ===== */
(function(g){"use strict";const P=g.PeoplePlaces;
function moveByRoutine(world,person,date){const act=P.RoutineEngine.activityAt(person.routine,date);if(act?.placeId)person.currentPlaceId=act.placeId;return act}
function advance(world,minutes=60){const start=new Date(world.clock),end=new Date(start.getTime()+Math.max(1,minutes)*60000),r=new P.Random(`${world.seed}|sim|${end.toISOString()}`);world.clock=end.toISOString();for(const p of world.people){moveByRoutine(world,p,end);if(r.chance(Math.min(.35,minutes/1440*.9))){const e=P.EventEngine.generate(world,p,r.fork(p.id));P.EventEngine.apply(world,e)}P.MemoryStore.decay(p,end)}world.updatedAt=new Date().toISOString();return world}
function runDays(world,days=1){for(let i=0;i<days;i++)advance(world,1440);return world}
P.register('WorldSimulator',{advance,runDays,moveByRoutine});})(window);


/* ===== People+Places source: 33-command-parser.js ===== */
(function(g){"use strict";const P=g.PeoplePlaces,U=P.Utils;
function parse(input){const t=U.normalizeText(input);if(!t.startsWith('/'))return{command:'talk',arg:t,text:t,slash:false};const body=t.slice(1),sp=body.search(/\s/),raw=sp<0?body:body.slice(0,sp),arg=sp<0?'':body.slice(sp+1).trim();return{command:raw.toLowerCase(),arg,args:arg?arg.split(/\s+/):[],text:t,slash:true}}
function findPerson(world,q){q=String(q||'').toLowerCase();return world.people.find(p=>p.name.full.toLowerCase()===q)||world.people.find(p=>p.name.first.toLowerCase()===q)||world.people.find(p=>p.name.full.toLowerCase().includes(q))}
function findPlace(world,q){q=String(q||'').toLowerCase();return world.places.find(p=>p.name.toLowerCase()===q)||world.places.find(p=>p.name.toLowerCase().includes(q))}
function execute(world,input,selection){const x=parse(input),current=world.people.find(p=>p.id===selection.personId)||world.people[0];if(!current)return{type:'system',output:'No person is selected.'};switch(x.command){
case'talk':{if(!x.slash)return{type:'dialogue',...P.DialogueRenderer.respond(world,current,x.arg)};const m=x.arg.match(/^([^:]+):\s*(.+)$/);if(m){const target=findPerson(world,m[1]);if(target){selection.personId=target.id;return{type:'dialogue',...P.DialogueRenderer.respond(world,target,m[2])}}}return{type:'dialogue',...P.DialogueRenderer.respond(world,current,x.arg||'Hello.')};}
case'look':{const place=world.places.find(p=>p.id===current.currentPlaceId);return{type:'system',output:place?P.LocationEngine.describe(place):'No current place.'}}
case'who':return{type:'system',output:`${current.name.full}, ${current.life.age}, ${current.identity.genderIdentity}, ${current.identity.pronouns.display}.`};
case'where':{const place=world.places.find(p=>p.id===current.currentPlaceId);return{type:'system',output:place?`${place.name} — ${place.kind}, ${place.geography.neighborhood}.`:'No current place.'}}
case'people':{const place=world.places.find(p=>p.id===current.currentPlaceId),rows=world.people.filter(p=>p.currentPlaceId===current.currentPlaceId);return{type:'system',output:`At ${place?.name||'this place'}: ${rows.length?U.joinNatural(rows.map(p=>p.name.full)):'nobody is listed here'}.`}}
case'places':return{type:'system',output:world.places.slice(0,40).map(p=>`• ${p.name} — ${p.kind}`).join('\n')};
case'go':{const dest=findPlace(world,x.arg);if(!dest)return{type:'system',output:`I couldn't match a place named “${x.arg}”.`};current.currentPlaceId=dest.id;P.MemoryStore.add(current,{kind:'place',summary:`Went to ${dest.name}.`,entities:[dest.id],tags:['travel',dest.kind],salience:.25});return{type:'system',output:`${current.name.first} goes to ${dest.name}. ${P.LocationEngine.describe(dest)}`}}
case'inspect':{const p=findPerson(world,x.arg);if(p)return{type:'system',output:`${p.name.full}: ${p.life.age}, ${p.identity.genderIdentity}, ${p.identity.pronouns.display}. ${P.PhysicalDescriptionEngine.describe(p.physicalDescription)} Hobbies: ${U.joinNatural(p.interests.hobbies.slice(0,5))}.`};const place=findPlace(world,x.arg);return{type:'system',output:place?P.LocationEngine.describe(place):`No matching person or place for “${x.arg}”.`}}
case'do':{const activity=x.arg||current.interests.hobbies[0]||'resting';P.MemoryStore.add(current,{kind:'routine',summary:`Spent time ${activity}.`,tags:['activity',activity],salience:.3,emotionalWeight:.25});current.mood=P.MoodEngine.apply(current.mood,{valence:.4,arousal:.4,weight:.14,summary:`spent time ${activity}`});return{type:'system',output:`${current.name.first} spends some time ${activity}.`}}
case'remember':{const rows=P.MemoryRetrieval.retrieve(current,x.arg||'',{limit:8});return{type:'system',output:rows.length?rows.map(y=>`• ${y.record.summary} [${Math.round(y.score*100)}% relevance]`).join('\n'):'Nothing matched.'}}
case'advance':{const n=parseFloat(x.arg)||1;P.WorldSimulator.advance(world,Math.max(.05,n)*60);return{type:'system',output:`Advanced ${n} hour(s). World time: ${new Date(world.clock).toLocaleString()}.`}}
case'time':return{type:'system',output:`World time: ${new Date(world.clock).toLocaleString()}.`};
case'help':return{type:'system',output:'/look /who /where /people /places /go PLACE /inspect NAME /talk NAME: MESSAGE /do ACTIVITY /remember TOPIC /advance HOURS /time — or type normally to talk.'};
default:return{type:'system',output:`Unknown command /${x.command}. Try /help.`}}}
P.register('CommandParser',{parse,execute,findPerson,findPlace});})(window);


/* ===== People+Places source: 34-search-index.js ===== */
(function(g){"use strict";const P=g.PeoplePlaces,U=P.Utils;
function build(world){const docs=[];for(const p of world.people)docs.push({type:'person',id:p.id,title:p.name.full,text:[p.name.full,p.identity.genderIdentity,p.identity.pronouns.display,P.PhysicalDescriptionEngine.describe(p.physicalDescription),p.personality.traits.join(' '),p.personality.values.join(' '),p.interests.hobbies.join(' '),p.life.workEducation.work.occupation].join(' ')});for(const x of world.places)docs.push({type:'place',id:x.id,title:x.name,text:[x.name,x.kind,x.geography.city,x.geography.neighborhood,x.descriptors.join(' ')].join(' ')});return docs.map(d=>({...d,tokens:U.tokens(d.text)}))}
function query(index,q,limit=20){const t=U.tokens(q);return index.map(d=>({d,score:U.overlap(t,d.tokens)})).filter(x=>x.score>0).sort((a,b)=>b.score-a.score).slice(0,limit).map(x=>({...x.d,score:x.score}))}
P.register('SearchIndex',{build,query});})(window);


/* ===== People+Places source: 35-statistics.js ===== */
(function(g){"use strict";const P=g.PeoplePlaces;function world(world){const ages=world.people.map(p=>p.life.age),frameworks={},genders={},moods={},kinds={},peopleModes={},placeModes={},sentients={};for(const p of world.people){frameworks[p.identity.relationshipFramework]=(frameworks[p.identity.relationshipFramework]||0)+1;genders[p.identity.genderIdentity]=(genders[p.identity.genderIdentity]||0)+1;moods[p.mood.label]=(moods[p.mood.label]||0)+1;peopleModes[p.settingProfile?.mode||'realistic']=(peopleModes[p.settingProfile?.mode||'realistic']||0)+1;sentients[p.settingProfile?.sentientType||'Human']=(sentients[p.settingProfile?.sentientType||'Human']||0)+1}for(const x of world.places){kinds[x.kind]=(kinds[x.kind]||0)+1;placeModes[x.mode||'realistic']=(placeModes[x.mode||'realistic']||0)+1}return{people:world.people.length,places:world.places.length,relationships:world.relationships.length,events:world.events.length,averageAge:ages.length?(ages.reduce((a,b)=>a+b,0)/ages.length).toFixed(1):0,worldModes:world.settings?.modes,peopleModes,placeModes,sentientTypes:sentients,frameworks,genders,moods,placeKinds:kinds,validation:P.WorldModel.validate(world)}}P.register('Statistics',{world});})(window);


/* ===== People+Places source: 36-persistence.js ===== */
(function(g){"use strict";const P=g.PeoplePlaces;
const DB='people-places-generator',STORE='worlds';function open(){return new Promise((resolve,reject)=>{const req=indexedDB.open(DB,1);req.onupgradeneeded=()=>{const db=req.result;if(!db.objectStoreNames.contains(STORE))db.createObjectStore(STORE,{keyPath:'id'})};req.onsuccess=()=>resolve(req.result);req.onerror=()=>reject(req.error)})}
async function save(world){const db=await open();world.updatedAt=new Date().toISOString();await new Promise((resolve,reject)=>{const tx=db.transaction(STORE,'readwrite');tx.objectStore(STORE).put(world);tx.oncomplete=resolve;tx.onerror=()=>reject(tx.error)});return world.id}
async function load(id){const db=await open();return new Promise((resolve,reject)=>{const q=db.transaction(STORE).objectStore(STORE).get(id);q.onsuccess=()=>resolve(q.result||null);q.onerror=()=>reject(q.error)})}
async function list(){const db=await open();return new Promise((resolve,reject)=>{const q=db.transaction(STORE).objectStore(STORE).getAll();q.onsuccess=()=>resolve(q.result||[]);q.onerror=()=>reject(q.error)})}
async function remove(id){const db=await open();return new Promise((resolve,reject)=>{const tx=db.transaction(STORE,'readwrite');tx.objectStore(STORE).delete(id);tx.oncomplete=resolve;tx.onerror=()=>reject(tx.error)})}
P.register('Persistence',{save,load,list,remove});})(window);


/* ===== People+Places source: 37-export-import.js ===== */
(function(g){"use strict";const P=g.PeoplePlaces;
function exportWorld(world){const blob=new Blob([JSON.stringify(world,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`people-places-${world.id}.json`;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),2000)}
async function importWorld(file){const text=await file.text(),world=JSON.parse(text),v=P.WorldModel.validate(world);if(!v.ok)console.warn('Imported world validation warnings',v.issues);return world}
P.register('ExportImport',{exportWorld,importWorld});})(window);


/* ===== William voice descriptive bridge (simulation data remains voice-neutral) ===== */
(function(global){'use strict';const P=global.PeoplePlaces;if(!P)return;
function describeEntity(entity={},context={}){
  const kind=context.kind||'story',name=entity.name||entity.displayName||entity.id||'the place',traits=[entity.description,entity.summary,entity.personality?.summary,entity.location?.description,entity.neighborhood,entity.life?.occupation].filter(Boolean).join(' ');
  const packet=global.WriterWilliamVoice?.buildPacket?.({kind,prompt:`Describe ${name}. ${traits}`,form:'people-place-description'})||null;
  const concrete=[entity.weather,entity.architecture,entity.materials,entity.features,entity.appearance?.details,entity.style].flat().filter(Boolean).slice(0,5);
  return {name,kind,facts:traits,concreteAnchors:concrete,william_voice:packet,prompt:[packet?.promptBlock||'',`Describe ${name} through concrete sensory or behavioral evidence. Use only facts supported by the entity data. Let one or two details carry emotional meaning; do not inventory every field or explain the symbolism twice.`].filter(Boolean).join('\n')};
}
P.DescriptiveBridge=Object.freeze({describeEntity});
})(typeof globalThis!=='undefined'?globalThis:window);

