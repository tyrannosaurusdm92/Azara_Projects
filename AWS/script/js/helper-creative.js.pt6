function hash(s){let h=2166136261>>>0;for(const ch of String(s||'')){h^=ch.codePointAt(0);h=Math.imul(h,16777619)>>>0;}return h>>>0;}
function rng(seed){let x=hash(seed)||1;return()=>{x^=x<<13;x^=x>>>17;x^=x<<5;return(x>>>0)/4294967296;};}
function stroke(x1,y1,x2,y2,w=70){const dx=x2-x1,dy=y2-y1,len=Math.hypot(dx,dy)||1,nx=-dy/len*w/2,ny=dx/len*w/2;return [{x:Math.round(x1+nx),y:Math.round(y1+ny),on:true},{x:Math.round(x2+nx),y:Math.round(y2+ny),on:true},{x:Math.round(x2-nx),y:Math.round(y2-ny),on:true},{x:Math.round(x1-nx),y:Math.round(y1-ny),on:true}];}
