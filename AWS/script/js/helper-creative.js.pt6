return{first,middle,last,full,givenNames:[first,...((role==='second-given'||role==='additional-forename')?additional:[])],middleNames:(role==='middle'||role==='cultural-middle'||role==='additional-name')?[...additional]:[],patronymic:role==='patronymic'?(additional[0]||null):null,lineageNames:lineage,familyNames,components,locale:context.locale,language:context.language,region:context.region,script:context.script,order:(structure.order||[]).join('-'),structure:{id:structure.id,middleRole:role||null,order:structure.order||[],phoneticProfile:structure.phoneticProfile||'none'},pairing:{method:'cultural-structure + directional-public-evidence + phonetic/rhythm + era context',analyses:pairAnalyses},context:{...context,namePresentation:explicitPresentation||'unspecified',sourceGrammaticalForm:sourceForm||'not-required',romanized,stereotypeGuardrails:['No identity-to-name inference','No appearance-to-name inference','No occupation/class-to-name inference','No personality-to-name inference','No religion-to-name inference','Cultural structure controls component roles; English flow scoring is not imposed on unrelated naming systems']}}}
