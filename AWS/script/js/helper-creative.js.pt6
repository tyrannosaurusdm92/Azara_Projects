    const storyFolder = dashedFolder(series.series_folder || series.story_folder || pathParts[1] || title || key, sentenceCase(key));
    const storyType = String(series.story_type || series.format_type || 'cyoa_writing').toLowerCase() === 'short_story' ? 'short_story' : 'cyoa_writing';
    const normalized = {
