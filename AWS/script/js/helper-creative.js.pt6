/* ===== BEGIN SOURCE: writer-glyph-synthesis.js | sha256:836bd192c3f6580ab90c657444911652bdf523c5c5dfd2518f989831fc7762c4 ===== */
/* Writer Tools — fully digital procedural glyph synthesis. No drawing/scanning required.
 * Builds stroke skeletons from concept/sound identities, turns them into closed outlines,
 * applies medium/style/evolution effects, derives metrics/variants and feeds the existing TTF writer.
 */
(function(global){'use strict';const clone=v=>v==null?v:JSON.parse(JSON.stringify(v)),clamp=(n,a=0,b=1)=>Math.max(a,Math.min(b,Number(n)||0));
const hash=s=>{let h=2166136261>>>0;for(const c of String(s)){h^=c.codePointAt(0);h=Math.imul(h,16777619)}return h>>>0};const rng=seed=>{let a=hash(seed)||1;return()=>((a=Math.imul(a^a>>>15,1|a),a^=a+Math.imul(a^a>>>7,61|a),((a^a>>>14)>>>0)/4294967296))};const pick=(r,a)=>a[Math.floor(r()*a.length)%a.length];
const MEDIA=Object.freeze({stone:{angular:.92,round:.08,contrast:.05,join:'miter',stroke:72,noise:.015},clay:{angular:.72,round:.16,contrast:.04,join:'wedge',stroke:80,noise:.025},reed:{angular:.42,round:.35,contrast:.55,join:'square',stroke:68,noise:.02},brush:{angular:.2,round:.72,contrast:.7,join:'round',stroke:74,noise:.035},quill:{angular:.35,round:.42,contrast:.8,join:'sharp',stroke:62,noise:.018},cursive:{angular:.1,round:.9,contrast:.34,join:'round',stroke:58,noise:.03},print:{angular:.55,round:.45,contrast:.18,join:'clean',stroke:64,noise:0},screen:{angular:.5,round:.5,contrast:.05,join:'clean',stroke:70,noise:0}});
const MOTIFS=Object.freeze({water:'waves',river:'waves',sea:'waves',sun:'sun',moon:'crescent',star:'star',house:'house',home:'house',eye:'eye',head:'head',person:'person',man:'person',woman:'person',hand:'hand',foot:'foot',tree:'tree',plant:'tree',snake:'snake',serpent:'snake',fish:'fish',bird:'bird',mountain:'mountain',hill:'mountain',fire:'fire',flame:'fire',door:'door',road:'road',path:'road',ox:'horns',bull:'horns',cow:'horns',mouth:'mouth',tooth:'teeth',weapon:'spear',spear:'spear',king:'crown',god:'star',spirit:'spiral',wind:'spiral',heart:'heart',love:'heart',book:'tablet',writing:'tablet'});
function motifFor(meaning='',sound='',seed=''){const s=String(meaning).toLowerCase();for(const [k,v] of Object.entries(MOTIFS))if(s.includes(k))return v;const opts=['cross','fork','ladder','zigzag','loop','arch','chevron','hook','diamond','spiral','trident','gate'];return opts[hash(`${seed}:${meaning}:${sound}`)%opts.length];}
function P(x,y){return {x,y}};
function motif(name,r){const cx=500,cy=500;switch(name){case'waves':return [[P(130,430),P(260,360),P(390,430),P(520,360),P(650,430),P(790,360)],[P(160,610),P(290,540),P(420,610),P(550,540),P(680,610),P(810,540)]];case'sun':return [[P(500,230),P(660,300),P(735,465),P(690,640),P(530,740),P(355,690),P(260,530),P(300,355),P(500,230)],[P(500,120),P(500,210)],[P(500,760),P(500,850)],[P(180,500),P(270,500)],[P(730,500),P(820,500)]];case'crescent':return [[P(650,220),P(470,260),P(360,410),P(350,590),P(450,730),P(640,770)],[P(640,770),P(520,660),P(490,510),P(520,360),P(650,220)]];case'star':return [[P(500,140),P(570,400),P(835,400),P(620,555),P(700,820),P(500,655),P(300,820),P(380,555),P(165,400),P(430,400),P(500,140)]];case'house':return [[P(210,470),P(500,190),P(790,470)],[P(290,430),P(290,790),P(710,790),P(710,430)],[P(470,790),P(470,590),P(585,590),P(585,790)]];case'eye':return [[P(170,500),P(330,360),P(500,325),P(670,360),P(830,500),P(670,640),P(500,675),P(330,640),P(170,500)],[P(500,390),P(500,610)]];case'head':return [[P(360,180),P(650,240),P(720,470),P(650,700),P(430,800),P(300,620),P(300,360),P(360,180)],[P(410,430),P(470,430)],[P(540,430),P(600,430)]];case'person':return [[P(500,170),P(500,410),P(500,780)],[P(500,400),P(260,570)],[P(500,400),P(740,570)],[P(500,780),P(330,880)],[P(500,780),P(670,880)]];case'hand':return [[P(260,770),P(360,520),P(390,250)],[P(360,520),P(470,220)],[P(390,540),P(575,260)],[P(420,590),P(680,370)],[P(260,770),P(590,800)]];case'tree':return [[P(500,820),P(500,270)],[P(500,390),P(310,240)],[P(500,390),P(690,240)],[P(500,530),P(280,470)],[P(500,530),P(720,470)],[P(350,820),P(650,820)]];case'snake':return [[P(260,210),P(680,260),P(720,430),P(300,470),P(260,650),P(700,730),P(760,840)]];case'fish':return [[P(190,500),P(360,340),P(610,360),P(800,500),P(610,640),P(360,660),P(190,500)],[P(190,500),P(80,360),P(80,640),P(190,500)]];case'bird':return [[P(160,560),P(390,350),P(500,520),P(610,350),P(840,560)],[P(500,520),P(500,760)]];case'mountain':return [[P(130,760),P(365,300),P(510,570),P(640,260),P(860,760)]];case'fire':return [[P(490,820),P(320,650),P(420,470),P(380,300),P(540,450),P(610,210),P(700,510),P(640,720),P(490,820)]];case'door':return [[P(280,820),P(280,240),P(720,240),P(720,820)],[P(500,820),P(500,470),P(650,470),P(650,820)]];case'road':return [[P(320,850),P(430,650),P(370,480),P(520,320),P(600,150)],[P(580,850),P(620,660),P(560,500),P(670,340),P(720,160)]];case'horns':return [[P(500,760),P(500,340)],[P(500,340),P(290,200),P(200,330)],[P(500,340),P(710,200),P(800,330)]];case'mouth':return [[P(200,500),P(360,380),P(640,380),P(800,500),P(640,620),P(360,620),P(200,500)]];case'teeth':return [[P(180,400),P(820,400)],[P(180,650),P(820,650)],[P(300,400),P(350,650)],[P(470,400),P(500,650)],[P(650,400),P(610,650)]];case'spear':return [[P(500,850),P(500,260)],[P(500,180),P(400,330),P(600,330),P(500,180)]];case'crown':return [[P(220,690),P(180,320),P(380,480),P(500,250),P(620,480),P(820,320),P(780,690),P(220,690)]];case'spiral':{const a=[];for(let i=0;i<22;i++){const t=i*.65,rad=20+i*15;a.push(P(cx+Math.cos(t)*rad,cy+Math.sin(t)*rad));}return[a]}case'heart':return [[P(500,820),P(250,570),P(220,370),P(360,260),P(500,390),P(640,260),P(780,370),P(750,570),P(500,820)]];case'tablet':return [[P(250,220),P(750,220),P(750,790),P(250,790),P(250,220)],[P(340,360),P(660,360)],[P(340,500),P(660,500)],[P(340,640),P(610,640)]];case'fork':return [[P(500,830),P(500,450),P(280,220)],[P(500,450),P(720,220)]];case'ladder':return [[P(310,820),P(310,190)],[P(690,820),P(690,190)],[P(310,350),P(690,350)],[P(310,520),P(690,520)],[P(310,690),P(690,690)]];case'zigzag':return [[P(180,250),P(420,420),P(250,590),P(520,760),P(790,560),P(650,330)]];case'loop':return [[P(500,180),P(720,330),P(720,620),P(500,800),P(280,620),P(280,330),P(500,180)],[P(500,180),P(500,800)]];case'arch':return [[P(240,820),P(250,430),P(360,250),P(500,190),P(640,250),P(750,430),P(760,820)]];case'chevron':return [[P(180,280),P(500,720),P(820,280)]];case'hook':return [[P(530,180),P(530,680),P(450,820),P(300,800),P(240,680)]];case'diamond':return [[P(500,150),P(820,500),P(500,850),P(180,500),P(500,150)],[P(500,150),P(500,850)]];case'trident':return [[P(500,850),P(500,240)],[P(500,420),P(300,240),P(250,390)],[P(500,420),P(700,240),P(750,390)]];case'gate':return [[P(260,820),P(260,230),P(740,230),P(740,820)],[P(500,230),P(500,820)]];default:return [[P(200,700),P(500,200),P(800,700)],[P(280,600),P(720,600)]];}}
function jitter(strokes,r,amount=0){return strokes.map(line=>line.map(p=>({x:p.x+(r()-.5)*amount*1000,y:p.y+(r()-.5)*amount*1000})));}
function transform(strokes,style={},seed=''){const r=rng(seed),slant=Number(style.slant||0),sx=Number(style.widthScale||1),sy=Number(style.heightScale||1),rot=Number(style.rotation||0)*Math.PI/180,co=Math.cos(rot),si=Math.sin(rot),cx=500,cy=500;return jitter(strokes,r,Number(style.noise||0)).map(line=>line.map(p=>{let x=(p.x-cx)*sx,y=(p.y-cy)*sy;x+=slant*(700-p.y);const nx=x*co-y*si,ny=x*si+y*co;return {x:cx+nx,y:cy+ny};}));}
function segmentOutline(a,b,w){const dx=b.x-a.x,dy=b.y-a.y,len=Math.hypot(dx,dy)||1,nx=-dy/len*w/2,ny=dx/len*w/2;return [{x:a.x+nx,y:a.y+ny},{x:b.x+nx,y:b.y+ny},{x:b.x-nx,y:b.y-ny},{x:a.x-nx,y:a.y-ny}];}
function circle(cx,cy,r,n=16){return Array.from({length:n},(_,i)=>{const t=i*Math.PI*2/n;return{x:cx+Math.cos(t)*r,y:cy+Math.sin(t)*r}})}
function outline(strokes,style={}){const width=Number(style.stroke||64),contours=[];for(const line of strokes){for(let i=1;i<line.length;i++)contours.push(segmentOutline(line[i-1],line[i],width));if(style.round>0.4){for(const p of line)contours.push(circle(p.x,p.y,width/2,10));}}return contours;}
function metrics(contours=[],style={}){const pts=contours.flat();if(!pts.length)return {advanceWidth:700,leftSideBearing:50,bbox:{xMin:0,yMin:0,xMax:600,yMax:700}};const xs=pts.map(p=>p.x),ys=pts.map(p=>p.y),xMin=Math.min(...xs),xMax=Math.max(...xs),yMin=Math.min(...ys),yMax=Math.max(...ys),side=Number(style.sideBearing||70);return {advanceWidth:Math.ceil(xMax-xMin+side*2),leftSideBearing:side,bbox:{xMin,yMin,xMax,yMax}};}
function synthesize(input={}){const r=rng(input.seed||`${input.meaning}:${input.sound}:${input.id}`),medium=input.medium||'stone',base={...MEDIA[medium],...(input.style||{})},motifName=input.motif||motifFor(input.meaning,input.sound,input.seed),skeleton=transform(motif(motifName,r),base,input.seed||input.id||motifName),contours=outline(skeleton,base),m=metrics(contours,base);return {...clone(input),motif:motifName,medium,style:base,skeleton,contours,advanceWidth:input.advanceWidth||m.advanceWidth,leftSideBearing:m.leftSideBearing,bbox:m.bbox,procedural:true};}
function evolveGlyph(glyph={},history=[],opts={}){let g=clone(glyph),style={...(glyph.style||{})};for(const h of history||[]){const reason=String(h.reason||'').toLowerCase();if(/stone|carv/.test(reason)){style={...style,...MEDIA.stone};}if(/brush|ink/.test(reason)){style={...style,...MEDIA.brush};}if(/curs/.test(reason)){style={...style,...MEDIA.cursive};style.slant=(style.slant||0)+.1;}if(/print|standard/.test(reason)){style={...style,...MEDIA.print};style.noise=0;}if(/screen|digital/.test(reason)){style={...style,...MEDIA.screen};}if(/simplif|rapid/.test(reason)){style.widthScale=(style.widthScale||1)*.88;style.rotation=(style.rotation||0)+(opts.rotationStep||2);}}return synthesize({...g,style,seed:`${opts.seed||g.id}:evolved`});}
function variants(glyph={},count=3,opts={}){const out=[];for(let i=0;i<count;i++)out.push(synthesize({...glyph,style:{...(glyph.style||{}),noise:Math.max(.008,Number(glyph.style?.noise||.015))+(i+1)*.004,slant:Number(glyph.style?.slant||0)+(i-(count-1)/2)*.025},seed:`${opts.seed||glyph.id}:variant:${i}`}));return out;}
function ligature(a,b,opts={}){const A=clone(a.contours||[]),B=clone(b.contours||[]),shift=Number(a.advanceWidth||700)*.66,scale=.78,map=(cs,dx)=>cs.map(c=>c.map(p=>({x:p.x*scale+dx,y:p.y})));const contours=[...map(A,0),...map(B,shift)];return {id:`liga-${a.id||a.name}-${b.id||b.name}`,name:`${a.name||a.id}_${b.name||b.id}`,components:[a.id||a.name,b.id||b.name],contours,advanceWidth:Math.ceil(shift+(b.advanceWidth||700)*scale),ligature:true};}
function synthesizeAlphabet(symbols=[],opts={}){return symbols.map((s,i)=>s.contours?.length?clone(s):synthesize({...s,medium:s.medium||opts.medium||'stone',style:{...(opts.style||{}),...(s.style||{})},seed:`${opts.seed||'alphabet'}:${s.id||i}:${s.meaning}:${s.sound}`}));}
function attachToScript(scriptResult={},opts={}){const out=clone(scriptResult),modern=out.modern||out.stages?.at(-1);if(!modern)return out;modern.symbols=synthesizeAlphabet(modern.symbols||[],opts).map(s=>s.contours?.length?s:evolveGlyph(s,s.history||[],opts));out.modern=modern;if(Array.isArray(out.stages)&&out.stages.length)out.stages[out.stages.length-1]=modern;if(global.WriterToolsScriptEvolution?.buildEvolutionTable)out.letterEvolutionTable=global.WriterToolsScriptEvolution.buildEvolutionTable(modern.symbols||[],modern.retiredSymbols||[]);return out;}
async function buildTTF(symbols=[],opts={}){if(!global.WriterToolsFontTTF)throw new Error('helper-creative.js must be loaded');const glyphs=synthesizeAlphabet(symbols,opts).map((s,i)=>({name:s.name||s.id||`glyph${i}`,unicode:s.codePoint??0xE000+i,contours:s.contours,advanceWidth:s.advanceWidth||700,meaning:s.meaning,sound:s.sound}));return global.WriterToolsFontTTF.buildTTF(glyphs,{familyName:opts.familyName||'Procedural Evolved Script',styleName:opts.styleName||'Regular'});}
async function ungzip64(b64){const bin=Uint8Array.from(atob(b64),c=>c.charCodeAt(0));if(typeof DecompressionStream!=='undefined'){const ab=await new Response(new Blob([bin]).stream().pipeThrough(new DecompressionStream('gzip'))).arrayBuffer();return new TextDecoder().decode(ab);}if(global.pako?.ungzip)return new TextDecoder().decode(global.pako.ungzip(bin));throw new Error('No gzip decompressor available.');}
const ATLAS_META={"name":"Procedural Glyph Design & Media Evolution Atlas","records":70000,"shards":7,"raw_bytes":28286088,"gzip_bytes":4258498,"encoding":"gzip+base64","runtime":"lazy"};const PACKS=["","","","","","",""];const cache=new Map();async function loadAtlasShard(i=0){i=Math.max(0,Math.min(PACKS.length-1,Number(i)||0));if(cache.has(i))return cache.get(i);const data=JSON.parse(await ungzip64(PACKS[i]));cache.set(i,data);return data;}async function sampleAtlas(query={},n=8){const i=hash(JSON.stringify(query))%PACKS.length,rows=await loadAtlasShard(i),terms=Object.values(query).flatMap(v=>Array.isArray(v)?v:[v]).filter(Boolean).map(x=>String(x).toLowerCase());let out=terms.length?rows.filter(row=>terms.some(t=>JSON.stringify(row).toLowerCase().includes(t))):rows;const r=rng(JSON.stringify(query));if(out.length>n)out=[...out].sort(()=>r()-.5).slice(0,n);return clone(out.slice(0,n));}
global.WriterToolsGlyphSynthesis=Object.freeze({MEDIA,MOTIFS,motifFor,motif,synthesize,evolveGlyph,variants,ligature,synthesizeAlphabet,attachToScript,buildTTF,atlasInfo:()=>clone(ATLAS_META),loadAtlasShard,sampleAtlas});
})(typeof globalThis!=='undefined'?globalThis:window);

