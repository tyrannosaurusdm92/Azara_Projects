/* ===== People+Places source: 25-dialogue-renderer.js ===== */
(function(g){"use strict";const P=g.PeoplePlaces,U=P.Utils;
function choose(person,arr,salt){return new P.Random(`${person.seed}|dialogue|${salt}|${person.conversation?.turn||0}`).pick(arr)}
function base(world,person,plan,text){const n=person.name.first,life=person.life,work=life.workEducation.work,edu=life.workEducation.education,intent=plan.intent.id,home=world.places.find(x=>x.id===life.homePlaceId),where=plan.place;switch(intent){case'greet':return choose(person,[`Hey. I'm ${n}.`,`Hi — good to see you.`,`Hello. What's up?`],'greet');case'goodbye':return choose(person,[`See you later.`,`Take care.`,`All right — talk soon.`],'bye');case'thank':return choose(person,[`You're welcome.`,`Of course.`,`Any time.`],'thanks');case'apologize':return person.personality.conflictStyle==='direct'?`I appreciate you saying that. I'd rather be clear about what happened.`:`Thanks. I needed to hear that.`;case'ask-mood':return `I'm feeling ${person.mood.label} right now${person.mood.causes?.length?`, mostly because ${person.mood.causes.at(-1)}`:''}.`;case'ask-work':return work.status==='employed'?`I work as a ${work.occupation}. My schedule is usually ${work.schedule}.`:work.status==='retired'?`I'm retired now, so my days are a lot more self-directed.`:`I'm not working right now.`;case'ask-school':return edu.status==='enrolled'?`I'm in a ${edu.type}, focused on ${edu.field}.`:`I'm not currently enrolled. My education background is ${edu.level||'pretty mixed'}.`;case'ask-home':return home?`I live at ${home.name}, a ${home.kind} in ${home.geography.neighborhood}.`:`My home situation isn't filled in yet.`;case'ask-hobbies':return `For fun, I'm usually into ${U.joinNatural(person.interests.hobbies.slice(0,4))}.`;case'ask-relationship':if(person.life.age<18)return`I don't have adult romantic relationship data.`;if(!plan.relationshipContext.romanticCount)return`I'm not currently connected to a romantic partner in this world.`;return`My relationship framework is ${person.identity.relationshipFramework}. ${plan.relationshipContext.romanticNames.length?`I'm connected with ${U.joinNatural(plan.relationshipContext.romanticNames)}.`:''}`;case'ask-memory':if(plan.memories.length)return`I remember this: ${plan.memories[0].record.summary}`;return`Nothing specific is coming up for me from that.`;case'ask-goal':return`One thing I care about right now is to ${person.personality.goals[0]}.`;case'ask-history':{const m=person.memory.records.find(x=>x.kind==='achievement'||x.kind==='episodic');return m?`One thing from my past that still stands out is that ${m.summary}`:`My history is still pretty open-ended.`}case'ask-place':return where?P.LocationEngine.describe(where):`I'm not anchored to a location right now.`;case'compliment':return person.personality.traits.includes('reserved')?`Thanks. That's kind of you to say.`:`Thank you — I appreciate that.`;case'invite':return person.mood.label==='tired'?`Maybe, but I'd need something low-key. I'm pretty tired.`:`Possibly. What did you have in mind?`;case'ask-opinion':return`I tend to look at things through ${U.joinNatural(person.personality.values.slice(0,2))}, so I'd want more context before I settle on an opinion.`;default:if(plan.memories.length&&plan.memories[0].score>.25)return`That connects with something I remember: ${plan.memories[0].record.summary}`;return choose(person,[`Tell me a little more about that.`,`Yeah, I'm following you.`,`That makes me think about ${person.interests.favoriteTopics[0]||'a few things'}. What part matters most to you?`],'small')}}
function stylize(person,text){const s=person.personality.communicationStyles||[];if(s.includes('concise'))return text.split(/(?<=[.!?])\s+/).slice(0,2).join(' ');if(s.includes('storytelling')&&text.length<140)return text+` I tend to connect things back to little details and stories.`;if(s.includes('dry')&&/good|great|fine/i.test(text))return text+` Riveting, I know.`;return text}
function respond(world,person,input){person.conversation=person.conversation||{turn:0,transcript:[]};const plan=P.ConversationPlanner.plan(world,person,input);if(plan.fact){P.MemoryStore.add(person,{kind:'conversation',summary:`The other speaker said their ${plan.fact.type} is ${plan.fact.value}.`,tags:['speaker-fact',plan.fact.type],salience:.72,confidence:.94,emotionalWeight:.25,source:'conversation'})}let output=stylize(person,base(world,person,plan,input));person.conversation.turn++;person.conversation.transcript.push({turn:person.conversation.turn,input,output,intent:plan.intent.id,at:U.nowISO()});person.conversation.transcript=person.conversation.transcript.slice(-250);P.MemoryStore.add(person,{kind:'conversation',summary:`Had a conversation about ${plan.topic||plan.intent.id}.`,tags:[plan.intent.id],salience:.22,confidence:.85,emotionalWeight:.15,source:'conversation'});return{output,plan}}
P.register('DialogueRenderer',{respond});})(window);


/* ===== People+Places source: 26-group-conversation.js ===== */
(function(g){"use strict";const P=g.PeoplePlaces,U=P.Utils;
function simulate(world,personIds,topic,turns=6){const people=personIds.map(id=>world.people.find(p=>p.id===id)).filter(Boolean),out=[];if(people.length<2)return out;let previous=null;for(let i=0;i<turns;i++){const candidates=people.filter(p=>p.id!==previous?.id),speaker=new P.Random(`${world.seed}|group|${topic}|${i}`).pick(candidates),prompt=i===0?`Let's talk about ${topic}.`:`What do you think about ${topic}?`;const res=P.DialogueRenderer.respond(world,speaker,prompt);out.push({speakerId:speaker.id,speakerName:speaker.name.first,text:res.output});previous=speaker;for(const listener of people.filter(p=>p.id!==speaker.id))P.MemoryStore.add(listener,{kind:'conversation',summary:`${speaker.name.first} said: ${res.output}`,entities:[speaker.id],tags:['group-conversation',topic],salience:.35,emotionalWeight:.2,confidence:.8,source:'overheard'})}return out}
