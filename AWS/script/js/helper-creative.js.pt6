function generate(random,opts={}){const r=random.fork(`spec-place-${opts.mode||'fantasy'}-${opts.role||'general'}`),genre=opts.mode==='scifi'?'scifi':'fantasy',type=opts.typeId?typeById(opts.typeId):chooseType(r,genre,opts.role||'general'),tone=opts.tone||r.pick(genre==='fantasy'?['neutral','ancient','bright','wild','enchanted','eerie','coastal','frozen']:['neutral','bright','dark']),built=genre==='scifi'?scifiName(type,tone,opts.namingMode||'mixed',r):fantasyName(type,tone,opts.namingMode||'mixed',r),ctx=opts.settingContext||{},anchor=ctx.anchorName||ctx.settlementName||ctx.systemName||'the surrounding region',assignment=assignmentByKind(type.assignment,r);return{id:opts.id||`place-${U.slug(built.name)}-${r.int(100,999)}`,seed:r.seed,name:opts.name||built.name,kind:type.name,mode:genre,genre,locationTypeId:type.id,category:type.category,texture:type.texture,assignmentKind:type.assignment,defaultAssignment:assignment,useRoles:rolesFor(type),geography:genre==='scifi'?{country:'Interstellar / user-defined',region:ctx.systemName||'Unspecified star system',city:anchor,neighborhood:type.category}:{country:'Fictional / user-defined',region:ctx.realmName||'Unspecified realm',city:ctx.settlementName||anchor,neighborhood:type.category},descriptors:genre==='scifi'?r.sample(['pressurized','modular','remote','high-traffic','quiet','industrial','research-focused','residential','multispecies','automated','low-gravity','spin-gravity','shielded','windowed'],r.int(3,6)):r.sample(['enchanted','lantern-lit','weathered','welcoming','busy','quiet','wood-framed','stone-built','market-lined','garden-filled','river-adjacent','guild-run','old','bright','cozy'],r.int(3,6)),accessibility:{stepFreeEntry:r.chance(.82),elevator:genre==='scifi'?r.chance(.88):r.chance(.42),accessibleRestroom:r.chance(.72),quietSpace:r.chance(.55),transitAccess:r.chance(.75)},ambience:{noise:r.pick(['very quiet','quiet','moderate','busy','loud']),lighting:r.pick(genre==='scifi'?['soft panels','bright panels','natur