function referenceObject(result={}){const core=oldReference?.(result)||{};return{...core,voice:'William Saville + research-driven craft correction',historyNarrative:global.WriterToolsLanguageEvolution?.describeHistory?.(result)||'',scriptNarrativeText:global.WriterToolsScriptEvolution?.narrativeText?.(result.scriptEvolution||{})||'',williamVoice:global.WriterWilliamVoice?.buildPacket?.({kind:'language_history',prompt:result.name||'language reference',includeEvidence:false})||null,fullText:buildText(result)};}
async function buildArtifacts(result={},opts={}){const a=await base.buildArtifacts(result,opts);const text=buildText(result);a.txt=new Blob([text],{type:'text/plain;charset=utf-8'});a.fullReferenceText=text;return a;}
global.WriterToolsLanguageExport=Object.freeze({...base,extendedLines,buildText,referenceObject,buildArtifacts});
})(typeof globalThis!=='undefined'?globalThis:window);

