function eventPressure(events,from,to){const active=events.filter(e=>e.year>from&&e.year<=to);let p={contact:0,standardization:0,shift:0,isolation:0,revitalization:0};for(const e of active){if(['migration','conquest','trade','urbanization','diaspora'].includes(e.type)||e.contactLanguage)p.contact+=e.intensity;if(['state_centralization','mass_schooling','printing','language_policy'].includes(e.type))p.standardization+=e.intensity;if(['conquest','diaspora','population_decline','language_policy'].includes(e.type))p.shift+=e.intensity;if(e.type==='isolation')p.isolation+=e.intensity;if(e.type==='revitalization')p.revitalization+=e.intensity;}return {active,...p};}
