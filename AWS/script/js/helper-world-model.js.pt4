function buildRuleGuide(result={}){const guide=oldGuide?.(result)||result;return{...guide,descriptiveVoice:'William Saville + research-driven clarity',historyNarrative:global.WriterWilliamVoice?.historyNarrative?.(result)||'',williamVoice:global.WriterWilliamVoice?.buildPacket?.({kind:'language_history',prompt:[result.name,result.years,'language history grammar rules'].filter(Boolean).join(' '),includeEvidence:false})||null,expositionRules:['State what the input establishes before describing modeled inference.','Tie major changes to chronology and pressure where the simulation records one.','Use examples and plain-language explanations alongside linguistic terminology.','Avoid deterministic pictures→alphabet or primitive→advanced narratives.','Keep vivid phrasing subordinate to factual/model clarity.']};}
