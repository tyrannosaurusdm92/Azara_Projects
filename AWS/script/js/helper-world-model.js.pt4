function generate(input={}){const r=rng(input.seed||input.name||'grammar'),density=clamp(input.complexity??.58);let g={...clone(DEFAULT),...clone(input.base||input.grammar||{})};if(!input.grammar?.wordOrder)g.wordOrder=pick(r,WORD_ORDERS);if(!input.grammar?.morphology)g.morphology=pick(r,MORPHOLOGY);if(!input.grammar?.alignment)g.alignment=pick(r,ALIGNMENTS);if(input.caseCount==null&&!input.grammar?.caseCount)g.caseCount=g.morphology==='isolating'?Math.floor(r()*3):Math.round(2+r()*Math.round(10*density));g.caseCount=Math.max(0,Math.min(16,g.caseCount));g.cases=CASES.slice(0,g.caseCount);for(const [k,v] of Object.entries(VALUES))if(input.grammar?.[k]==null)g[k]=pick(r,v);if(input.grammar?.tam==null)g.tam=TAMS.filter(()=>r()<.35+density*.25).slice(0,8);if(!g.tam.length)g.tam=['past','nonpast'];if(input.grammar?.evidentiality==null)g.evidentiality=r()<.35?pick(r,[...EVIDENTIALS, EVIDENTIALS.slice(0,3)]):'none';if(input.grammar?.genderClasses==null)g.genderClasses=r()<.55?0:pick(r,[2,3,4,5,8,12]);if(input.grammar?.inclusiveExclusive==null)g.inclusiveExclusive=r()<.38;if(input.grammar?.proDrop==null)g.proDrop=r()<.5;if(input.grammar?.serialVerbs==null)g.serialVerbs=r()<.35;if(input.grammar?.politeness==null)g.politeness=pick(r,['none','T/V distinction','honorific particles','honorific morphology','register-dependent']);g=correlate(g,r);return g;}
function tokenizeRule(s){const src=String(s||'').trim(),out=[];let i=0;while(i<src.length){if(/\s/.test(src[i])){i++;continue}const q=src[i];if(q==='"'||q==="'"){let j=i+1,v='';while(j<src.length&&src[j]!==q){if(src[j]==='\\'&&j+1<src.length){v+=src[++j];j++;}else v+=src[j++];}out.push({t:'str',v});i=j+1;continue}const m=src.slice(i).match(/^(=>|->|>=|<=|!=|==|[=,:;(){}\[\]|+?*\/]|[A-Za-z_][\w.-]*|-?\d+(?:\.\d+)?)/);if(!m)throw new Error(`Grammar rule token error near: ${src.slice(i,i+20)}`);const v=m[1];out.push({t:/^-?\d/.test(v)?'num':/^[A-Za-z_]/.test(v)?'id':'op',v});i+=v.length;}return out;}
