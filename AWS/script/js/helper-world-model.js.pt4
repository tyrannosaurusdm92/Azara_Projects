function coerce(v){const s=String(v).trim();if(/^true$/i.test(s))return true;if(/^false$/i.test(s))return false;if(/^null$/i.test(s))return null;if(/^-?\d+(?:\.\d+)?$/.test(s))return Number(s);if((s[0]==='"'&&s.at(-1)==='"')||(s[0]==="'"&&s.at(-1)==="'"))return s.slice(1,-1);if(s.includes(','))return s.split(',').map(x=>coerce(x));return s;}
function applyRule(grammar,rule){const g=clone(grammar),r=typeof rule==='string'?parseRule(rule):rule;if(!r)return g;if(r.type==='set'){const path=r.path.split('.');let o=g;while(path.length>1){const k=path.shift();o=o[k]??(o[k]={});}o[path[0]]=r.value;return g;}if(r.type==='rewrite'){for(const k of Object.keys(g)){if(String(g[k])===r.lhs)g[k]=coerce(r.rhs);}return g;}return g;}
function evolve(grammar={},opts={}){const r=rng(opts.seed||'grammar-evolution'),years=Number(opts.years||1500),steps=Math.max(1,Math.ceil(years/Number(opts.stageYears||150))),contact=clamp(opts.contact||0),standard=clamp(opts.standardization||0),stages=[{year:0,grammar:clone(grammar),changes:[]}];let g=clone(grammar);for(let i=1;i<=steps;i++){const changes=[];const p=.08+contact*.08;if(r()<p&&g.caseCount>0){g.caseCount=Math.max(0,g.caseCount-1);g.cases=(g.cases||[]).slice(0,g.caseCount);changes.push('case syncretism/loss');}if(r()<.08&&g.articles==='none'){g.articles='definite article';g.articlePosition=pick(r,['before noun','after noun','clitic']);changes.push('demonstrative grammaticalized into article');}if(r()<.07){const old=g.negation;g.negation=pick(r,VALUES.negation.filter(x=>x!==old));changes.push(`negation cycle: ${old} → ${g.negation}`);}if(r()<.07){const old=g.morphology;g.morphology=pick(r,MORPHOLOGY.filter(x=>x!==old));changes.push(`morphological restructuring: ${old} → ${g.morphology}`);}if(r()<.055+contact*.05){const old=g.wordOrder;g.wordOrder=pick(r,WORD_ORDERS.filter(x=>x!==old));changes.push(`clause order drift/reanalysis: ${old} → ${g.wordOrder}`);}if(r()<.055){g.proDrop=!g.proDrop;changes.push(`pro-drop ${g.proDrop?'expanded':'reduced'}`);}if(r()<.04&&g.evidentiality==='none'){g.evidentiality=pick(r,EVIDENTIALS);changes.push('evidential marker grammaticalized');}if(r()<.04){g.inclusiveExclusive=!g.inclusiveExclusive;changes.push(`inclusive/exclusive distinction ${g.inclusiveExclusive?'emerged':'leveled'}`);}if(standard>.5&&r()<.12){changes.push('standardization reduced competing paradigms');if(Array.isArray(g.cases))g.cases=[...new Set(g.cases)];}g=correlate(g,r);stages.push({year:Math.min(years,i*Math.ceil(years/steps)),grammar:clone(g),changes});}return {modern:g,stages};}
function validate(g={}){const issues=[];if(!WORD_ORDERS.includes(g.wordOrder))issues.push({severity:'warning',code:'unknown-word-order',message:`Unrecognized word order ${g.wordOrder}`});if(!MORPHOLOGY.includes(g.morphology))issues.push({severity:'warning',code:'unknown-morphology',message:`Unrecognized morphology ${g.morphology}`});if(Number(g.caseCount)!==(g.cases||[]).length&&Array.isArray(g.cases))issues.push({severity:'note',code:'case-count-mismatch',message:'caseCount and cases list differ.'});if(g.morphology==='isolating'&&g.caseCount>8)issues.push({severity:'note',code:'typology-tension',message:'A strongly isolating profile with many inflectional cases is unusual; keep it if historically motivated.'});return {ok:!issues.some(x=>x.severity==='error'),issues};}
function sentenceOrder(grammar=DEFAULT,slots={S:'S',V:'V',O:'O'}){const order=String(grammar.wordOrder||'SOV').replace(/[^SVO]/g,'');return (order||'SOV').split('').map(k=>slots[k]).filter(Boolean);}
function realize({grammar=DEFAULT,subject='speaker',verb='see',object='thing',markers={}}={}){let s=subject,v=verb,o=object;if(grammar.alignment==='ergative-absolutive'&&markers.ergative)s+=markers.ergative;if(grammar.alignment==='nominative-accusative'&&markers.accusative)o+=markers.accusative;const seq=sentenceOrder(grammar,{S:s,V:v,O:o});if(grammar.negation&&markers.negative)seq.splice(Math.max(0,seq.indexOf(v)),0,markers.negative);return seq.join(' ');}
async function ungzip64(b64){const bin=Uint8Array.from(atob(b64),c=>c.charCodeAt(0));if(typeof DecompressionStream!=='undefined'){const ab=await new Response(new Blob([bin]).stream().pipeThrough(new DecompressionStream('gzip'))).arrayBuffer();return new TextDecoder().decode(ab);}if(global.pako?.ungzip)return new TextDecoder().decode(global.pako.ungzip(bin));throw new Error('No gzip decompressor available. Modern browsers support DecompressionStream; otherwise load pako.');}
