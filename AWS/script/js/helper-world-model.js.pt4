 adpositionOrder:['prepositions','postpositions','mixed/circumpositions'],genitiveOrder:['Gen-N','N-Gen','mixed'],adjectiveOrder:['Adj-N','N-Adj','mixed'],relativeOrder:['Rel-N','N-Rel','internally headed'],articlePosition:['before noun','after noun','clitic','none'],questionStrategy:['particle','intonation','wh-fronting','wh-in-situ','verb movement','mixed'],negation:['preverbal particle','postverbal particle','bipartite','negative auxiliary','negative affix','multiple strategies'],
