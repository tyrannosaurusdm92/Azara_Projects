async function sampleResearch(query={},count=12){const q=query||{},seed=hash(JSON.stringify(q)),out=[];for(let n=0;n<Math.max(1,count);n++){const si=(seed+n*2654435761)%RESEARCH_META.length,rows=await loadResearchShard(si);let pool=rows.filter(r=>(!q.domain||r.domain===q.domain)&&(!q.mechanism||r.mechanism===q.mechanism)&&(!q.register||r.register===q.register)&&(!q.region||r.region===q.region)&&(!q.historical_event||r.historical_event===q.historical_event));if(!pool.length)pool=rows;out.push(clone(pool[(seed+n*2246822519)%pool.length]));}return out;}
function factor(v,d=3){v=Number(v);return Number.isFinite(v)?Math.max(0,Math.min(5,v)):d;}
function assessVitalityDetailed(events=[],year=0,baseState={}){const f={transmission:factor(baseState.transmission,5),absoluteSpeakers:factor(baseState.absoluteSpeakers,4),populationProportion:factor(baseState.populationProportion,4),domains:factor(baseState.domains,4),newMedia:factor(baseState.newMedia,3),educationMaterials:factor(baseState.educationMaterials,3),communityAttitudes:factor(baseState.communityAttitudes,4),policySupport:factor(baseState.policySupport,3),documentation:factor(baseState.documentation,2)};for(const e of (events||[]).filter(x=>Number(x.year||0)<=year)){const i=Math.max(0,Math.min(1,Number(e.intensity??.5))),t=String(e.type||'').toLowerCase(),prest=String(e.prestige||'').toLowerCase();if(/population_decline|diaspora|displacement|war/.test(t)){f.absoluteSpeakers-=1.1*i;f.populationProportion-=.7*i;}if(/mass_schooling|state_centralization|language_policy|script_policy/.test(t)&&prest==='low'){f.transmission-=.9*i;f.domains-=.8*i;f.policySupport-=.9*i;}if(/urbanization|trade|migration|intermarriage/.test(t)){f.domains-=.25*i;f.newMedia+=.15*i;}if(/printing|broadcast|digital|literacy/.test(t)){f.newMedia+=.65*i;f.educationMaterials+=.35*i;f.documentation+=.25*i;}if(/revitalization|revival/.test(t)){f.transmission+=.9*i;f.domains+=.7*i;f.newMedia+=.7*i;f.educationMaterials+=.8*i;f.communityAttitudes+=.6*i;f.documentation+=.6*i;}if(prest==='high'){f.communityAttitudes+=.25*i;f.policySupport+=.2*i;}}for(const k of Object.keys(f))f[k]=Math.max(0,Math.min(5,f[k]));const mean=Object.values(f).reduce((a,b)=>a+b,0)/Object.keys(f).length;const status=mean>=4.4?'robust in this fictional scenario':mean>=3.6?'stable but pressured in this fictional scenario':mean>=2.8?'vulnerable in this fictional scenario':mean>=2?'endangered in this fictional scenario':mean>=1?'severely endangered in this fictional scenario':'dormant/extinct in ordinary transmission in this fictional scenario';return {year,factors:f,mean,status,caveat:'Fiction/worldbuilding heuristic modeled after multi-factor vitality frameworks. No single factor, score, or speaker count is sufficient to assess a real language community.'};}
function compileGrammarRules(grammar={},opts={}){const g=grammar||{},rules=[];if(g.wordOrder)rules.push(`Default constituent order: ${g.wordOrder}; discourse can license marked alternatives.`);if(g.adpositionOrder)rules.push(`Adpositions: ${g.adpositionOrder}.`);if(g.adjectiveOrder)rules.push(`Adjective position: ${g.adjectiveOrder}.`);if(g.genitiveOrder)rules.push(`Genitive order: ${g.genitiveOrder}.`);if(g.relativeClauseOrder)rules.push(`Relative clauses: ${g.relativeClauseOrder}.`);if(g.alignment)rules.push(`Alignment: ${g.alignment}.`);if(g.morphology)rules.push(`Morphological profile: ${g.morphology}.`);if(Number.isFinite(Number(g.caseCount)))rules.push(`Productive case distinctions: about ${Number(g.caseCount)}.`);if(g.articles)rules.push(`Articles/determiners: ${g.articles}.`);if(g.negation)rules.push(`Negation strategy: ${g.negation}.`);if(g.questions)rules.push(`Question strategy: ${g.questions}.`);if(g.agreement)rules.push(`Agreement: ${g.agreement}.`);for(const x of g.extraRules||[])rules.push(String(x));return {rules,usageNotes:['Treat defaults as tendencies unless the project declares them categorical.','Keep morphology, syntax, information structure, register, and historical residue separable.','Irregular high-frequency forms and analogical leveling can coexist.'],register:opts.register||'neutral'};}
function registerProfile(seed='language',year=0){const r=seeded(`${seed}:${year}:register`),profiles=['conservative formal','innovative urban casual','regional vernacular','ritual/ceremonial','trade/contact','youth slang','literary standard','administrative standard'];return profiles.slice().sort(()=>r()-.5).slice(0,4).map((name,i)=>({name,innovationRate:Number((.15+r()*.7).toFixed(2)),borrowingRate:Number((r()*.65).toFixed(2)),orthographicConservatism:Number((r()).toFixed(2)),prestige:i===0?'overt':i===1?'covert':'mixed'}));}
function lexicalInnovationPlan(stage={},opts={}){const seed=opts.seed||stage.name||'lexicon',r=seeded(`${seed}:${stage.year||0}:lexicon`),processes=['derivation','compounding','borrowing','calque','semantic broadening','semantic narrowing','metaphor','metonymy','clipping','blending','reduplication','taboo replacement','euphemism','dysphemism','backformation','acronym'];const count=Math.max(4,Math.min(24,Number(opts.count||10))),out=[];for(let i=0;i<count;i++)out.push({process:processes[Math.floor(r()*processes.length)],domain:['home','food','kinship','technology','religion','trade','politics','art','youth culture','work','landscape','emotion'][Math.floor(r()*12)],register:['neutral','formal','casual','slang','technical','ritual'][Math.floor(r()*6)],productivity:Number((r()).toFixed(2))});return out;}
function buildDialectNetwork(language={},opts={}){const seed=opts.seed||language.name||'dialects',r=seeded(seed),rawCount=Array.isArray(opts.count)?opts.count.length:opts.count,count=Math.max(2,Math.min(12,Number(rawCount)||4)),regions=opts.regions||['core','coast','highlands','capital','frontier','diaspora','river','island'],out=[];for(let i=0;i<count;i++){const name=opts.names?.[i]||`${language.name||'Language'} ${regions[i%regions.length]} variety`;let d;try{d=base.createDialect(language,{seed:`${seed}:${i}`,name,region:regions[i%regions.length]});}catch(_e){d=clone(language);d.name=name;d.region=regions[i%regions.length];}d.social={prestige:i===0?'standard/overt':i===1?'covert local':'mixed',mobility:Number(r().toFixed(2)),contact:Number(r().toFixed(2)),identityStrength:Number(r().toFixed(2))};d.registers=registerProfile(`${seed}:${i}`,language.year||0);out.push(d);}return out;}
function orthographyProfile(result={},opts={}){const modern=result.modern||result,script=result.scriptEvolution?.modern||result.scriptEvolution?.stages?.at?.(-1)||null,phonemes=modern.phonemes||[];const represented=new Set((script?.symbols||[]).map(x=>x.sound).filter(Boolean)),missing=phonemes.filter(x=>!represented.has(x)),extra=(script?.symbols||[]).filter(x=>x.sound&&!phonemes.includes(x.sound));return {scriptType:script?.scriptType||modern.script?.type||'project-defined',direction:script?.direction||modern.script?.direction||'project-defined',phonemeCount:phonemes.length,activeLetterCount:script?.symbols?.length||0,unrepresentedPhonemes:missing,historicalLettersWithoutModernPhoneme:extra.map(x=>x.name||x.id),principles:['Spelling may lag pronunciation.','Morphological transparency can compete with phonemic transparency.','Loanwords can preserve foreign-looking spellings or be nativized.','Reform may be partial, contested, reversed, or coexist with older standards.']};}
function enrichResult(core,input={}){const r=clone(core),events=r.historicalEvents||input.events||input.history||[];r.schema='writer.language-evolution.v2';r.researchModel='diachronic+sociolinguistic+orthographic expansion';r.stages=(r.stages||[]).map(s=>({...s,vitalityDetailed:assessVitalityDetailed(events,s.year,input.vitality||{}),registers:registerProfile(r.seed||r.name,s.year),lexicalInnovation:lexicalInnovationPlan(s,{seed:r.seed,count:8}),grammarGuide:compileGrammarRules(s.grammar)}));r.modern=clone(r.stages.at(-1)||r.modern||{});r.dialectNetwork=buildDialectNetwork(r.modern,{seed:`${r.seed||r.name}:dialects`,count:Array.isArray(input.dialects)?input.dialects.length:(input.dialectCount||input.dialects||4),names:Array.isArray(input.dialects)?input.dialects:undefined,regions:input.regions});r.orthographyProfile=orthographyProfile(r,input);r.grammarGuide=compileGrammarRules(r.modern.grammar);r.vitalityDetailed=assessVitalityDetailed(events,r.years||r.modern.year||0,input.vitality||{});r.modelCaveats=[r.researchCaveat,'Changes are tendencies and pathways, not deterministic laws.','Writing-system history, spoken-language history, social identity, literacy policy, and register are tracked separately.','For real endangered languages, use community-specific evidence rather than this fictional simulation.'].filter(Boolean);return r;}
const simulateCore=base.simulate;
function simulateAdvanced(input={}){return enrichResult(simulateCore(input),input);}
function buildRuleGuideAdvanced(result={}){const r=result.schema==='writer.language-evolution.v2'?result:enrichResult(result,{}),m=r.modern||r;return {name:r.name||m.name,years:r.years,phonemeInventory:clone(m.phonemes||[]),phonotactics:clone(m.phonotactics||{}),grammar:clone(m.grammar||{}),grammarGuide:compileGrammarRules(m.grammar),lexicon:clone(m.lexicon||[]),dialects:clone(r.dialectNetwork||m.dialects||[]),registers:clone(m.registers||registerProfile(r.seed||r.name,m.year||0)),vitality:clone(r.vitalityDetailed||m.vitalityDetailed||m.vitality||null),orthography:clone(r.orthographyProfile||null),diachrony:(r.stages||[]).map(s=>({year:s.year,changes:s.changes||[],vitality:s.vitalityDetailed||s.vitality,registers:s.registers||[]})),scriptEvolution:clone(r.scriptEvolution||null),caveats:clone(r.modelCaveats||[])};}
async function sampleAtlasExpanded(query={},count=12){const a=await (base.sampleAtlas?.(query,Math.ceil(count/2))||[]),b=await sampleResearch(query,Math.floor(count/2)||1);return [...a,...b].slice(0,count);}
global.WriterToolsLanguageEvolution=Object.freeze({...base,simulateCore,simulate:simulateAdvanced,fastForward:simulateAdvanced,simulateAdvanced,assessVitalityDetailed,compileGrammarRules,registerProfile,lexicalInnovationPlan,buildDialectNetwork,orthographyProfile,buildRuleGuide:buildRuleGuideAdvanced,loadResearchShard,sampleResearch,sampleAtlasExpanded,researchAtlasInfo:()=>({shards:RESEARCH_META,totalRecords:RESEARCH_META.reduce((n,x)=>n+x.count,0),loaded:[...researchCache.keys()]})});
