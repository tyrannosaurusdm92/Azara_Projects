a","attributes":{"href":"#Editcvt"},"children":["'cvt 'テーブルを編集..."]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"  <A HREF=\"#ClearHints\">Clear Hints</A>"},"\n",{"tag":"a","attributes":{"href":"#ClearHints"},"children":["ヒントを削除(",{"tag":"u","attributes":{},"children":["C"]},")"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"  <A HREF=\"#ClearInstrs\">Clear Instructions</A>"},"\n",{"tag":"a","attributes":{"href":"#ClearInstrs"},"children":["ヒント命令を削除"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"  <A HREF=\"#Clear\">Clear HStem</A>"},"\n",{"tag":"a","attributes":{"href":"#Clear"},"children":["水平ステムヒントを削除(",{"tag":"u","attributes":{},"children":["C"]},")"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"  <A HREF=\"#ClearV\">Clear VStem</A>"},"\n",{"tag":"a","attributes":{"href":"#ClearV"},"children":["垂直ステムヒントを削除(",{"tag":"u","attributes":{},"children":["V"]},")"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"  <A HREF=\"#HHint\">Add HHint</A>"},"\n",{"tag":"a","attributes":{"href":"#HHint"},"children":["水平ヒントを追加(",{"tag":"u","attributes":{},"children":["A"]},")"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"  <A HREF=\"#VHint\">Add VHint</A>"},"\n",{"tag":"a","attributes":{"href":"#VHint"},"children":["垂直ヒントを追加(",{"tag":"u","attributes":{},"children":["V"]},")"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"  <A HREF=\"#Create\">Create HHint</A>"},"\n",{"tag":"a","attributes":{"href":"#Create"},"children":["水平ヒントを作成(",{"tag":"u","attributes":{},"children":["T"]},")..."]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"  <A HREF=\"#CreateV\">Create VHint</A>"},"\n",{"tag":"a","attributes":{"href":"#CreateV"},"children":["垂直ヒントを作成(",{"tag":"u","attributes":{},"children":["E)"]},"..."]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"  <A HREF=\"#Review\">Review Hints</A>"},"\n",{"tag":"a","attributes":{"href":"#Review"},"children":["ヒントを確認(",{"tag":"u","attributes":{},"children":["R"]},")..."]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"  <A HREF=\"#Histogram\">Histograms</A>"},"\n",{"tag":"a","attributes":{"href":"#Histgram"},"children":["柱状グラフ"]},"\n",{"tag":"ul","attributes":{},"children":["\n",{"tag":"li","attributes":{},"children":["\n",{"comment":"\t  <A HREF=\"hintsmenu.html#HStem-Hist\">HStem</A>"},"\n",{"tag":"a","attributes":{"href":"#HStem-Hist"},"children":["水平ステム(",{"tag":"u","attributes":{},"children":["H"]},")"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"\t  <A HREF=\"hintsmenu.html#VStem-Hist\">VStem</A>"},"\n",{"tag":"a","attributes":{"href":"#VStem-Hist"},"children":["垂直ステム(",{"tag":"u","attributes":{},"children":["V"]},")"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"tag":"a","attributes":{"href":"hintsmenu.page.json#Blue-Hist","hrefOriginal":"hintsmenu.html#Blue-Hist"},"children":["BlueValues"]},"\n"]}]},"\n"]}]},"\n",{"tag":"p","attributes":{},"children":["\n"]},{"tag":"dl","attributes":{},"children":["\n",{"tag":"dt","attributes":{},"children":["\n",{"comment":"  <A NAME=\"AutoHint\">AutoHint</A>"},"\n",{"tag":"a","attributes":{"name":"AutoHint"},"children":["自動ヒント(",{"tag":"u","attributes":{},"children":["H"]},")"]},"\n"]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"  The Auto Hint command causes FontForge to throw away any existing hints for\n      the glyph and guess an new ones. In the outline view this operates on the\n      current glyph, in the font view it operates on all selected glyphs.<BR>"},"\n",{"tag":"code","attributes":{},"children":["自動ヒント(",{"tag":"u","attributes":{},"children":["H"]},")"]}," コマンドを使うと、FontForge はそのグリフに設定された既存のヒントを放棄して新しく推測したヒントを追加します。アウトライングリフビューでは現在のグリフに対してこれを行い、フォントビューでは選択中のすべてのグリフに対して行います。",{"tag":"br","attributes":{},"children":[]},"\n",{"comment":"  FontForge will do a better job hinting a font if you have previously set\n      the BlueValues, StdVW and StdHW fields in\n      <A HREF=\"fontinfo.html#Private\">Element-&gt;Font Info-&gt;PS Private</A>.\n      These in turn depend on the hints so it is best to autohint the entire font,\n      then set the above values, and then autohint the font again."},"\n      FontForge は、",{"tag":"a","attributes":{"href":"fontinfo.page.json#Private","hrefOriginal":"fontinfo.html#Private"},"children":[{"tag":"code","attributes":{},"children":["エレメント(",{"tag":"u","attributes":{},"children":["L"]},")"]},"→",{"tag":"code","attributes":{},"children":["フォント情報(",{"tag":"u","attributes":{},"children":["F"]},")..."]},"→",{"tag":"code","attributes":{},"children":["[PS Private辞書]"]}]}," の ",{"tag":"code","attributes":{},"children":["BlueValues"]},", ",{"tag":"code","attributes":{},"children":["StdVW"]},", ",{"tag":"code","attributes":{},"children":["STDHW"]}," フィールドをあらかじめ設定しておくと、より高品質なヒントづけ処理を行います。これらの値もヒントに依存するので、まずフォント全体に自動ヒントづけを行い、それから上記の値を設定し、最後にフォントを再び自動ヒントづけすると、最も良い結果が得られます。\n    "]},{"tag":"dt","attributes":{},"children":["\n",{"comment":"  Hint <A NAME=\"SubstitutionPt\">Substitution</A> Pts"},"\n      ヒントが",{"tag":"a","attributes":{"name":"SubstitutionPt"},"children":["置換"]},"する点(",{"tag":"u","attributes":{},"children":["S"]},")\n    "]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"  In the font view this figures substitution points for all selected glyphs.\n      In the outline glyph view, this figures substitution points for the current\n      glyph using the current hint set."},"\n      フォントビューでこのコマンドを実行すると、選択中の全てのグリフに対して置換が行われる点を表示します。アウトライングリフビューでは、現在のヒントセットを使用して現在のグリフで置換が行われる点を表示します。\n    "]},{"tag":"dt","attributes":{},"children":["\n",{"comment":"  Auto <A NAME=\"Counter\">Counter</A>"},"\n",{"tag":"a","attributes":{"name":"Counter"},"children":["自動カウンタヒント(",{"tag":"u","attributes":{},"children":["C"]},")"]},"\n"]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"  Attempt to figure out counter groups for the selected glyphs (font view)\n      or the current glyph (outline glyph view)."},"\n      選択中のグリフのカウンタグループを表示しようと試みます (フォントビューの場合)。または現在のグリフのカウンタグループを表示しようと試みます (アウトライングリフビューの場合)。\n    "]},{"tag":"dt","attributes":{},"children":["\n",{"comment":"  <A NAME=\"DontAutoHint\">Don</A>'t AutoHint"},"\n",{"tag":"a","attributes":{"name":"DontAutoHint"},"children":["自動ヒントを停止(",{"tag":"u","attributes":{},"children":["D"]},")"]},"\n"]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"  Tells FontForge not to do any implicit hinting on the selected glyphs. (FontForge\n      will normally perform an autohint on a glyph if the glyph's contours have\n      changed since it was last hinted and the user has not explicitly changed\n      the hints). The user may turn this flag off by invoking AutoHint explicitly.\n<!--  Tells FontForge not to do any implicit hinting on the selected characters.\n      (FontForge will normally perform an autohint on a character if the character's\n      contours have changed since it was last hinted and the user has not explicitly\n      changed the hints). The user may turn this flag off by invoking AutoHint\n      explicitly."},"\n      選択中のグリフに対し、FontForge が暗黙のヒントづけをまったく行わないように指示します。(通常の場合は FontForge は、あるグリフに最後にヒントづけが行われて以来ユーザが明示的な変更をヒントに行わなかった場合、そのグリフを変更したときには自動ヒントづけを行います)。ユーザは、",{"tag":"code","attributes":{},"children":["自動ヒント(",{"tag":"u","attributes":{},"children":["H"]},")"]}," を明示的に呼び出すことによりこのフラグをオフにすることができます。\n      ",{"tag":"p","attributes":{},"children":["\n",{"comment":"  In the outline glyph view, behavior is a bit more complicated. This command\n      will toggle the current setting of the \"Don't AutoHint\" flag. If the flag\n      is currently on the menu entry will be checked."},"\n      アウトライングリフビューでは、そのふるまいはもう少し複雑です。このコマンドは現在の ",{"tag":"code","attributes":{},"children":["自動ヒントを停止(",{"tag":"u","attributes":{},"children":["D"]},")"]}," フラグの現在の設定を反転します。このフラグがメニューメニュー項目にある場合、そこにチェックマークが表示されます。\n    "]}]},{"tag":"dt","attributes":{},"children":["\n",{"comment":"  <A NAME=\"AutoInstr\">AutoInstr</A>"},"\n",{"tag":"a","attributes":{"name":"AutoInstr"},"children":["ヒント命令の自動生成(",{"tag":"u","attributes":{},"children":["I"]},")"]},"\n"]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"  The Auto Instr command is only available in quadratic fonts and is used to\n      generate truetype instructions. It doesn't do a good job. "},"\n",{"tag":"code","attributes":{},"children":["ヒント命令の自動生成(",{"tag":"u","attributes":{},"children":["I"]},")"]}," コマンドは 2 次スプラインからなるフォントでのみ使用可能で、TrueType 命令を生成するのに用いられます。これは品質の良いヒントを出力できません。\n    "]},{"tag":"dt","attributes":{},"children":["\n",{"comment":"  <A NAME=\"EditInstrs\">Edit Instructions...</A>"},"\n",{"tag":"a","attributes":{"name":"EditInstrs"},"children":["ヒント命令の編集(",{"tag":"u","attributes":{},"children":["E"]},")..."]},"\n"]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"  Only available in the outline and font views, and only in quadratic fonts.\n      <A HREF=\"ttfinstrs.html\">This dialog</A> shows any truetype instructions\n      associated with this glyph, and allows you to edit them. <BR>"},"\n      これはアウトラインビューとフォントビューに限られ、2 次スプラインからなるフォントでのみ使用可能です。",{"tag":"a","attributes":{"href":"ttfinstrs.page.json","hrefOriginal":"ttfinstrs.html"},"children":["このダイアログ"]},"はこのグリフに付随する任意の TrueType 命令を表示し、それらを編集することができます。",{"tag":"br","attributes":{},"children":[]},"\n",{"comment":"  Note there are some glyphs for which you cannot write instructions if they\n      contain references that cannot be represented in TrueType. If a glyph contains\n      a reference that is scaled by a factor of 2 or more, or if a glyph contains\n      both a reference and a contour then you may not generate instructions for\n      it. You can either: "},"\n      グリフに TrueType で表現不可能な参照が含まれでいるため、そのグリフに命令を付け加えることができない場合があることに注意してください。2 倍以上の比率で拡大された参照が含まれているか、1 個のグリフに参照と輪郭の両方が含まれている場合、そのグリフのための命令を出力することはできません。その場合、以下のいずれかが可能です:\n      ",{"tag":"ul","attributes":{},"children":["\n",{"tag":"li","attributes":{},"children":["\n",{"comment":"\t  Unlink all references "},"\n\t  すべての参照を解除する\n\t"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"\t  (in the case of a glyph with references and contours) Place all the contours\n\t  into a new glyph and make a reference to that glyph. (So the composite glyph\n\t  will now contain only references). "},"\n\t  (参照と輪郭の両方を含むグリフの場合) すべての輪郭を新しいグリフに位置し、そのグリフへの参照を作成する (それにより、複合グリフだったのが参照だけを含むようになります)。\n      "]}]},"\n"]},{"tag":"dt","attributes":{},"children":["\n",{"comment":"  <A NAME=\"Debug\">Debug</A>... "},"\n",{"tag":"a","attributes":{"name":"Debug"},"children":["デバッグ(",{"tag":"u","attributes":{},"children":["D"]},")"]},"...\n    "]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"  Only available in the outline view, and only if you have linked with a version\n      of freetype with the bytecode interpreter and only in quadratic fonts. This\n      allows you to <A HREF=\"charview.html#Debugging\">debug truetype programs</A>."},"\n      これはアウトラインビューに限られ、バイトコードインタプリタを有効にしてコンパイルされた FreeType にリンクされているときに、2 次スプラインからなるフォントでのみ使用可能です。これを使うと、",{"tag":"a","attributes":{"href":"charview.page.json#Debugging","hrefOriginal":"charview.html#Debugging"},"children":["TrueType のプログラムをデバッグする"]},"ことができます。\n    "]},{"tag":"dt","attributes":{},"children":["\n",{"comment":"  <A NAME=\"Editfpgm\">Edit fpgm...</A>"},"\n",{"tag":"a","attributes":{"name":"Editfpgm"},"children":["'fpgm'テーブルを編集..."]},"\n"]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"  Only available in the font view, and only in quadratic fonts.\n      <A HREF=\"ttfinstrs.html\">This dialog</A> shows any truetype instructions\n      in the 'fpgm' table, and allows you to edit them."},"\n      これはフォントビューに限られ、2 次スプラインからなるフォントに限られます。",{"tag":"a","attributes":{"href":"ttfinstrs.page.json","hrefOriginal":"ttfinstrs.html"},"children":["このダイアログ"]},"では‘fpgm’テーブルに含まれる任意の TrueType 命令を表示し、それを編集することができます。\n    "]},{"tag":"dt","attributes":{},"children":["\n",{"comment":"  <A NAME=\"Editprep\">Edit prep...</A>"},"\n",{"tag":"a","attributes":{"name":"Editprep"},"children":["'prep'テーブルを編集..."]},"\n"]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"  Only available in the font view, and only in quadratic fonts.\n      <A HREF=\"ttfinstrs.html\">This dialog</A> shows any truetype instructions\n      in the 'prep' table, and allows you to edit them. "},"\n      これはフォントビューに限られ、2 次スプラインからなるフォントに限られます。",{"tag":"a","attributes":{"href":"ttfinstrs.page.json","hrefOriginal":"ttfinstrs.html"},"children":["このダイアログ"]},"では‘prep’テーブルに含まれる任意の TrueType 命令を表示し、それを編集することができます。\n    "]},{"tag":"dt","attributes":{},"children":["\n",{"comment":"  <A NAME=\"Editcvt\">Edit cvt...</A>"},"\n",{"tag":"a","attributes":{"name":"Editcvt"},"children":["'cvt 'テーブルを編集..."]},"\n"]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"  Only available in the font view, and only in quadratic fonts.\n      <A HREF=\"ttfinstrs.html#cvt\">This dialog</A> shows the initial values in\n      the 'cvt ' table, and allows you to edit them. "},"\n      これはフォントビューに限られ、2 次スプラインからなるフォントに限られます。",{"tag":"a","attributes":{"href":"ttfinstrs.page.json#cvt","hrefOriginal":"ttfinstrs.html#cvt"},"children":["このダイアログ"]},"では‘cvt ’テーブルの初期値を表示し、それを編集することができます。\n    "]},{"tag":"dt","attributes":{},"children":["\n",{"comment":"  <A NAME=\"ClearHints\">Clear Hints</A>"},"\n",{"tag":"a","attributes":{"name":"ClearHints"},"children":["ヒントを削除(",{"tag":"u","attributes":{},"children":["C"]},")"]},"\n"]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"  Clears all hints in all selected glyph."},"\n      選択中のグリフの全てのヒントを消去します。\n    "]},{"tag":"dt","attributes":{},"children":["\n",{"comment":"  <A NAME=\"ClearInstrs\">Clear Instructions</A>"},"\n",{"tag":"a","attributes":{"name":"ClearInstrs"},"children":["ヒント命令を削除"]},"\n"]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"  Clears any truetype instructions associated with the selected glyphs."},"\n      選択中のグリフに伴う任意の TrueType 命令を消去します。\n    "]},{"tag":"dt","attributes":{},"children":["\n",{"comment":"  <A NAME=\"Clear\">Clear</A> HStem"},"\n",{"tag":"a","attributes":{"name":"Clear"},"children":["水平ステムヒントを削除(",{"tag":"u","attributes":{},"children":["C"]},")"]},"\n"]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"  Removes all Horizontal Stem hints from the current glyph."},"\n      現在のグリフからすべての水平ステムヒントを削除します。\n    "]},{"tag":"dt","attributes":{},"children":["\n",{"comment":"  <A NAME=\"ClearV\">Clear</A> VStem"},"\n",{"tag":"a","attributes":{"name":"ClearV"},"children":["垂直ステムヒントを削除(",{"tag":"u","attributes":{},"children":["V"]},")"]},"\n"]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"  Removes all Vertical Stem hints."},"\n      すべての垂直ステムヒントを削除します。\n    "]},{"tag":"dt","attributes":{},"children":["\n",{"comment":"  Add <A NAME=\"HHint\">HHint</A>"},"\n",{"tag":"a","attributes":{"name":"HHint"},"children":["水平ヒント"]},"を追加(",{"tag":"u","attributes":{},"children":["A"]},")\n    "]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"  If there are two points selected (exactly two) and if they have different\n      y positions, then this will create a Horizontal Stem Hint starting at the\n      lower one of the two going up to the upper one."},"\n      2 個 (ちょうど 2 個に限る) の点が選択されていて、それらの y 座標が異なる場合、下の点から始まり上の点で終わる水平ステムヒントを作成します。\n    "]},{"tag":"dt","attributes":{},"children":["\n",{"comment":"  Add <A NAME=\"VHint\">VHint</A>"},"\n",{"tag":"a","attributes":{"name":"VHint"},"children":["垂直ヒントを追加(",{"tag":"u","attributes":{},"children":["V"]},")"]},"\n"]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"  If there are two points selected (exactly two) and if they have different\n      x positions, then this will create a Vertical Stem Hint starting at the leftmost\n      one of the two going right to the rightmost one."},"\n      2 個 (ちょうど 2 個に限る) の点が選択されていて、それらの x 座標が異なる場合、左の点から始まり右の点で終わる垂直ステムヒントを作成します。\n    "]},{"tag":"dt","attributes":{},"children":