{"schema":"literary-friend.reference-page.v1","originalPath":"assets/fontforge-reference/doc/sphinx/olddocs/old/de/editexample3.html","title":"Konsistente Serifen und Stammbreiten","sourceSha256":"42e1ef31f219c08ad3e6e1252efd2841abd13fb2250816394135cf7040c2bfae","headingIndex":[{"level":1,"text":"Tutorial #3"},{"level":2,"text":"Kreieren von Buchstaben mit konsistenter\n    Stammbreite, Serifen und Höhe."}],"scripts":[],"styles":[],"documentTree":[{"tag":"html","attributes":{},"children":["\n",{"tag":"head","attributes":{},"children":["\n",{"tag":"meta","attributes":{"http-equiv":"Content-Type","content":"text/html; charset=utf-8"},"children":[]},"\n",{"tag":"title","attributes":{},"children":["Konsistente Serifen und Stammbreiten"]},"\n",{"tag":"link","attributes":{"rel":"icon","href":"../../_static/fftype16.png"},"children":[]},"\n",{"tag":"link","attributes":{"rel":"stylesheet","type":"text/css","href":"FontForge.css"},"children":[]},"\n"]},"\n",{"tag":"body","attributes":{},"children":["\n",{"tag":"div","attributes":{"id":"in"},"children":["\n",{"tag":"h1","attributes":{"align":"center"},"children":["\n    Tutorial #3\n  "]},"\n",{"tag":"ul","attributes":{},"children":["\n",{"tag":"li","attributes":{},"children":["\n",{"tag":"a","attributes":{"href":"editexample.page.json#FontCreate","hrefOriginal":"editexample.html#FontCreate"},"children":["Kreieren eines neuen Schriftsatzes"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"tag":"a","attributes":{"href":"editexample.page.json#CharCreate","hrefOriginal":"editexample.html#CharCreate"},"children":["Erzeugung eines Bildzeichens (Umrissverfolgung)"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"tag":"a","attributes":{"href":"editexample2.page.json#Navigating","hrefOriginal":"editexample2.html#Navigating"},"children":["Navigation zu weiteren Bildzeichen"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"tag":"a","attributes":{"href":"editexample2.page.json#Creating-o","hrefOriginal":"editexample2.html#Creating-o"},"children":["Auf zum nächsten Bildzeichen (konsistente\n      Richtungen)"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"tag":"a","attributes":{"href":"editexample3.page.json#consistent-stems","hrefOriginal":"editexample3.html#consistent-stems"},"children":["Konsistente Serifen und Stammbreiten"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"tag":"a","attributes":{"href":"editexample4.page.json#accents","hrefOriginal":"editexample4.html#accents"},"children":["Erzeugung akzentuierter Bildzeichen"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"tag":"a","attributes":{"href":"editexample4.page.json#ligature","hrefOriginal":"editexample4.html#ligature"},"children":["Erzeugung einer Ligatur"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"tag":"a","attributes":{"href":"editexample5.page.json#metrics","hrefOriginal":"editexample5.html#metrics"},"children":["Untersuchung von Metriken"]},"\n",{"tag":"ul","attributes":{},"children":["\n",{"tag":"li","attributes":{},"children":["\n",{"tag":"a","attributes":{"href":"editexample5.page.json#baseline","hrefOriginal":"editexample5.html#baseline"},"children":["Setzen der Gundlinie zur Grundlinienteilung eines Schriftsatzes"]},"\n"]}]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"tag":"a","attributes":{"href":"editexample5.page.json#Kerning","hrefOriginal":"editexample5.html#Kerning"},"children":["Unterschneidung"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"tag":"a","attributes":{"href":"editexample6.page.json#Variants","hrefOriginal":"editexample6.html#Variants"},"children":["Bildzeichenvarianten"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"tag":"a","attributes":{"href":"editexample6.page.json#Marks","hrefOriginal":"editexample6.html#Marks"},"children":["Ankermarkierungen"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"tag":"a","attributes":{"href":"editexample6-5.page.json#Conditional","hrefOriginal":"editexample6-5.html#Conditional"},"children":["Bedingte Eigenschaften"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"tag":"a","attributes":{"href":"editexample7.page.json#checking","hrefOriginal":"editexample7.html#checking"},"children":["Überprüfen des Schriftsatzes"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"tag":"a","attributes":{"href":"editexample7.page.json#Bitmaps","hrefOriginal":"editexample7.html#Bitmaps"},"children":["Bitmaps"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"tag":"a","attributes":{"href":"editexample7.page.json#generating","hrefOriginal":"editexample7.html#generating"},"children":["Erzeugung"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"tag":"a","attributes":{"href":"editexample7.page.json#Families","hrefOriginal":"editexample7.html#Families"},"children":["Schriftsatzfamilien"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"tag":"a","attributes":{"href":"editexample7.page.json#summary","hrefOriginal":"editexample7.html#summary"},"children":["Fazit"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"tag":"a","attributes":{"href":"scriptnotes.page.json#Special","hrefOriginal":"scriptnotes.html#Special"},"children":["Bemerkungen zu verschiedenen Skripten"]},"\n"]}]},"\n",{"tag":"h2","attributes":{},"children":["\n",{"tag":"a","attributes":{"name":"consistent-stems"},"children":["Kreieren "]}," von Buchstaben mit konsistenter\n    Stammbreite, Serifen und Höhe.\n  "]},"\n",{"tag":"p","attributes":{},"children":["\n    Viele lateinische (griechische, kyrillische) Schriftarten haben\n    ",{"tag":"b","attributes":{},"children":["Serifen"]},", das sind spezielle Begrenzer am Ende von Stämmen, und\n    fast alle LGC Schriftarten verwenden lediglich eine geringe Anzahl\n    von Stammbreiten (z.B. sollten die vertikalen Stämme von \"l\" und \"i\"\n    normalerweise die gleiche Breite haben).\n  "]},"\n",{"tag":"p","attributes":{},"children":["\n    In FontForge gibt es leider keine einfache Möglichkeit, Konsistenz\n    zu erzwingen, es gibt aber einige Befehle, die dabei helfen,\n    diese zu überprüfen und Diskrepanzen zu entdecken.\n  "]},"\n",{"tag":"p","attributes":{},"children":["\n    In diesem Tutorial wird zunächst der Buchstabe \"l\" mit Hilfe der\n    bereits beschriebenen Methode erstellt, eine Bildvorlage zu importieren\n    und mit deren Hilfe dessen Umriss zu definieren.\n    "]},{"tag":"table","attributes":{"border":"1","cellpadding":"2","width":"600"},"children":["\n",{"tag":"tbody","attributes":{},"children":["\n",{"tag":"tr","attributes":{"valign":"bottom"},"children":["\n",{"tag":"td","attributes":{"width":"140"},"children":["\n",{"tag":"p","attributes":{"align":"center"},"children":["\n",{"tag":"img","attributes":{"src":"../../_images/l1.png","height":"153","width":"35"},"children":[]}]},"\n"]},"\n",{"tag":"td","attributes":{"width":"140"},"children":["\n",{"tag":"img","attributes":{"src":"../../_images/l2.png","height":"101","width":"134"},"children":[]},"\n"]},"\n",{"tag":"td","attributes":{"width":"140"},"children":["\n",{"tag":"img","attributes":{"src":"../../_images/l3.png","height":"101","width":"134"},"children":[]},"\n"]},"\n",{"tag":"td","attributes":{"width":"140"},"children":["\n",{"tag":"img","attributes":{"src":"../../_images/l4.png","height":"101","width":"134"},"children":[]},"\n"]},"\n"]},"\n",{"tag":"tr","attributes":{"valign":"top"},"children":["\n",{"tag":"td","attributes":{},"children":["Die importierte Vorlage"]},"\n",{"tag":"td","attributes":{},"children":["\n          Mit Hilfe des Vergrößerungswerkzeugs wird der untere Serif\n          betrachtet, er ist links und rechts symmetrisch.\n        "]},"\n",{"tag":"td","attributes":{},"children":["Um die rechte Hälfte des Serifen wird ein Umriss gelegt."]},"\n",{"tag":"td","attributes":{},"children":["\n          Der Umriss wird selektiert, mit Hilfe von \n          ",{"tag":"code","attributes":{},"children":["Bearbeiten -> Kopieren"]}," und\n          ",{"tag":"code","attributes":{},"children":["Bearbeiten -> Einfügen"]}," ein Duplikat erstellt.\n          Dieses wird mit ",{"tag":"code","attributes":{},"children":["Element -> Transformieren"]},"\n\t        and der Auswahl von ",{"tag":"code","attributes":{},"children":["Spiegeln"]},"\n          (aus der Auswahlliste) bei aktivierter ",{"tag":"code","attributes":{},"children":["Horizontal"]},"-\n          Option gespiegelt.\n        "]},"\n"]},"\n",{"tag":"tr","attributes":{"valign":"bottom"},"children":["\n",{"tag":"td","attributes":{},"children":[{"tag":"img","attributes":{"src":"../../_images/l5.png","height":"101","width":"134"},"children":[]}]},"\n",{"tag":"td","attributes":{},"children":[{"tag":"img","attributes":{"src":"../../_images/l6.png","height":"101","width":"134"},"children":[]}]},"\n",{"tag":"td","attributes":{},"children":[{"tag":"img","attributes":{"src":"../../_images/l7.png","height":"101","width":"134"},"children":[]}]},"\n",{"tag":"td","attributes":{},"children":[{"tag":"p","attributes":{"align":"center"},"children":["\n",{"tag":"img","attributes":{"src":"../../_images/l8.png","height":"153","width":"35"},"children":[]}]},"\n"]},"\n"]},"\n",{"tag":"tr","attributes":{"valign":"top"},"children":["\n",{"tag":"td","attributes":{},"children":["\n        Der gespiegelte Serif wird nach links gezogen bis er auf der\n        linken Kante der Vorlage liegt.\n\t    "]},"\n",{"tag":"td","attributes":{"colspan":"2"},"children":["\n        Der Pfad wird deselektiert, einer der unteren Endpunkte eines\n        Serifen ausgewählt und auf den gegenüberliegenden Endpunkt\n        des anderen Serifen bewegt.\n\t    "]},"\n",{"tag":"td","attributes":{},"children":["Der Rest der Zeichens wird nun gezeichnet."]},"\n"]},"\n",{"tag":"tr","attributes":{"valign":"bottom"},"children":["\n",{"tag":"td","attributes":{},"children":[]},"\n",{"tag":"td","attributes":{},"children":[{"tag":"img","attributes":{"src":"../../_images/l9.png","height":"101","width":"134"},"children":[]}]},"\n",{"tag":"td","attributes":{},"children":[{"tag":"img","attributes":{"src":"../../_images/l10.png","height":"101","width":"134"},"children":[]}]},"\n",{"tag":"td","attributes":{},"children":[]},"\n"]},"\n",{"tag":"tr","attributes":{"valign":"top"},"children":["\n",{"tag":"td","attributes":{},"children":["\n        Zum Schluss werden noch zwei Schritte durchgeführt: die Messung der\n        Stammbreite und die Markierung der Höhe des \"l\".\n      "]},"\n",{"tag":"td","attributes":{},"children":["\n        Aus der Werkzeugleiste wird des Linealwerkzeug ausgewählt und\n        mit der Maus von einer Kante des Stamms zur anderen gezogen.\n        Aus diese Aktion hin erscheint ein kleines Fenster, dass in\n        diesem Beispiel eine Breite von 58 Einheiten anzeigt, die Richtung\n        beträgt 180°, es wurde -58 Einheiten horizontal und 0 Einheiten\n        vertikal gezogen.\n      "]},"\n",{"tag":"td","attributes":{},"children":["\n        In der Layerpalette wird nun die \"Führung\" Option ausgewählt\n        (welche den Führungs-Layer editierbar macht). Dann wird an\n        der Oberseite des \"l\" eine Linie gezogen, welche danach in allen\n        Zeichen des Schriftsatzes sichtbar ist und dessen Anstieg\n        markiert.\n      "]},"\n",{"tag":"td","attributes":{},"children":[]},"\n"]},"\n"]}]},"\n",{"tag":"p","attributes":{},"children":["\n    In diesem Beispiel wird ein \"i\" erstellt. Dieses Zeichen ähnelt einem\n    kurzen \"l\" mit einem Punkt am oberen Ende, so dass der Umriss des\n    vorherigen Beispiels wiederverwendet werden kann. Hierzu wird der\n    Umriss des \"l\" in das Bearbeitungsfenster des \"i\" kopiert, es werden\n    automatisch die richtigen Stammbreiten und die Zeichenbreite gesetzt.\n    Das Kopieren kann entweder aus der Zeichensatzansicht (durch Selektion\n    des Rechtecks mit dem \"l\" und Auswahl des Befehls\n    ",{"tag":"code","attributes":{},"children":["Bearbeiten->Kopieren"]},") oder aus der Umrissansicht\n    (mit Hilfe von ",{"tag":"code","attributes":{},"children":["Bearbeiten->Auswahl->Alles auswählen"]},"\n    und ",{"tag":"code","attributes":{},"children":["Bearbeiten->Kopieren"]},") durchgeführt werden.\n    Analog kann das Einfügen entweder in der Schriftsatzansicht (durch\n    Selektion des \"i\" Feldes und Auswahl des Befehls\n    ",{"tag":"code","attributes":{},"children":["Bearbeiten->Einfügen"]},") oder in der Umrissansicht (\n    durch Öffnen des Bildzeichens \"i\" und Ausführung des Befehls\n    ",{"tag":"code","attributes":{},"children":["Bearbeiten->Einfügen"]},").\n  "]},{"tag":"table","attributes":{"border":"1","cellpadding":"2","width":"600"},"children":["\n",{"tag":"tbody","attributes":{},"children":[{"tag":"tr","attributes":{},"children":["\n",{"tag":"td","attributes":{},"children":[{"tag":"p","attributes":{"align":"center"},"children":["\n",{"tag":"img","attributes":{"src":"../../_images/i1.png","height":"170","width":"50"},"children":[]}]}]},"\n",{"tag":"td","attributes":{},"children":[{"tag":"p","attributes":{"align":"center"},"children":["\n",{"tag":"img","attributes":{"src":"../../_images/i2.png","height":"170","width":"111"},"children":[]}]}]},"\n",{"tag":"td","attributes":{},"children":[{"tag":"p","attributes":{"align":"center"},"children":["\n",{"tag":"img","attributes":{"src":"../../_images/i3.png","height":"170","width":"111"},"children":[]}]}]},"\n",{"tag":"td","attributes":{},"children":[{"tag":"p","attributes":{"align":"center"},"children":["\n",{"tag":"img","attributes":{"src":"../../_images/i4.png","height":"170","width":"111"},"children":[]}]}]},"\n"]},"\n",{"tag":"tr","attributes":{"valign":"top"},"children":["\n",{"tag":"td","attributes":{},"children":["\n        Importieren der Bildvorlage für \"i\" und Kopieren des\n        Umrisses für \"l\"."]},"\n",{"tag":"td","attributes":{},"children":["\n        Auswahl der Punkte des oberen Serifen für \"l\".\n      "]},"\n",{"tag":"td","attributes":{},"children":["\n        Die Auswahl wird nach unten gezogen, so daß sie\n        der Vorlage entspricht.\n      "]},"\n",{"tag":"td","attributes":{},"children":["\n        Der Führungs-Layer wird selektiert und eine Linie auf der\n        x-Höhe gezogen.\n      "]},"\n"]},"\n"]}]},"\n",{"tag":"p","attributes":{},"children":["\n",{"tag":"img","attributes":{"src":"../../_images/o5.png","align":"right","height":"101","width":"85"},"children":[]},"\n    Bei einem Blick auf das in einem der vorherigen Schritte erstellte \"o\"\n    fällt auf, daß das Zeichen ein wenig über die Führungslinie für die\n    x-Höhe und ein wenig unter die Grundlinie ragt. Dieses Merkmal wird ",{"tag":"b","attributes":{},"children":["Überschuss"]},"\n    genannt und wird verwendet, um eine optische Illusion zu erzeugen. \n    Eine Kurve sollte etwa 3% über die x-Höhe hinausgehen, damit es so\n    erscheint, als ob sie auf der x-Höhe liegen würde.",{"tag":"br","attributes":{"clear":"all"},"children":[]},"\n"]},"\n",{"tag":"p","attributes":{},"children":["\n    Nun wird ein \"k\" erstellt. Hier wird wiederum erst eine entsprechende\n    Bildvorlage importiert und der Umriss eines \"l\" als Grundumriss\n    kopiert.\n  "]},{"tag":"table","attributes":{"border":"1","cellpadding":"2","width":"600"},"children":["\n",{"tag":"tbody","attributes":{},"children":[{"tag":"tr","attributes":{},"children":["\n",{"tag":"td","attributes":{},"children":[{"tag":"p","attributes":{"align":"center"},"children":["\n",{"tag":"img","attributes":{"src":"../../_images/k1.png","height":"151","width":"87"},"children":[]}]}]},"\n",{"tag":"td","attributes":{},"children":[{"tag":"p","attributes":{"align":"center"},"children":["\n",{"tag":"img","attributes":{"src":"../../_images/k2.png","height":"151","width":"87"},"children":[]}]}]},"\n",{"tag":"td","attributes":{},"children":[{"tag":"p","attributes":{"align":"center"},"children":["\n",{"tag":"img","attributes":{"src":"../../_images/k3.png","height":"151","width":"87"},"children":[]}]}]},"\n"]},"\n",{"tag":"tr","attributes":{"valign":"top"},"children":["\n",{"tag":"td","attributes":{},"children":["\n        Die Bildvorlage für \"k\" wird importiert und das Zeichen \"l\"\n        kopiert. Hier liegt die Linie für die x-Höhe (hoffentlich) genau\n        an der oberen Kante des \"k\". Die Breite des \"l\" entspricht nicht\n        der des \"k\", sie muss also angepasst werden, indem sie ausgewählt\n        und an die passende Position und auf die richtige Breite gezogen wird.\n\t    "]},"\n",{"tag":"td","attributes":{},"children":["\n        Aus der Werkzeugpalette wird nun das Messerwerkzeug ausgewählt und\n        der Stamm der \"l\" Umrisses an den geeigneten Punkten für das\n        \"k\" zerteilt (s. Bild).\n\t    "]},"\n",{"tag":"td","attributes":{},"children":["\n        Die Segmente zwischen den Schnittpunkten werden entfernt.\n        Ein einfacher Weg, dies zu tun ist, die Segmente zu selektieren\n        (welches implizit auch deren Endpunkte selektiert) und den\n        Befehl ",{"tag":"code","attributes":{},"children":["Bearbeiten -> Leeren"]}," auszuführen.\n      "]},"\n"]},"\n",{"tag":"tr","attributes":{},"children":["\n",{"tag":"td","attributes":{},"children":[{"tag":"p","attributes":{"align":"center"},"children":["\n",{"tag":"img","attributes":{"src":"../../_images/k4.png","height":"151","width":"87"},"children":[]}]}]},"\n",{"tag":"td","attributes":{},"children":[{"tag":"p","attributes":{"align":"center"},"children":["\n",{"tag":"img","attributes":{"src":"../../_images/k5.png","height":"151","width":"87"},"children":[]}]}]},"\n",{"tag":"td","attributes":{},"children":[{"tag":"p","attributes":{"align":"center"},"children":["\n",{"tag":"img","attributes":{"src":"../../_images/k6.png","height":"151","width":"87"},"children":[]}]}]},"\n"]},"\n",{"tag":"tr","attributes":{"valign":"top"},"children":["\n",{"tag":"td","attributes":{},"children":["\n        Die Endpunkte werden ausgewählt und mit Hilfe von\n        ",{"tag":"code","attributes":{},"children":["Punkt -> Eckpunkt"]}," in Eckpunkte umgewandelt.\n      "]},"\n",{"tag":"td","attributes":{},"children":["Die äußere Kontur wird ergänzt."]},"\n",{"tag":"td","attributes":{},"children":["\n        Die innere Kontur wird gezeichnet. Zum Abschluss \n        ",{"tag":"code","attributes":{},"children":["Bearbeiten -> Auswahl -> Alles auswählen"]}," und\n        ",{"tag":"code","attributes":{},"children":["Element -> Richtung korrigieren"]}," ausführen.\n      "]},"\n"]},"\n"]}]},"\n",{"tag":"p","attributes":{},"children":["\n"]},{"tag":"p","attributes":{"align":"center"},"children":["\n  -- ",{"tag":"a","attributes":{"href":"editexample2.page.json","hrefOriginal":"editexample2.html"},"children":["Vorherige Seite"]}," -- ",{"tag":"a","attributes":{"href":"../../index.page.json","hrefOriginal":"../../index.html"},"children":["Inhalt"]},"\n  -- ",{"tag":"a","attributes":{"href":"editexample4.page.json","hrefOriginal":"editexample4.html"},"children":["Nächste Seite"]}," --\n"]}]},"\n"]}]},"\n"]}