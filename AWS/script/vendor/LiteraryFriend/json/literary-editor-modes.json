{
  "modes": {
    "continuity": {
      "responsibility": "Objective and semi-objective contradictions",
      "outputs": [
        "conflicting facts",
        "impossible states",
        "unsupported changes",
        "evidence pairs"
      ]
    },
    "plot": {
      "responsibility": "Causality, threads, setups, payoffs, escalation",
      "outputs": [
        "dropped arcs",
        "missing prerequisites",
        "unresolved promises",
        "weak causal links"
      ]
    },
    "character": {
      "responsibility": "Goals, motivations, knowledge, relationships, arcs",
      "outputs": [
        "motivation gaps",
        "arc drift",
        "characterization inconsistency",
        "relationship changes"
      ]
    },
    "world": {
      "responsibility": "Lore, rules, geography, terminology",
      "outputs": [
        "rule violations",
        "location mismatches",
        "lore conflicts",
        "naming inconsistencies"
      ]
    },
    "timeline": {
      "responsibility": "Dates, durations, ages, travel, simultaneity",
      "outputs": [
        "impossible chronology",
        "timing conflicts",
        "age errors",
        "travel feasibility"
      ]
    },
    "developmental": {
      "responsibility": "Structure, pacing, stakes, tension, climax, theme",
      "outputs": [
        "higher-level editorial suggestions"
      ]
    },
    "line": {
      "responsibility": "Clarity, repetition, rhythm, awkwardness",
      "outputs": [
        "sentence and paragraph revision suggestions"
      ]
    },
    "copy": {
      "responsibility": "Grammar, spelling, punctuation, usage",
      "outputs": [
        "mechanical corrections",
        "consistency checks"
      ]
    },
    "pov": {
      "responsibility": "Perspective boundaries and knowledge availability",
      "outputs": [
        "head-hopping",
        "POV leaks",
        "perspective drift"
      ]
    },
    "series": {
      "responsibility": "Cross-book and cross-project canon",
      "outputs": [
        "book contradictions",
        "intentional retcons",
        "unresolved series promises"
      ]
    },
    "causality": {
      "responsibility": "Focused cause/prerequisite/consequence analysis",
      "outputs": [
        "missing causal bridges",
        "unsupported outcomes"
      ]
    },
    "setup-payoff": {
      "responsibility": "Focused setup, promise, clue and payoff analysis",
      "outputs": [
        "unseeded payoffs",
        "unresolved setups"
      ]
    },
    "knowledge": {
      "responsibility": "Focused character/reader knowledge analysis",
      "outputs": [
        "premature knowledge",
        "reveal-order conflicts"
      ]
    }
  },
  "scopeOptions": [
    "scene",
    "chapter",
    "project",
    "series"
  ],
  "structuredContext": true,
  "evidenceBacked": true,
  "canonMutationAutomatic": false
}
