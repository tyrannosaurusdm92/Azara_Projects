{
  "appName": "LiteraryFriend",
  "version": "2026.08.08-v1",
  "backendConfigPath": "backend/backend-links.json",
  "defaultRoute": "project-hub",
  "loginRoute": "sign-in",
  "autosaveSeconds": 15,
  "projectIsolation": true,
  "serviceWorker": true,
  "supportedImports": [
    "docx",
    "pdf",
    "txt",
    "json",
    "md",
    "rtf",
    "html",
    "png",
    "jpg",
    "jpeg",
    "webp",
    "gif",
    "svg",
    "csv"
  ],
  "localStoragePrefix": "literaryfriend.v1",
  "sessionStorageKey": "literaryfriend.session.token"
}
