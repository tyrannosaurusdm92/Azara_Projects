{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lexicon Entry",
  "type": "object",
  "required": [
    "languageId",
    "lemma"
  ],
  "properties": {
    "languageId": {
      "type": "string"
    },
    "lemma": {
      "type": "string"
    },
    "partOfSpeech": {
      "type": "string"
    },
    "definition": {
      "type": "string"
    },
    "forms": {
      "type": "array"
    },
    "etymology": {
      "type": "string"
    },
    "tags": {
      "type": "array"
    }
  }
}
