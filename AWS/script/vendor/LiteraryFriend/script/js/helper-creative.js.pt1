/* Writer Tools — prose/dialogue attribution helpers. */
(function(global){'use strict';
const TAG_VERBS='said|asked|replied|answered|whispered|shouted|murmured|cried|added|continued|muttered|exclaimed|called|yelled|laughed|sighed|began|growled|responded|declared|teased|promised|warned';
function normalizeSpeaker(raw){let s=String(raw||'').trim().replace(/^the\s+/i,'').replace(/[.,!?:;"'“”]+$/g,'').trim();if(!s)return 'Narrator';if(/^i$/i.test(s))return 'Writer';return s.split(/\s+/).map(w=>w.charAt(0).toUpperCase()+w.slice(1).toLowerCase()).join(' ');}
function attributionName(before,after){const V=TAG_VERBS;const tests=[new RegExp(`^[\\s,]*(?:${V})\\s+(?:the\\s+)?([A-Za-z][A-Za-z'-]*)`,'i'),new RegExp(`^[\\s,]*(?:the\\s+)?([A-Za-z][A-Za-z'-]*)\\s+(?:${V})`,'i'),new RegExp(`(?:the\\s+)?([A-Za-z][A-Za-z'-]*)\\s+(?:${V})\\s*[,:]?\\s*$`,'i'),new RegExp(`(?:${V})\\s+(?:the\\s+)?([A-Za-z][A-Za-z'-]*)\\s*[,:]?\\s*$`,'i')];for(const re of tests){const m=(re===tests[0]||re===tests[1]?after:before).match(re);if(m)return m[1];}return null;}
function parseScript(text){const out=[];const src=String(text||'').replace(/\r\n/g,'\n').trim();if(!src)return out;const paras=src.split(/\n\s*\n/).flatMap(p=>p.split(/\n/)).map(s=>s.trim()).filter(Boolean);for(const para of paras){const sp=para.match(/^([A-Za-z][A-Za-z0-9 ._'-]{0,30}):\s+(.+)$/);if(sp&&!/^https?$/i.test(sp[1].trim())){out.push({speaker:normalizeSpeaker(sp[1]),text:sp[2].trim()});continue;}const quoteRe=/["“„]([^"“”„]+)["”]/g;let last=0,m,found=false;while((m=quoteRe.exec(para))!==null){found=true;const before=para.slice(last,m.index),after=para.slice(quoteRe.lastIndex),quote=(m[1]||'').trim();if(before.trim())out.push({speaker:'Narrator',text:before.trim()});const name=attributionName(before,after);if(quote)out.push({speaker:name?normalizeSpeaker(name):'Narrator',text:quote});last=quoteRe.lastIndex;}if(!found)out.push({speaker:'Narrator',text:para});else if(para.slice(last).trim())out.push({speaker:'Narrator',text:para.slice(last).trim()});}return out;}
global.WriterToolsDialogueParser=Object.freeze({normalizeSpeaker,parseScript});
})(typeof globalThis!=='undefined'?globalThis:window);

