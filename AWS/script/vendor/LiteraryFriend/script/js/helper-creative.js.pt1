const consonances=(w,o={})=>keyedWords(w,'coda',codaFromPhones,o.limit||80);
function trigrams(w){const p='^'+cleanWord(w)+'$',s=new Set();for(let i=0;i<p.length-2;i++)s.add(p.slice(i,i+3));return [...s];}
async function spellingCandidates(word,limit=24){const idx=await loadPack('trigram'),target=cleanWord(word),score=new Map();for(const g of trigrams(target))for(const w of idx[g]||[])score.set(w,(score.get(w)||0)+1);return [...score].sort((a,b)=>b[1]-a[1]||Math.abs(a[0].length-target.length)-Math.abs(b[0].length-target.length)||a[0].localeCompare(b[0])).filter(x=>x[0]!==target).slice(0,limit).map(x=>x[0]);}
async function wordsForMeter(pattern,limit=100){const idx=await loadPack('meter');return (idx[String(pattern||'').replace(/2/g,'1')]||[]).slice(0,limit);}
async function wordsForCadence(pattern,limit=100){const idx=await loadPack('cadence');return (idx[String(pattern||'').replace(/2/g,'1').slice(-3)]||[]).slice(0,limit);}
async function prefixWords(prefix,limit=100){const p=cleanWord(prefix),idx=await loadPack('prefix'+Math.min(6,Math.max(2,p.length)));return (idx[p.slice(0,Math.min(6,Math.max(2,p.length)))]||[]).slice(0,limit);}
async function suffixWords(suffix,limit=100){const p=cleanWord(suffix),n=Math.min(6,Math.max(2,p.length)),idx=await loadPack('suffix'+n);return (idx[p.slice(-n)]||[]).slice(0,limit);}
function packInfo(){return {packs:Object.keys(PACKS),meta:META,loaded:[...cache.keys()]};}
const base=global.StoryTools?.WriterReference||{};global.StoryTools=global.StoryTools||{};global.StoryTools.WriterReference=Object.freeze({...base,offlineLexicon:Object.freeze({loadPack,packInfo,pronunciations,syllables,stress,rhymes,alliterations,assonances,consonances,spellingCandidates,wordsForMeter,wordsForCadence,prefixWords,suffixWords})});
