const cache=new Map();
function cleanWord(v){return String(v||'').toLowerCase().replace(/[^a-z'-]/g,'');}
async function inflate(parts){const b64=Array.isArray(parts)?parts.join(''):String(parts||'');const bin=global.atob?global.atob(b64):Buffer.from(b64,'base64').toString('binary');const bytes=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)bytes[i]=bin.charCodeAt(i);if(typeof global.DecompressionStream==='function'){const stream=new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'));return JSON.parse(await new Response(stream).text());}if(global.pako?.ungzip)return JSON.parse(global.pako.ungzip(bytes,{to:'string'}));throw new Error('Writer Tools offline packs require DecompressionStream (modern browser) or global pako.');}
async function loadPack(name){if(cache.has(name))return cache.get(name);if(!PACKS[name])throw new Error(`Unknown lexical pack: ${name}`);const p=inflate(PACKS[name]);cache.set(name,p);try{return await p;}catch(e){cache.delete(name);throw e;}}
function basePhones(entry){return String(Array.isArray(entry)?entry[0]:entry||'').trim().split(/\s+/).filter(Boolean);}
function rhymeKeyFromPhones(phones){let idx=-1;for(let i=0;i<phones.length;i++)if(/[12]$/.test(phones[i]))idx=i;if(idx<0)for(let i=0;i<phones.length;i++)if(/[012]$/.test(phones[i]))idx=i;return idx<0?'':phones.slice(idx).map(x=>x.replace(/[012]$/,'')).join(' ');}
function nearKeyFromPhones(phones){let idx=-1,v='';for(let i=0;i<phones.length;i++)if(/[012]$/.test(phones[i])){idx=i;v=phones[i].replace(/[012]$/,'');}return idx<0?'':v+'|'+phones.slice(idx+1).map(x=>x.replace(/[012]$/,'')).join('').slice(-4);}
function onsetFromPhones(phones){const out=[];for(const p of phones){if(/[012]$/.test(p))break;out.push(p);}return out.join(' ')||(phones[0]||'').replace(/[012]$/,'');}
function assonanceFromPhones(phones){return phones.filter(x=>/[012]$/.test(x)).map(x=>x.replace(/[012]$/,'')).join('-');}
function codaFromPhones(phones){let last=-1;for(let i=0;i<phones.length;i++)if(/[012]$/.test(phones[i]))last=i;return phones.slice(last+1).join(' ');}
async function pronunciations(word){const p=await loadPack('pronunciations');return p[cleanWord(word)]||[];}
async function syllables(word){const rows=await pronunciations(word);if(rows.length)return basePhones(rows[0]).filter(x=>/[012]$/.test(x)).length;const s=cleanWord(word).replace(/(?:e|es|ed)$/,'').match(/[aeiouy]+/g);return Math.max(1,s?.length||0);}
async function stress(word){const rows=await pronunciations(word);return rows.length?basePhones(rows[0]).filter(x=>/[012]$/.test(x)).map(x=>x.slice(-1)).join(''):'';}
async function keyedWords(word,indexName,keyer,limit=80){const [p,index]=await Promise.all([loadPack('pronunciations'),loadPack(indexName)]);const row=p[cleanWord(word)]?.[0];if(!row)return[];const key=keyer(basePhones(row));return (index[key]||[]).filter(x=>x!==cleanWord(word)).slice(0,limit);}
const rhymes=(w,o={})=>keyedWords(w,o.near?'near_rhyme':'rhyme',o.near?nearKeyFromPhones:rhymeKeyFromPhones,o.limit||80);
const alliterations=(w,o={})=>keyedWords(w,'onset',onsetFromPhones,o.limit||80);
