/* Writer Tools — generic style-reference and prose-craft utilities. No personal corpus is embedded. */
(function(global){'use strict';
 const G=global; G.StoryTools=G.StoryTools||{};
 const clone=v=>v==null?v:JSON.parse(JSON.stringify(v));
 const DEFAULT_STYLE=Object.freeze({
   id:'writer-tools-default-style', label:'Adaptive Writer Style',
   priorities:['clear character motivation','specific sensory detail','distinct dialogue voices','cause-and-effect scene movement','continuity callbacks','earned emotional change'],
   prose_fingerprint:['concrete scene openings','action threaded through dialogue','varied sentence length','specific nouns and verbs','scene endings with consequence or choice'],
   avoid:['generic filler','POV drift','unearned reversals','repetitive emotional labels','copying reference wording']
 });
 const profile=Object.freeze({name:'Viewpoint Character',fictional_character:true,pov:'match-project',pronouns:null});
 function styleDNA(overrides={}){return {...clone(DEFAULT_STYLE),...clone(overrides||{})};}
 function buildViewpointProfile(overrides={}){return {fictional_character:true,name:'Viewpoint Character',pov:'first_person',...clone(overrides||{})};}
 function buildBridgeInfluencePacket(opts={}){return {schema:'writer.reference.packet.v1',query:String(opts.query||''),scene_goal:String(opts.sceneGoal||''),theme:String(opts.theme||''),dynamic:String(opts.dynamic||''),character:String(opts.character||''),style_dna:styleDNA(opts.styleOverrides),instructions:['Use references for high-level craft only.','Do not copy source phrases or passages.','Preserve the current project voice and continuity.']};}
 function buildWriterReferencePrompt(opts={}){const p=buildBridgeInfluencePacket(opts);return ['WRITER STYLE REFERENCE','Use the project style as a craft guide, not as text to imitate verbatim.',`Scene goal: ${p.scene_goal||'continue the current scene'}`,`Priorities: ${p.style_dna.priorities.join('; ')}`,`Avoid: ${p.style_dna.avoid.join('; ')}`].join('\n');}
 function buildWriterReference(opts={}){return buildBridgeInfluencePacket(opts);}
 G.StoryTools.WriterReference=Object.freeze({profile,DEFAULT_STYLE,styleDNA,buildViewpointProfile,buildFictionalWriterProfile:buildViewpointProfile,buildBridgeInfluencePacket,buildWriterReferencePrompt,buildWriterReference});
})(typeof globalThis!=='undefined'?globalThis:window);


