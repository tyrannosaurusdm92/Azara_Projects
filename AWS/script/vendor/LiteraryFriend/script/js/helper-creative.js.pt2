/* Writer Tools — dialogue-provider adapter. Uses the configured Writer Tools provider and carries project style-reference context. */
(function(global){'use strict';
function providers(){const fn=global.WRITER_TOOLS_BACKEND_PROVIDER;return typeof fn==='function'?[fn]:[];}
async function generate(context,options={}){
  const prompt=global.WriterToolsCharacterPrompt?.build?.(context,options)||JSON.stringify(context);
  const provider=providers()[0];if(!provider)throw new Error('Writer Tools generation provider is not connected.');
  const active=options.series||context?.series||{};
  const refOptions=global.WriterToolsCharacterPrompt?.referenceOptions?.(context,active,options.request||'continue dialogue')||{query:prompt,character:active.pairing||''};
  const influence=global.StoryTools?.WriterReference?.buildBridgeInfluencePacket?.(refOptions)||context?.writer_reference||null;
  return provider({prompt,context:{...(context||{}),writer_reference:influence},writerReferenceInfluence:influence,mode:'writer_dialogue'});
}
global.WriterToolsCharacterDialogue=Object.freeze({providers,generate});
})(typeof globalThis!=='undefined'?globalThis:window);

/* ===== Dialogue craft diagnostics ===== */
(function(global){'use strict';
const base=global.WriterToolsCharacterDialogue||{};
function parse(text){return global.StoryTools?.FictionWriter?.parseScript?.(text)||String(text||'').split(/\n/).filter(Boolean).map(x=>({speaker:'Unknown',text:x}));}
function fingerprint(rows){const text=rows.map(x=>x.text).join(' '),ws=text.match(/[A-Za-z]+(?:['’-][A-Za-z]+)*/g)||[],ss=text.split(/[.!?]+/).filter(Boolean);return {turns:rows.length,words:ws.length,avgTurnWords:ws.length/Math.max(1,rows.length),avgSentenceWords:ws.length/Math.max(1,ss.length),questions:(text.match(/\?/g)||[]).length,exclamations:(text.match(/!/g)||[]).length,contractions:(text.match(/\b\w+[’'](?:t|re|ve|ll|d|m|s)\b/gi)||[]).length,hedges:(text.match(/\b(?:maybe|perhaps|probably|I think|I guess|sort of|kind of)\b/gi)||[]).length};}
function analyzeDialogue(text){const rows=parse(text),by={};for(const r of rows){if(r.speaker==='Narrator')continue;(by[r.speaker]??=[]).push(r);}const voices=Object.fromEntries(Object.entries(by).map(([k,v])=>[k,fingerprint(v)])),issues=[];for(const [speaker,v] of Object.entries(by))for(const row of v)if(/\b(?:as you know|as we both know|you remember that)\b/i.test(row.text))issues.push({code:'POSSIBLE_AS_YOU_KNOW',speaker,severity:'note',text:row.text});const names=Object.keys(voices);for(let i=0;i<names.length;i++)for(let j=i+1;j<names.length;j++){const a=voices[names[i]],b=voices[names[j]],delta=Math.abs(a.avgTurnWords-b.avgTurnWords)+Math.abs(a.questions-b.questions);if(delta<1.25&&a.words>40&&b.words>40)issues.push({code:'SIMILAR_VOICE_FINGERPRINT',speakers:[names[i],names[j]],severity:'note'});}return {turns:rows.length,speakers:names,voices,issues,craftChecks:['Does each speaker want something in this exchange?','Does information arrive because someone needs, resists, hides, tests, or changes something?','Can some lines carry subtext rather than stating the emotional point directly?','Do action beats preserve setting and power shifts without over-tagging speech?']};}
global.WriterToolsCharacterDialogue=Object.freeze({...base,parse,analyzeDialogue});
})(typeof globalThis!=='undefined'?globalThis:window);

/* ===== Dual-path dialogue generation: Onyx AI-brain + William-voice fallback ===== */
(function(global){'use strict';
const base=global.WriterToolsCharacterDialogue;if(!base)return;
async function generate(context={},options={}){const prompt=global.WriterToolsCharacterPrompt?.build?.(context,options)||JSON.stringify(context),provider=base.providers?.()[0];const active=options.series||context?.series||{},refOptions=global.WriterToolsCharacterPrompt?.referenceOptions?.(context,active,options.request||'continue dialogue')||{query:prompt,character:active.pairing||''},influence=global.StoryTools?.WriterReference?.buildBridgeInfluencePacket?.(refOptions)||context?.writer_reference||null,voice=global.WriterWilliamVoice?.contractForBackend?.({kind:'dialogue',prompt:options.request||prompt,characters:context.characters||context.character_library?.profiles})||null;
 if(provider){try{const result=await provider({prompt:[voice?.voicePrompt,prompt].filter(Boolean).join('\n\n'),context:{...(context||{}),writer_reference:influence,william_voice:voice?.voicePacket||null},writerReferenceInfluence:influence,voiceContract:voice,mode:'writer_dialogue'});const text=String(result?.content||result?.text||result?.chapter?.content||'');return text?{...result,williamVoiceAudit:global.WriterWilliamVoice?.audit?.(text,{kind:'dialogue'})||null}:result;}catch(error){console.warn?.('Writer dialogue provider unavailable; using William-voice local fallback.',error);}}
 const content=global.WriterWilliamVoice?.fallbackDialogue?.(context,{...options,request:options.request||'continue dialogue'})||global.WriterFallbackBrain?.generate?.({kind:'dialogue',prompt:options.request||''},context)?.content||'';return{ok:true,source:'writer-static-fallback',mode:'writer_dialogue',content,williamVoiceAudit:global.WriterWilliamVoice?.audit?.(content,{kind:'dialogue'})||null};}
