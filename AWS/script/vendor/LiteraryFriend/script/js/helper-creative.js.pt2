/* Writer Tools — deterministic choice/branch builder. */
(function(global){'use strict';
 const templates=Object.freeze([
  {path_key:'investigate',label:'Investigate',description:'Follow the strongest unanswered clue.',effect:{curiosity:1,insight:1}},
  {path_key:'confront',label:'Confront it directly',description:'Ask the difficult question or force the conflict into the open.',effect:{honesty:1,resolve:1}},
  {path_key:'protect',label:'Protect what matters',description:'Prioritize a person, promise, or vulnerable objective over the easiest solution.',effect:{trust:1}},
  {path_key:'improvise',label:'Improvise',description:'Reject the expected options and create a third approach.',effect:{playfulness:1,momentum:1}},
  {path_key:'slow-down',label:'Slow down',description:'Gather more information before committing.',effect:{insight:1}},
  {path_key:'relationship',label:'Talk it through',description:'Let the relationship conflict or emotional thread take focus for a scene.',effect:{honesty:1,trust:1}},
  {path_key:'fade-to-black',label:'Fade to black',description:'Let the romantic moment become private off-page, then resume the story afterward.',effect:{trust:1},fade_to_black:true}
 ]);
 function hash(s){let h=2166136261;for(const ch of String(s||'')){h^=ch.charCodeAt(0);h=Math.imul(h,16777619)}return h>>>0;}
 function decorate(c,{seriesKey='story',chapterNumber=1,index=0,target='@generate'}={}){return {...c,id:`choice-${seriesKey}-${chapterNumber}-${c.path_key}-${index+1}`,target:c.fade_to_black?'@generate-fade':target,generation_hint:c.fade_to_black?'End the on-page romantic scene at the fade-to-black boundary and resume afterward without sexual detail.':c.description};}
 function makeChoices({seriesKey='story',chapterNumber=1,count=4,target='@generate',seed='',includeFadeToBlack=false}={}){count=Math.max(2,Math.min(5,Number(count)||4));let pool=templates.filter(x=>!x.fade_to_black);const start=hash(`${seriesKey}|${chapterNumber}|${seed}`)%pool.length;pool=[...pool.slice(start),...pool.slice(0,start)];const rows=pool.slice(0,includeFadeToBlack?Math.max(1,count-1):count).map((c,i)=>decorate(c,{seriesKey,chapterNumber,index:i,target}));if(includeFadeToBlack&&rows.length<count){const c=templates.find(x=>x.fade_to_black);rows.push(decorate(c,{seriesKey,chapterNumber,index:rows.length,target}));}return rows;}
