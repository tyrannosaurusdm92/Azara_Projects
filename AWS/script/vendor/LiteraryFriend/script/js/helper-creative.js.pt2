function creativeToolset(kind='book'){
  const common=['requirements','references','constraints','iterations','continuity','memory','plot_holes'];
  const map={book:['outline','characters','worldbuilding','chapters','editing','voice','publishing'],story:['premise','characters','beats','scenes','dialogue','continuity','revision'],writing:['canon','characters','voice','relationship_arcs','scenes','continuity','revision'],cyoa:['premise','state','choices','branches','convergence','continuity','memory'],poem:['form','imagery','voice','rhythm','revision']};
