function buildRevisionRequest(options={}){const req=base.buildRevisionRequest?.(options)||{};const audit=global.WriterWilliamVoice?.audit?.(options.text||'',{...options,kind:global.WriterWilliamVoice?.taskKind?.(options)});const rp=global.WriterWilliamVoice?.revisionPrompt?.(options.text||'',options)||'';return {...req,williamVoiceAudit:audit,williamVoicePrompt:rp,goal:[req.goal||options.goal||'', 'Preserve William Saville’s voice while explicitly correcting over-explanation, rushed transitions, weak dialogue differentiation, incomplete thought articulation, and form-specific weaknesses.'].filter(Boolean).join(' ')};}
function createWritingRequest(options={}){const req=base.createWritingRequest?.(options)||buildGenerationRequest(options);const vc=voiceContract(options);return {...req,williamVoice:vc?.voicePacket||req.williamVoice||null,williamVoicePrompt:vc?.voicePrompt||req.williamVoicePrompt||'',fallback:{...(req.fallback||{}),engine:'WriterFallbackBrain',sameVoiceContract:true}};}
function craftPlan(options={}){const core=base.craftPlan?.(options)||{};const kind=global.WriterWilliamVoice?.taskKind?.(options)||'story';return {...core,williamVoice:global.WriterWilliamVoice?.buildPacket?.({...options,kind,includeEvidence:false})||null,craftGovernor:{preserve:['emotional directness','concrete imagery','earnestness','clear stakes','deliberate repetition'],strengthen:['clarity','causal pacing','dialogue naturalism','transition completeness','lyric economy','hook strength','historical exposition readability'],avoid:['redundant emotional paraphrase','rushed scene turns','overpacked lyric lines','same-voice character dialogue','generic motivational filler']}};}
async function validateGeneratedChapter(result={},request={}){const prior=await (base.validateGeneratedChapter?.(result,request)||{ok:true,issues:[],result}),text=String(result.prose||result.text||result.content||result.chapter?.content||''),kind=global.WriterWilliamVoice?.taskKind?.(request)||'story',voiceAudit=global.WriterWilliamVoice?.audit?.(text,{kind,speakerProfiles:request.speakerProfiles||{}})||null,issues=[...(prior.issues||[]),...(voiceAudit?.issues||[])];return {...prior,ok:!issues.some(x=>x.severity==='error'||x.severity==='warning'),issues,williamVoiceAudit:voiceAudit,result};}
function generateLocalFallback(options={},context={}){return global.WriterFallbackBrain?.generate?.(options,context)||{ok:false,source:'writer-static-fallback',content:''};}
async function execute(options={},context={}){const request={...options,context:options.context||context};if(global.WriterToolsBackendBridge?.generateWithFallback)return global.WriterToolsBackendBridge.generateWithFallback(request);return generateLocalFallback(request,request.context||{});}
root.WriterGeneration=Object.freeze({...base,voiceContract,buildGenerationRequest,buildRevisionRequest,createWritingRequest,craftPlan,validateGeneratedChapter,generateLocalFallback,execute});
})(typeof globalThis!=='undefined'?globalThis:window);

/* ===== END SOURCE: writer-generation.js ===== */

/* ===== BEGIN SOURCE: writer-fallback-brain.js | sha256:4da0646637dc1e9994c2e19a82fac43308ebf50294145ad740c5f41b43fd0aee ===== */
/* Writer Helper — static fallback writing brain.
 * Used when Onyx's remote AI-brain is unavailable. It intentionally shares the
 * same William voice/craft contract as the primary provider path.
 */
(function(global){'use strict';
const VERSION='2.1.0';
const arr=v=>Array.isArray(v)?v:v==null?[]:[v];
function hash(s){let h=2166136261>>>0;for(const ch of String(s||'')){h^=ch.codePointAt(0);h=Math.imul(h,16777619)>>>0;}return h>>>0;}
function rng(seed){let x=hash(seed)||1;return()=>{x^=x<<13;x^=x>>>17;x^=x<<5;return(x>>>0)/4294967296;};}
function pick(r,a){return a[Math.floor(r()*a.length)%a.length];}
function words(s){return String(s||'').match(/[A-Za-z]+(?:['’\-][A-Za-z]+)*/g)||[];}
function keyTerms(text,limit=8){const stop=new Set('about after again because before being could every from have into just more only other should some than that their them then there these they this those through very were what when where which while with would your'.split(' ')),m=new Map;for(const w of words(text).map(x=>x.toLowerCase()))if(w.length>3&&!stop.has(w))m.set(w,(m.get(w)||0)+1);return[...m.entries()].sort((a,b)=>b[1]-a[1]).slice(0,limit).map(x=>x[0]);}
function imageFamily(seed){const r=rng(seed),sets=[['glass','reflection','sharp edge','light'],['storm','rain','wind','pressure'],['fire','ash','heat','smoke'],['wall','door','threshold','room'],['road','distance','footstep','turn'],['shadow','lamp','darkness','glow'],['breath','chest','voice','silence']];return pick(r,sets);}
function story(request={},context={}){const r=rng(`${request.prompt||''}|${context?.series?.key||''}|story`),terms=keyTerms(`${request.prompt||''} ${context?.scene_seed||''} ${context?.premise_override||''}`),img=imageFamily(String(terms.join(':'))),lead=context?.series?.pairing?.split?.('/')?.[0]?.trim?.()||'the other person';const p=[];p.push(`The first thing I noticed was ${img[3]} catching on an ordinary surface, making it look important for half a second. It was a small detail, but I needed something small enough to understand before I tried to understand everything else.`);if(terms.length)p.push(`The problem had already narrowed itself around ${terms.slice(0,3).join(', ')}. None of those things meant much alone. Together, they had started to change what the next choice would cost.`);p.push(`I tried to explain all of it at once, heard myself getting lost halfway through, and stopped. “No. That’s not what I mean.” The correction came out rougher than I wanted, but at least it was true. “The important part is what changes now.”`);p.push(`${lead} did not rescue me from the sentence. That helped more than reassurance would have. “Then tell me that part,” ${lead} said.`);p.push(`So I did. One fact. One fear. One thing I needed. Once the pieces had names, they stopped piling on top of each other. The feeling was still there, heavy as ${img[0]}, but it had edges now.`);p.push(`The answer did not solve the larger problem. It changed the shape of it. A choice that had looked impossible became specific: act now and accept the risk, wait and lose time, ask the question neither of us wanted to hear, or walk away from the version of the plan that had already failed.`);p.push(`Something in the room shifted—a sound, a door, the scrape of movement—and the story refused to stay inside our heads. We had to do something.`);p.push(`I moved first. Not because I was certain, but because certainty had stopped being the price of motion. ${img[1][0].toUpperCase()+img[1].slice(1)} could blur the distance, but it could not erase the next step.`);return global.WriterWilliamVoice?.lightPolish?.(p.join('\n\n'),{kind:'story'})||p.join('\n\n');}
function poetry(request={}){const subject=request.subject||request.topic||request.prompt||'what hurts and what survives',r=rng(`${subject}|poem`),img=imageFamily(subject),turn=pick(r,['But I am still here.','And still, I choose the door.','I refuse to call survival nothing.','I learned the dark has edges.']);const lines=[`I keep ${subject.replace(/[.!?]+$/,'')}`,`where I can feel it,`,`${img[0]} under my skin,`,`${img[1]} at the window.`,``,`I could explain it`, `until the words go dull,`,`until every reason`, `becomes another wall.`,``,`So I will say the part`, `that still has teeth:`,turn,``,`Not untouched.`,`Not unafraid.`,`Still mine.`];return lines.join('\n');}
function lyrics(request={}){const topic=request.subject||request.topic||request.prompt||'surviving what tried to break me',r=rng(`${topic}|lyrics`),img=imageFamily(topic),hook=pick(r,['I am still here','Say my name','I won’t disappear','Not built to shatter','Let the light in']);return [`[Verse 1]`,`I carried ${img[0]} in my chest,`,`Called the damage “doing my best,”`,`Every room knew how to close,`,`I learned the exits, learned the roads.`,``,`[Pre-Chorus]`,`I don’t need another reason,`,`I need air enough to choose.`,``,`[Chorus]`,hook,hook,`Through the ${img[1]}, through the fear,`,`I don’t have to make it pretty,`,`I just have to still be here.`,``,`[Verse 2]`,`I said too much, then swallowed more,`,`Left half my truth outside the door,`,`Now I’m learning how to speak`,`Without turning pain into a speech.`,``,`[Bridge]`,`If the old words fall flat,`,`Let them fall.`,`I can build one honest line`,`And mean it all.`,``,`[Final Chorus]`,hook,`Not the same as yesterday,`,`Through the ${img[2]}, through the ache,`,`I can leave some room for music`,`And still say what I need to say.`].join('\n');}
function languageHistory(request={},context={}){const result=request.result||context.result||context.language||request.language;if(result&&global.WriterWilliamVoice?.historyNarrative)return global.WriterWilliamVoice.historyNarrative(result);return `The language changes in layers rather than by a single rule. Sound shifts reshape familiar words first; grammar follows through reanalysis and analogy; contact adds borrowed vocabulary and competing prestige forms; spelling may keep older shapes after speech has already moved on. The result should be presented as a modeled history with clear cause-and-effect, not as an inevitable evolutionary ladder.`;}
function generate(request={},context={}){const kind=global.WriterWilliamVoice?.taskKind?.(request)||'story';let content;if(kind==='poetry')content=poetry(request);else if(kind==='lyrics')content=lyrics(request);else if(kind==='language_history')content=languageHistory(request,context);else if(kind==='dialogue')content=global.WriterWilliamVoice?.fallbackDialogue?.(context,{request:request.prompt||request.sceneGoal,speakers:request.speakers||context.characters})||story(request,context);else content=story(request,context);const beforeAudit=global.WriterWilliamVoice?.audit?.(content,{kind})||null;content=global.WriterWilliamVoice?.repairHeuristic?.(content,{kind,request,context})||content;content=global.WriterWilliamVoice?.lightPolish?.(content,{kind,request,context})||content;const audit=global.WriterWilliamVoice?.audit?.(content,{kind})||null;return{ok:true,source:'writer-static-fallback',engine:`writer-fallback-brain/${VERSION}`,kind,content,voiceContract:global.WriterWilliamVoice?.buildPacket?.(request)||null,craftCorrection:{applied:true,before:beforeAudit,after:audit},audit};}
global.WriterFallbackBrain=Object.freeze({VERSION,generate,story,poetry,lyrics,languageHistory});
})(typeof globalThis!=='undefined'?globalThis:window);

/* ===== END SOURCE: writer-fallback-brain.js ===== */

/* ===== BEGIN SOURCE: writer-scene-beats.js | sha256:c7f1166a06eb263b50ece9c0e3f7f33429f070f351da307dc349c92b58420e95 ===== */
/* Writer Tools — reusable scene-beat library. */
(function(global){'use strict';
 const BEATS=Object.freeze([
  {id:'ground-scene',tags:['opening','setting'],level:1,prompt:'Ground the scene in a concrete place, action, and immediate objective.'},
  {id:'character-pressure',tags:['character','conflict'],level:1,prompt:'Let a character want something specific that creates pressure on the scene.'},
  {id:'dialogue-turn',tags:['dialogue'],level:1,prompt:'Use dialogue to change what someone knows, wants, fears, or plans.'},
  {id:'callback',tags:['continuity'],level:1,prompt:'Reuse one earlier detail, promise, object, or line of thought with new meaning.'},
  {id:'complication',tags:['plot'],level:1,prompt:'Introduce a consequence or obstacle caused by prior choices.'},
  {id:'relationship-shift',tags:['relationship'],level:2,prompt:'Show a measurable relationship change through action or dialogue rather than a summary label.'},
  {id:'fade-boundary',tags:['romance','fade'],level:2,prompt:'If romance would become sexual, end the on-page moment with [Fade to black.] and resume later without sexual detail.'},
  {id:'aftermath',tags:['continuity','aftermath'],level:2,prompt:'After a time jump or fade, focus on emotion, conversation, practical consequences, and the next plot beat without recapping off-page sexual activity.'},
  {id:'decision-point',tags:['choice','ending'],level:1,prompt:'End on a consequence, revelation, commitment, danger, or meaningful decision.'}
 ]);
 function select({series={},chapter=null,choice=null}={}){const stage=Number(chapter?.chapter_number||1)>10?2:1;const text=[choice?.label,choice?.description,choice?.generation_hint].filter(Boolean).join(' ').toLowerCase();return BEATS.filter(b=>b.level<=stage||(b.id==='fade-boundary'&&/romance|kiss|private|fade|intimate/.test(text))).slice(0,8);}
 function prompt(opts={}){return select(opts).map(b=>`- ${b.prompt}`).join('\n');}
 global.WriterToolsSceneBeats=Object.freeze({BEATS,select,prompt});
})(typeof globalThis!=='undefined'?globalThis:window);


