{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LiteraryFriend Project",
  "type": "object",
  "required": [
    "title",
    "type"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string"
    },
    "parentProjectId": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "settings": {
      "type": "object"
    }
  }
}
