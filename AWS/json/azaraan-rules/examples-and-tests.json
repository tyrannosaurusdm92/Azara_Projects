{
  "notation": "The JSON cluster objects are symbolic, not real Aza'raan rendered font glyphs or Khmer Unicode sequences.",
  "examples": [
    {
      "id": "hello_2_hosts",
      "source": "Hello",
      "type": "English demonstration of Aza'raan compression, not a new Aza'raan dictionary translation",
      "expected_host_count": 2,
      "clusters": [
        {
          "base": "H",
          "base_accent": null,
          "subscripts": [
            {
              "base": "E",
              "accent": "e_eh",
              "position": "under",
              "ipa": "ɛ"
            }
          ],
          "pronunciation": "heh",
          "note": "H plus accented E carries he or heh sound"
        },
        {
          "base": "L",
          "base_accent": null,
          "gemination": true,
          "subscripts": [
            {
              "base": "O",
              "accent": "o_oh",
              "position": "under",
              "ipa": "oʊ"
            }
          ],
          "pronunciation": "llo",
          "note": "L length flag represents double L, O subscript gives oh"
        }
      ],
      "status": "structural demonstration"
    },
    {
      "id": "wiosamn",
      "source": "W'iosamn",
      "type": "Attested Uxrowoiye moon proper name",
      "target": "W'i can occupy one host cluster",
      "expected_host_count_first_unit": 1,
      "clusters": [
        {
          "base": "B",
          "base_accent": "b_w",
          "subscripts": [
            {
              "type": "glottal",
              "position": "pre",
              "ipa": "ʔ"
            },
            {
              "base": "I",
              "accent": "i_ee",
              "position": "under",
              "ipa": "iː"
            }
          ],
          "pronunciation_order": [
            "ʔ",
            "w",
            "iː"
          ],
          "surface_roman": "W'i"
        }
      ],
      "remaining_roman": "osamn",
      "status": "user specified, later syllabification of remainder not asserted"
    },
    {
      "id": "nzra",
      "source": "Nzra",
      "type": "epenthesis",
      "written": "Nzra",
      "trigger_pair": "Nz",
      "inserted_vowel_ipa": "ɪ",
      "expected_initial_ipa": "nɪz",
      "expected_initial_english": "Nihz",
      "status": "user specified"
    },
    {
