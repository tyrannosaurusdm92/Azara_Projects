    },
    {
      "id": "glottal_click",
      "type": "positional validation",
      "clusters": [
        {
          "base": "T",
          "base_accent": "t_t",
          "subscripts": [
            {
              "type": "glottal",
              "position": "pre"
            },
            {
              "type": "click",
              "position": "post"
            }
          ]
        }
      ],
      "expected_sound_order": [
        "ʔ",
        "t",
        "ǃ"
      ],
      "status": "constructed structural test, not a lexeme"
    }
  ],
