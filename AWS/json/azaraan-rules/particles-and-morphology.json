  "grammar_templates": [
    {
      "name": "unmarked_transitive",
      "pattern": "SUBJECT + TAM? + VERB + OBJECT + LOCATION? + EVIDENTIAL?",
      "roles": [
        "subject",
        "verb",
        "object"
      ],
      "notes": "SVO is the canonical ordinary order"
    },
    {
      "name": "marked_verb_initial",
      "pattern": "TAM? + VERB + SUBJ-PARTICLE + SUBJECT + OBJ-PARTICLE + OBJECT",
      "roles": [
        "verb",
        "subject",
        "object"
      ],
      "notes": "Māori-inspired predicate-initial order without discarding canonical SVO"
    },
    {
      "name": "focused_object",
      "pattern": "TOPIC + OBJECT + TAM? + SUBJECT + VERB",
      "roles": [
        "topic",
        "object",
        "subject",
        "verb"
      ],
      "notes": "Require explicit role particles for ambiguous clauses"
    },
    {
      "name": "negative",
      "pattern": "SUBJECT + TAM? + NEG + VERB + OBJECT",
      "roles": [
        "subject",
        "negation",
        "verb",
        "object"
      ]
    },
    {
      "name": "noun_phrase",
      "pattern": "DETERMINER? + NOUN + MODIFIER* + DEMONSTRATIVE?",
      "roles": [
        "noun",
        "modifier",
        "demonstrative"
      ]
    },
    {
      "name": "possessive_phrase",
