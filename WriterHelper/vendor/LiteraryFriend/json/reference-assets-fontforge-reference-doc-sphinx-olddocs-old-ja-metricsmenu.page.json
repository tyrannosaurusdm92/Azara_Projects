enter"},"children":["幅の中央に(",{"tag":"u","attributes":{},"children":["C"]},")"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"<A HREF=\"#Thirds\">Thirds in Width</A>"},"\n",{"tag":"a","attributes":{"href":"#Thirds"},"children":["両幅の空きを1:2に(",{"tag":"u","attributes":{},"children":["T"]},")"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"<A HREF=\"#Width\">Set Width...</A>"},"\n",{"tag":"a","attributes":{"href":"#Width"},"children":["幅を設定(",{"tag":"u","attributes":{},"children":["W"]},")..."]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"<A HREF=\"#LBearing\">Set LBearing...</A>"},"\n",{"tag":"a","attributes":{"href":"#LBearing"},"children":["左サイドベアリングを設定(",{"tag":"u","attributes":{},"children":["L"]},")..."]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"<A HREF=\"#RBearing\">Set RBearing...</A>"},"\n",{"tag":"a","attributes":{"href":"#RBearing"},"children":["右サイドベアリングを設定(",{"tag":"u","attributes":{},"children":["R"]},")..."]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"<A HREF=\"#Auto\">Auto Width...</A>"},"\n",{"tag":"a","attributes":{"href":"#Auto"},"children":["幅の自動設定(",{"tag":"u","attributes":{},"children":["A"]},")..."]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"<A HREF=\"#Kern\">Auto Kern...</A>"},"\n",{"tag":"a","attributes":{"href":"#Kern"},"children":["自動カーニング(",{"tag":"u","attributes":{},"children":["K"]},")..."]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"<A HREF=\"#KernByClasses\">Kern By Classes...</A>"},"\n",{"tag":"a","attributes":{"href":"#KernByClasses"},"children":["クラス毎のカーニング(",{"tag":"u","attributes":{},"children":["N"]},")..."]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"<A HREF=\"#Remove\">Remove All Kern Pairs</A>"},"\n",{"tag":"a","attributes":{"href":"#Remove"},"children":["カーニングをすべて削除(",{"tag":"u","attributes":{},"children":["P"]},")"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"<A HREF=\"#kernpair\">Kern Pair Closeup...</A>"},"\n",{"tag":"a","attributes":{"href":"#kernpair"},"children":["カーニングペアの詳細..."]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"<A HREF=\"metricsmenu.html#VKernByClasses\">VKern By Classes...</A>"},"\n",{"tag":"a","attributes":{"href":"metricsmenu.page.json#VKernByClasses","hrefOriginal":"metricsmenu.html#VKernByClasses"},"children":["クラス毎の縦書きカーニング..."]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"<A HREF=\"#VKernFromHKern\">VKern From HKern</A>"},"\n",{"tag":"a","attributes":{"href":"#VKernFromHKern"},"children":["横書きカーニングを縦書きに"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"<A HREF=\"metricsmenu.html#VRemove\">Remove All VKern Pairs</A>"},"\n",{"tag":"a","attributes":{"href":"metricsmenu.page.json#VRemove","hrefOriginal":"metricsmenu.html#VRemove"},"children":["縦書きカーニングをすべて削除"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"<A HREF=\"#vertical\">Set Vertical Advance...</A>"},"\n",{"tag":"a","attributes":{"href":"#vertical"},"children":["縦書き時のグリフ幅を設定(",{"tag":"u","attributes":{},"children":["V"]},")..."]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"<A HREF=\"#AnchorControl\">Anchor Control...</A>"},"\n",{"tag":"a","attributes":{"href":"#AnchorControl"},"children":["アンカーの制御(",{"tag":"u","attributes":{},"children":["A"]},")..."]},"\n"]}]},"\n",{"tag":"p","attributes":{},"children":["\n"]},{"tag":"dl","attributes":{},"children":["\n",{"tag":"dt","attributes":{},"children":["\n",{"comment":"<A NAME=\"Center\">Center</A> in Width"},"\n",{"tag":"a","attributes":{"name":"Center"},"children":["幅の中央に(",{"tag":"u","attributes":{},"children":["C"]},")"]},"\n"]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"In the Outline and Metrics Views this centers the current glyph (makes its\n    lbearing be the same as its rbearing) within the current width. "},"\n    アウトラインビューとメトリックビューでは、このコマンドは現在のグリフを現在のグリフ幅の中で中央に配置します (左サイドベアリングと右サイドベアリングを均等にします)。\n    ",{"tag":"p","attributes":{},"children":["\n",{"comment":"In the Font View the same thing is done for all selected glyphs."},"\n    フォントビューでは、同じことを選択中のすべてのグリフに対して行います。\n  "]}]},{"tag":"dt","attributes":{},"children":["\n",{"comment":"<A NAME=\"Thirds\">Thirds</A> in Width"},"\n",{"tag":"a","attributes":{"name":"Thirds"},"children":["両幅の空きを1:2に(",{"tag":"u","attributes":{},"children":["T"]},")"]},"\n"]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"This is very like Center in Width above... except that I happen to prefer\n    having a bit more white space after my glyphs than before them. So this command\n    makes the rbearing twice the lbearing (instead of making them be the same). "},"\n    これは上の ",{"tag":"code","attributes":{},"children":["幅の中央に(",{"tag":"u","attributes":{},"children":["C"]},")"]}," と非常によく似ています……私の好みではグリフの後ろのスペースを前のスペースより少し多めに取りたがることを除いては。そのため、このコマンドは右サイドベアリングを左サイドベアリングの 2 倍に (均等ではなく) 設定します。\n  "]},{"tag":"dt","attributes":{},"children":["\n",{"comment":"Set <A NAME=\"Width\">Width</A>..."},"\n",{"tag":"a","attributes":{"name":"Width"},"children":["幅を設定(",{"tag":"u","attributes":{},"children":["W"]},")..."]},"\n"]},{"tag":"dd","attributes":{},"children":["\n",{"tag":"img","attributes":{"src":"../../_images/setwidth.png","width":"290","height":"186"},"children":[]},{"tag":"br","attributes":{},"children":[]},"\n",{"comment":"The Set Width command allows you to change the width of the current glyph\n    (in the outline view) or all selected glyphs (in the font view). You may\n    either set the width to an absolute value, change the width by adding a constant\n    value to it, or multiply it by a scale factor. Normally the width will be\n    expressed in em-units, but in a bitmap only font the width will be expressed\n    as pixels in the current displayed font. "},"\n",{"tag":"code","attributes":{},"children":["幅を設定(",{"tag":"u","attributes":{},"children":["W"]},")"]}," コマンドを使うと、(アウトラインビュー内では) 現在のグリフの幅を、または (フォントビューでは) 選択中のすべてのグリフの幅を変更することができます。幅の絶対値を指定することもできますし、一定の値を加えるかある拡大率を掛けるかによって現在の値を変更することもできます。通常、幅は em ユニットで表されますが、ビットマップのみのフォントでは、幅は現在表示されているフォントにおけるピクセル数で表現されます。\n  "]},{"tag":"dt","attributes":{},"children":["\n",{"comment":"Set <A NAME=\"LBearing\">LBearing</A>..."},"\n",{"tag":"a","attributes":{"name":"LBearing"},"children":["左サイドベアリングを設定(",{"tag":"u","attributes":{},"children":["L"]},")..."]},"\n"]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"The Set LBearing command is similar to the Set Width command above, the dialog\n    is pretty much the same except that it applies to the left side bearing rather\n    than to the width."},"\n",{"tag":"code","attributes":{},"children":["左サイドベアリングを設定(",{"tag":"u","attributes":{},"children":["L"]},")"]}," コマンドは、上の ",{"tag":"code","attributes":{},"children":["幅を設定(",{"tag":"u","attributes":{},"children":["W"]},")"]}," コマンドに似ています。ダイアログは非常に良く似ていて、適用されるのが幅ではなくて左サイドベアリングである点だけが違います。\n  "]},{"tag":"dt","attributes":{},"children":["\n",{"comment":"Set <A NAME=\"RBearing\">RBearing</A>..."},"\n",{"tag":"a","attributes":{"name":"RBearing"},"children":["右サイドベアリングを設定(",{"tag":"u","attributes":{},"children":["R"]},")..."]},"\n"]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"The Set RBearing command is similar to the Set Width command above, the dialog\n    is pretty much the same except that it applies to the right side bearing\n    rather than to the width. "},"\n",{"tag":"code","attributes":{},"children":["右サイドベアリングを設定(",{"tag":"u","attributes":{},"children":["R"]},")"]}," コマンドは、上の ",{"tag":"code","attributes":{},"children":["幅を設定(",{"tag":"u","attributes":{},"children":["W"]},")"]}," コマンドに似ています。ダイアログは非常に良く似ていて、適用されるのが幅ではなくて右サイドベアリングである点だけが違います。\n  "]},{"tag":"dt","attributes":{},"children":["\n",{"comment":"<A NAME=\"Auto\">Auto</A> Width..."},"\n",{"tag":"a","attributes":{"name":"Auto"},"children":["幅の自動設定(",{"tag":"u","attributes":{},"children":["A"]},")..."]},"\n"]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"This command is only available in the font view.\n    <A HREF=\"autowidth.html#AutoWidth\">It attempts to guess reasonable values\n    for the widths</A> (more accurately the left and right bearings) of the specified\n    glyphs."},"\n    このコマンドはフォントビューでのみ使用可能です。",{"tag":"a","attributes":{"href":"autowidth.page.json#AutoWidth","hrefOriginal":"autowidth.html#AutoWidth"},"children":["このコマンドは、指定された各グリフの適切な送り幅 (より正確には左右のサイドベアリング) を推測しようと試みます"]},"。\n  "]},{"tag":"dt","attributes":{},"children":["\n",{"comment":"Auto <A NAME=\"Kern\">Kern</A>..."},"\n",{"tag":"a","attributes":{"name":"Kern"},"children":["自動カーニング(",{"tag":"u","attributes":{},"children":["K"]},")..."]},"\n"]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"This command is only available from the font view.\n    <A HREF=\"autowidth.html#AutoKern\">It attempts to guess reasonable kerning\n    values </A>between the specified glyphs."},"\n    このコマンドはフォントビューでのみ使用可能です。",{"tag":"a","attributes":{"href":"autowidth.page.json#AutoKern","hrefOriginal":"autowidth.html#AutoKern"},"children":["このコマンドは、指定されたグリフ同士の間の適切なカーニング値を推測しようと試みます。\n  ",{"tag":"dt","attributes":{},"children":["\n",{"comment":"<A NAME=\"KernByClasses\">Kern</A> By Classes..."},"\n",{"tag":"a","attributes":{"name":"KernByClasses"},"children":["クラス毎のカーニング(",{"tag":"u","attributes":{},"children":["N"]},")..."]},"\n"]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"This command is only available from the font and metrics views. It provides\n    the user with a <A HREF=\"metricsview.html#kernclass\">dialog</A> to manipulate\n    kerning classes."},"\n    このコマンドはフォントビューとメトリックビューでのみ使用可能です。このコマンドによって、カーニングクラスを操作する",{"tag":"a","attributes":{"href":"metricsview.page.json#kernclass","hrefOriginal":"metricsview.html#kernclass"},"children":["ダイアログ"]},"を呼び出すことができます。\n  "]},{"tag":"dt","attributes":{},"children":["\n",{"comment":"<A NAME=\"Remove\">Remove</A> All Kern Pairs"},"\n",{"tag":"a","attributes":{"name":"Remove"},"children":["カーニングをすべて削除(",{"tag":"u","attributes":{},"children":["P"]},")"]},"\n"]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"In the font view removes all kern pairs (and kern classes) in the font.<BR>\n    In the outline glyph view removes all kern pairs where the current glyph\n    is the left hand glyph.<BR>\n    Not present in the Metrics or Bitmap views."},"\n    フォントビューでは、フォント内のすべてのカーニングペア (とカーニングクラス) を削除します。アウトライングリフビューでは、現在のグリフを左側のグリフとして含むすべてのカーニングペアを削除します。",{"tag":"br","attributes":{},"children":[]},"\n    メトリックビューやビットマップビューではこの項目は表示されません。\n  "]},{"tag":"dt","attributes":{},"children":["\n",{"comment":"<A NAME=\"kernpair\">Kern Pair Closeup...</A>"},"\n",{"tag":"a","attributes":{"name":"kernpair"},"children":["カーニングペアの詳細..."]},"\n"]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"(Sorry about the name, I couldn't think of a better).\n    <A HREF=\"metricsview.html#kernpair\">Allows</A> you to get a look at kerning\n    between two glyphs at different point-sizes and to build a\n    \"<A HREF=\"metricsview.html#DeviceTable\">Device Table</A>\" (which allows small\n    corrections from the standard behavior at specified point sizes)<BR>\n    Not present in the Bitmap view. "},"\n    (解りにくい名前ですみません。“詳細”(Closeup) よりいい名前が思いつかなかったのです)。\n    異なるポイントサイズにおける 2 つのグリフ間のカーニングを",{"tag":"a","attributes":{"href":"metricsview.page.json#kernpair","hrefOriginal":"metricsview.html#kernpair"},"children":["見ることができ"]},"、“",{"tag":"a","attributes":{"href":"metricsview.page.json#DeviceTable","hrefOriginal":"metricsview.html#DeviceTable"},"children":["デバイステーブル"]},"”を構築することができます (このテーブルを用いると、指定されたポイントサイズにおいて標準とは少し異なるふるまいを指定することが可能です)",{"tag":"br","attributes":{},"children":[]},"\n    ビットマップビューには存在しません。\n  "]},{"tag":"dt","attributes":{},"children":["\n",{"comment":"<A NAME=\"VKernByClasses\">VKern</A> By Classes..."},"\n",{"tag":"a","attributes":{"name":"VKernByClasses"},"children":["クラス毎の縦書きカーニング..."]},"\n"]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"This command is only available from the font and metrics views. It provides\n    the user with a <A HREF=\"metricsview.html#kernclass\">dialog</A> to manipulate\n    vertical kerning classes. "},"\n    このコマンドはフォントビューとメトリックビューでのみ使用可能です。このコマンドによって、縦書き用のカーニングクラスを操作する",{"tag":"a","attributes":{"href":"metricsview.page.json#kernclass","hrefOriginal":"metricsview.html#kernclass"},"children":["ダイアログ"]},"を呼び出すことができます。\n  "]},{"tag":"dt","attributes":{},"children":["\n",{"comment":"<A NAME=\"VKernFromHKern\">VKern</A> From HKern"},"\n",{"tag":"a","attributes":{"name":"VKernFromHKern"},"children":["横書きカーニングを縦書きに"]},"\n"]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"This command is only available from the font and metrics views. It removes\n    all current vertical kerning information, then it looks through the font\n    and for each pair of horizontally kerned glyphs where both have a 'vert'\n    or 'vrt2' feature it produces a vertical kerning pair for the vertical versions\n    of those glyph. (That is: If <CODE>A</CODE>+<CODE>V</CODE> are horizontally\n    kerned by -50 and <CODE>A</CODE> =&gt; <CODE>A.vert</CODE> and <CODE>V</CODE>\n    =&gt; <CODE>V.vert </CODE>then this command will produce a vertical kerning\n    pair between <CODE>A.vert</CODE> + <CODE>V.vert</CODE> with a value of -50) "},"\n    このコマンドはフォントビューとメトリックビューでのみ使用可能です。このコマンドは、現在の縦書きカーニング情報を削除し、その後フォント全体を検索し、\n横書き用のカーニングを持つグリフの対で、両方のグリフが‘vert’または‘vrt2’機能を持っている物に対して、それらのグリフの縦書き版を作成します。(つまりこういうことです: ",{"tag":"code","attributes":{},"children":["A"]},"+",{"tag":"code","attributes":{},"children":["V"]}," が横書き時に -50 だけカーニングされ、",{"tag":"code","attributes":{},"children":["A"]}," ⇒ ",{"tag":"code","attributes":{},"children":["A.vert"]}," と ",{"tag":"code","attributes":{},"children":["V"]}," ⇒ ",{"tag":"code","attributes":{},"children":["V.vert"]}," が存在する時にこのコマンドを実行すると、",{"tag":"code","attributes":{},"children":["A.vert"]}," + ",{"tag":"code","attributes":{},"children":["V.vert"]}," の組み合せに、-50 のカーニング値が設定されます。)\n  "]},{"tag":"dt","attributes":{},"children":["\n",{"comment":"<A NAME=\"VRemove\">Remove</A> All VKern Pairs"},"\n",{"tag":"a","attributes":{"name":"VRemove"},"children":["縦書きカーニングをすべて削除"]},"\n"]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"In the font view removes all vertical kern pairs (and kern classes) in the\n    font.<BR>\n    In the outline glyph view removes all kern pairs where the current glyph\n    is the left hand glyph.<BR>\n    Not present in the Metrics or Bitmap views. "},"\n    フォントビューでは、フォント内の縦書きカーニングペア (とカーニングクラス) をすべて削除します。",{"tag":"br","attributes":{},"children":[]},"\n    アウトライングリフビューでは、現在のグリフが左側のグリフであるすべてのカーニングペアを削除します。",{"tag":"br","attributes":{},"children":[]},"\n    メトリックビューやビットマップビューには存在しません。\n  "]},{"tag":"dt","attributes":{},"children":["\n",{"comment":"Set <A NAME=\"vertical\">Vertical</A> Advance..."},"\n",{"tag":"a","attributes":{"name":"vertical"},"children":["縦書き時のグリフ幅を設定(",{"tag":"u","attributes":{},"children":["V"]},")..."]},"\n"]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"If vertical metrics are enabled for the font this will be active in the font\n    and outline character view.<BR>\n    It behaves exactly like Set Width... except it works on the vertical advance\n    rather than the horizontal advance (width). "},"\n    そのフォントで縦書きメトリックが使用可能なときは、フォントビューとアウトライングリフビューでこれがアクティブになっています。これは ",{"tag":"code","attributes":{},"children":["幅を設定(",{"tag":"u","attributes":{},"children":["W"]},")..."]}," と同じですが、横書き用の送り幅 (グリフの幅) ではなく縦書き用の送り幅を設定する点が異なります。\n  "]},{"tag":"dt","attributes":{},"children":["\n",{"comment":"<A NAME=\"AnchorControl\">Anchor Control...</A>"},"\n",{"tag":"a","attributes":{"name":"AnchorControl"},"children":["アンカーの制御(",{"tag":"u","attributes":{},"children":["A"]},")..."]},"\n"]},{"tag":"dd","attributes":{},"children":["\n",{"comment":"Only in the outline view. If you select an Anchor Point, this will bring\n    up a <A HREF=\"anchorcontrol.html\">dialog</A> showing the combinations obtained\n    with all other glyphs that can attach to that anchor point. You can position\n    the point in this view and even add a device table to it. "},"\n    アウトラインビューにしか存在しません。アンカーポイントを 1 個だけ選択している時には、このコマンドはそのアンカーポイントに接続可能なすべての他のグリフから得られた組み合わせを表示する",{"tag":"a","attributes":{"href":"anchorcontrol.page.json","hrefOriginal":"anchorcontrol.html"},"children":["ダイアログ"]},"を起動します。このビューで点の位置を指定することも、デバイステーブルを付け加えることもできます。\n "]}]}]}]},"\n",{"tag":"h2","attributes":{},"children":["\n",{"comment":" Other menus "},"\n     その他のメニュー\n"]},"\n",{"tag":"ul","attributes":{},"children":["\n",{"tag":"li","attributes":{},"children":["\n",{"comment":"<A HREF=\"filemenu.html\">File</A>"},"\n",{"tag":"a","attributes":{"href":"filemenu.page.json","hrefOriginal":"filemenu.html"},"children":["ファイル(",{"tag":"u","attributes":{},"children":["F"]},")"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"<A HREF=\"editmenu.html\">Edit</A>"},"\n",{"tag":"a","attributes":{"href":"editmenu.page.json","hrefOriginal":"editmenu.html"},"children":["編集(",{"tag":"u","attributes":{},"children":["E"]},")"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"<A HREF=\"pointmenu.html\">Point</A>"},"\n",{"tag":"a","attributes":{"href":"pointmenu.page.json","hrefOriginal":"pointmenu.html"},"children":["点(",{"tag":"u","attributes":{},"children":["P"]},")"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"<A HREF=\"elementmenu.html\">Element</A>"},"\n",{"tag":"a","attributes":{"href":"elementmenu.page.json","hrefOriginal":"elementmenu.html"},"children":["エレメント(",{"tag":"u","attributes":{},"children":["L"]},")"]},"\n"]},{"tag":"li","attributes":{},"children":["\n",{"comment":"<A HREF=\"hintsmenu.html\">Hints</A>"},"\n",{"tag":"a","attributes":{"href":"hintsmenu.page.json","hrefOriginal":"hintsmenu.html"},"children":["ヒント(",{"tag":"u","attributes":{},"children":["I"]},")"]},"\n"]},{"tag":"li","attributes":{},"children":[" ",{"tag":"a","attributes":{"href":