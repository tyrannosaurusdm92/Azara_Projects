{
  "source": "tools/immersive_studio_reference/life_generator.html",
  "viewHTML": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<title>the source world Living NPC + Location Generator</title>\n<link rel=\"stylesheet\" href=\"css/life_generator.css\" />\n</head>\n<body>\n<header> <h1>the source world Living NPC + Location Generator</h1> <p class=\"subtitle\">Merged settlement, province, and whole-world simulator for persistent locations, NPCs, relationships, schedules, weather, travel, GeoJSON/SVG pin shells, imports, editing, and export packages.</p> <div class=\"top-actions\"> <a href=\"source_world_studio.html\" class=\"secondary\" style=\"display:inline-block;text-decoration:none\">Studio Home</a> <a href=\"worldforge.html\" class=\"secondary\" style=\"display:inline-block;text-decoration:none\">WorldForge DM Studio</a> <a href=\"player_explorer.html\" class=\"secondary\" style=\"display:inline-block;text-decoration:none\">Player Explorer</a> <button id=\"generateBtn\" class=\"gold\">Generate / Refresh Current Scope</button> <button id=\"generateMissingBtn\" class=\"secondary\">Generate Missing Only</button> <button id=\"expandScopeBtn\" class=\"secondary\">Expand Existing</button> <button id=\"exportZipBtn\" class=\"secondary\">Export ZIP Package</button> <button id=\"saveBtn\" class=\"secondary\">Save Browser State</button> <button id=\"clearStateBtn\" class=\"warning\">Clear Browser State</button> </div>\n</header>\n<main class=\"layout\"> <aside class=\"sidebar card\"> <h2>World Controls</h2> <div class=\"panel form-grid\"> <section class=\"app-board\"> <h3>Application Mode Board</h3> <div id=\"appBackendStatus\" class=\"notice\">Checking Python + SQLite application layer...</div> <div class=\"btns\"> <button id=\"appRefreshBackendBtn\" class=\"secondary\" type=\"button\">Check App Connection</button> <button id=\"appSaveSqliteBtn\" class=\"gold\" type=\"button\">Save to SQLite</button> <button id=\"appLoadSqliteBtn\" class=\"secondary\" type=\"button\">Load Latest SQLite Save</button> <button id=\"appExportBundleBtn\" class=\"secondary\" type=\"button\">Export VTT/Game Bundle</button> <button id=\"appModeHelpBtn\" class=\"secondary\" type=\"button\">How This Works</button> </div> <div class=\"hint\">This board is made for code-novice use: keep choosing options here, then save/export. Running <code>python app.py</code> turns this page into a local app with durable SQLite storage and Foundry/Godot/Unity bridge exports.</div> </section> <section> <label for=\"fileInput\">Import JSON, GeoJSON, HTML, DOCX, PDF, or map image</label> <div id=\"dropzone\" class=\"dropzone\">Drop files here or choose files below. Parsed text and JSON will scan into the fill boxes and can restore or merge records.</div> <input id=\"fileInput\" type=\"file\" multiple accept=\".json,.geojson,.html,.htm,.docx,.pdf,image/*\" /> <div id=\"fileList\" class=\"file-list\"></div> </section> <section> <h3>Generation Scope</h3> <div class=\"row\"> <div><label for=\"scopeMode\">Scope</label><select id=\"scopeMode\"><option value=\"settlement\">One settlement</option><option value=\"province\">Whole province</option><option value=\"world\">Whole world</option></select></div> <div><label for=\"generationMode\">Mode</label><select id=\"generationMode\"><option value=\"generateSettlement\">Generate / Replace Scope</option><option value=\"missingOnly\">Generate Missing Locations</option><option value=\"expandSettlement\">Expand Existing Scope</option><option value=\"singleLocation\">Create One Location</option><option value=\"singleNPC\">Create One NPC</option></select></div> </div> <div class=\"row\"> <div id=\"provinceSelectWrap\"><label for=\"provinceSelect\">Province</label><select id=\"provinceSelect\"></select></div> <div id=\"settlementSelectWrap\"><label for=\"settlementSelect\">Settlement</label><select id=\"settlementSelect\"></select></div> </div> <div class=\"row\"> <div><label for=\"settlementType\">Settlement Type</label><select id=\"settlementType\"><option>Capital City</option><option>City</option><option>Town</option><option>Village</option></select></div> <div><label for=\"biomeSelect\">Biome</label><select id=\"biomeSelect\"></select></div> </div> <div class=\"row\"> <div><label for=\"locationCount\">Locations</label><input id=\"locationCount\" type=\"number\" min=\"1\" max=\"5000\" value=\"60\" /></div> <div><label for=\"npcCount\">Named NPCs</label><input id=\"npcCount\" type=\"number\" min=\"1\" max=\"15000\" value=\"160\" /></div> </div> <div class=\"row\"> <div><label for=\"populationInput\">Population</label><input id=\"populationInput\" type=\"number\" min=\"1\" value=\"1600\" /></div> <div><label for=\"areaInput\">Square mi / km²</label><input id=\"areaInput\" type=\"text\" placeholder=\"e.g. 18 sq mi\" /></div> </div> <div class=\"row\"> <div><label for=\"timezoneInput\">Time Zone</label><input id=\"timezoneInput\" type=\"text\" placeholder=\"UTC-4\" /></div> <div><label for=\"dangerLevel\">Danger Level</label><select id=\"dangerLevel\"><option>Low</option><option selected>Moderate</option><option>High</option><option>Severe</option><option>Mythic</option><option>Hidden / Political</option></select></div> </div> <label for=\"governmentType\">Government Type</label><input id=\"governmentType\" type=\"text\" placeholder=\"Participatory Democracy, Consensus, Noocracy...\" /> <label for=\"alignmentPreference\">Visitor Alignment Preference</label><select id=\"alignmentPreference\"></select> <label for=\"alignmentProfile\">Alignment Profile Dropdown</label><select id=\"alignmentProfile\"></select> <label for=\"primaryDeities\">Primary Deities</label><input id=\"primaryDeities\" type=\"text\" placeholder=\"Nebyrr, Sigrananna, Horundar...\" /> <label for=\"settlementTags\">Settlement Tags</label><textarea id=\"settlementTags\" placeholder=\"guild-heavy, coastal, rail hub, shrine city, dangerous docks...\"></textarea> </section> <section> <h3>Race Cache + Dropdowns</h3> <div class=\"row\"> <div><label for=\"raceMode\">Race Mode</label><select id=\"raceMode\"><option value=\"weighted\">the source world weighted mix</option><option value=\"category\">Selected category</option><option value=\"race\">Selected race</option><option value=\"allInCategory\">Generate all races in category</option><option value=\"cache\">Cached race pool</option></select></div> <div><label for=\"raceCategory\">Race Category</label><select id=\"raceCategory\"></select></div> </div> <label for=\"racePick\">Specific Race / Bloodline</label><select id=\"racePick\"></select> <div class=\"range-row\"><label for=\"raceBiasInput\">Mixed Population Bias</label><input id=\"raceBiasInput\" type=\"range\" min=\"0\" max=\"100\" value=\"60\" /><span id=\"raceBiasValue\">60</span></div> <div class=\"btns\"> <button id=\"btnAddRaceCache\" class=\"secondary\" type=\"button\">Add Selected Race To Cache</button> <button id=\"btnAddCategoryCache\" class=\"secondary\" type=\"button\">Add Category To Cache</button> <button id=\"btnClearRaceCache\" class=\"warning\" type=\"button\">Clear Race Cache</button> </div> <div id=\"raceCacheList\" class=\"race-cache-list notice\">No race cache yet. Add races here to build a reusable world-generation pool.</div> <div id=\"raceInfo\" class=\"notice\">Choose a race to preview its creator, habitat, and notes.</div> <div class=\"btns\"> <button id=\"btnAllCategory\" class=\"secondary\" type=\"button\">Generate All Races In Category</button> <button id=\"btnSelectedRace\" class=\"secondary\" type=\"button\">Generate Selected Race</button> <button id=\"btnMixedPopulation\" class=\"secondary\" type=\"button\">Generate Mixed Population</button> </div> </section> <section> <h3>Living-World Rules</h3> <div class=\"checkbox\"><input id=\"includeFivePercent\" type=\"checkbox\" checked /><span>Apply 5% rare variation to locations, NPCs, relationships, schedules, and daily events.</span></div> <div class=\"checkbox\"><input id=\"includeTravelers\" type=\"checkbox\" checked /><span>Create travelers, commuters, vacations, work trips, route crews, and cross-province visits.</span></div> <div class=\"checkbox\"><input id=\"includeGeojsonPins\" type=\"checkbox\" checked /><span>Auto-fill blank GeoJSON/SVG pin shells with 2px map pin data and anchors.</span></div> <div class=\"checkbox\"><input id=\"preserveExisting\" type=\"checkbox\" checked /><span>Preserve existing records unless a selected record is edited, imported over, or rerolled.</span></div> </section> <section> <h3>Creation + Exports</h3> <div class=\"btns\"> <button id=\"createLocationBtn\" class=\"secondary\" type=\"button\">Create Single Location</button> <button id=\"createNpcBtn\" class=\"secondary\" type=\"button\">Create Single NPC</button> <button id=\"exportJsonBtn\" class=\"secondary\" type=\"button\">Export JSON</button> <button id=\"exportGeoJsonBtn\" class=\"secondary\" type=\"button\">Export GeoJSON</button> <button id=\"exportHtmlBtn\" class=\"secondary\" type=\"button\">Export HTML</button> <button id=\"exportDocxBtn\" class=\"secondary\" type=\"button\">Export DOCX</button> </div> </section> <div id=\"controlMeta\" class=\"notice\">Ready. Generate a settlement, province, or world, or import existing files to restore data.</div> </div> </aside> <section class=\"card workspace-card\"> <h2>Generated Living World</h2> <nav class=\"tabs\"> <button class=\"tab active\" data-tab=\"overview\">Overview</button> <button class=\"tab\" data-tab=\"locations\">Locations</button> <button class=\"tab\" data-tab=\"npcs\">NPCs</button> <button class=\"tab\" data-tab=\"relationships\">Relationships</button> <button class=\"tab\" data-tab=\"travel\">Travel</button> <button class=\"tab\" data-tab=\"simulation\">Simulation</button> <button class=\"tab\" data-tab=\"map\">Map / GeoJSON</button> <button class=\"tab\" data-tab=\"imports\">Imports</button> <button class=\"tab\" data-tab=\"json\">JSON</button> </nav> <div class=\"panel\"> <div class=\"toolbar\"> <input id=\"filterInput\" class=\"search\" type=\"text\" placeholder=\"Filter visible generated data...\" /> <div id=\"resultCount\" class=\"mini\">Nothing generated yet.</div> </div> <div id=\"overview\" class=\"tabpane\"></div> <div id=\"locations\" class=\"tabpane hidden\"></div> <div id=\"npcs\" class=\"tabpane hidden\"></div> <div id=\"relationships\" class=\"tabpane hidden\"></div> <div id=\"travel\" class=\"tabpane hidden\"></div> <div id=\"simulation\" class=\"tabpane hidden\"> <div class=\"statline simulation-stats\"> <div class=\"stat\"><b id=\"statLocations\">0</b> locations</div> <div class=\"stat\"><b id=\"statNpcs\">0</b> NPCs</div> <div class=\"stat\"><b id=\"statTravelers\">0</b> active travelers</div> <div class=\"stat\"><b id=\"statRelationships\">0</b> relationships</div> </div> <div class=\"widegrid\"> <div class=\"item map-item\"> <h3>Video-Game Style Board</h3> <div class=\"map-shell\" id=\"mapShell\"> <div class=\"map-bg\" id=\"mapBg\"></div> <svg id=\"lifeMap\" viewBox=\"0 0 1000 540\" role=\"img\" aria-label=\"Generated location and NPC movement board\"></svg> <aside id=\"immersivePanel\" class=\"immersive-panel hidden\"></aside> </div> <div id=\"timeSummary\" class=\"notice\">Time and moon-weather summary will appear after generation.</div> </div> <div class=\"item\"> <h3>Travel, Weather + Daily Life</h3> <div class=\"row\"> <div><label for=\"weatherOverrideSelect\">Weather Override</label><select id=\"weatherOverrideSelect\"></select></div> <div><label for=\"seasonSelect\">Season</label><select id=\"seasonSelect\"><option>spring</option><option>summer</option><option>autumn</option><option>winter</option></select></div> </div> <div class=\"btns sim-actions\"> <button id=\"advanceHourBtn\" class=\"gold\" type=\"button\">Advance 1 Hour</button> <button id=\"runDailyEventsBtn\" class=\"secondary\" type=\"button\">Run Daily Events</button> <button id=\"applyWeatherBtn\" class=\"secondary\" type=\"button\">Apply Weather</button> <button id=\"forecastBtn\" class=\"secondary\" type=\"button\">Generate 7-Day Forecast</button> <button id=\"sendVisitorsBtn\" class=\"secondary\" type=\"button\">Send Visitors</button> <button id=\"returnHomeBtn\" class=\"secondary\" type=\"button\">Return Everyone Home</button> </div> <div id=\"travelBoard\" class=\"log-box\"></div> <h3>Event Log</h3> <div id=\"eventLog\" class=\"event-log\"></div> </div> </div> </div> <div id=\"map\" class=\"tabpane hidden\"></div> <div id=\"imports\" class=\"tabpane hidden\"></div> <pre id=\"json\" class=\"tabpane hidden item codebox\"></pre> </div> </section>\n</main>\n<div id=\"editorBackdrop\" class=\"modal-backdrop\"> <div class=\"modal\"> <header><h2 id=\"editorTitle\">Edit Record</h2><button id=\"editorClose\" class=\"secondary small\" type=\"button\">Close</button></header> <div class=\"panel form-grid\"> <div class=\"hint\">Edit the JSON directly. Saving changes only the selected record. No unrelated NPCs or locations reroll.</div> <textarea id=\"editorText\"></textarea> <div class=\"btns\"> <button id=\"editorSave\" class=\"gold\" type=\"button\">Save Record</button> <button id=\"editorReroll\" class=\"secondary\" type=\"button\">Reroll Selected Record</button> <button id=\"editorRerollName\" class=\"secondary\" type=\"button\">Reroll Name Only</button> <button id=\"editorRerollSchedule\" class=\"secondary\" type=\"button\">Reroll Schedule / Inventory</button> </div> </div> </div>\n</div>\n<div id=\"status\" class=\"status\"></div>\n<p class=\"footer-note\">Generated NPCs and locations stay in memory and browser storage until you clear, edit, import over, or reroll them. ZIP exports include HTML, JSON, GeoJSON, DOCX, schedules, relationships, travel, weather/events, CSS, JavaScript, and source data.</p>\n<script src=\"js/vendor/jszip.min.js\"></script>\n<script src=\"js/data/generator_rules.js\"></script>\n<script src=\"js/data/source_world_race_dropdown_data.js\"></script>\n<script src=\"js/data/settlement_assignments.js\"></script>\n<script src=\"js/data/source_world_time_model.js\"></script>\n<script src=\"js/data/source_world_location_catalog.js\"></script>\n<script src=\"js/data/source_world_alignment_profiles.js\"></script>\n<script src=\"js/data/source_world_reference_data.js\"></script>\n<script src=\"js/world_time.js\"></script>\n<script src=\"js/utils.js\"></script>\n<script src=\"js/importers.js\"></script>\n<script src=\"js/generator_core.js\"></script>\n<script src=\"js/renderers.js\"></script>\n<script src=\"js/exporters.js\"></script>\n<script src=\"js/life_generator_app.js\"></script>\n<script src=\"js/application_bridge.js\"></script>\n</body>\n</html>"
}