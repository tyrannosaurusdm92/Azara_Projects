{
  "source": "tools/immersive_studio_reference/player_explorer.html",
  "viewHTML": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>the source world Player Explorer</title>\n<link rel=\"stylesheet\" href=\"worldforge.css\">\n<style>.player-layout{display:grid;grid-template-columns:340px 1fr;gap:16px;padding:16px}.result{cursor:pointer}.hero2{background:radial-gradient(circle at top right,#00ffff18,transparent 42%),#08151b}.empty{padding:40px;text-align:center}.safe-banner{border:1px solid #a8ff6088;background:#a8ff6012}@media(max-width:900px){.player-layout{grid-template-columns:1fr}}</style>\n</head>\n<body>\n<header class=\"topbar\"><div><h1>the source world Player Explorer</h1><p>Player-safe access to public settlements, services, NPCs, travel, rumors, and places.</p></div><nav><a href=\"source_world_studio.html\">Studio Home</a><a href=\"worldforge.html\">DM Studio</a><button id=\"importBtn\" type=\"button\">Import Player/World JSON</button><input id=\"fileInput\" type=\"file\" accept=\".json,application/json\" hidden></nav></header>\n<main class=\"player-layout\">\n<aside class=\"panel\"><h2>Search the World</h2><p class=\"notice safe-banner\">This page strips common DM-only fields from display. Use exported player bundles for safest sharing.</p><label>Search</label><input id=\"q\" placeholder=\"inn, portal, apothecary, NPC name, province...\"><label>Province</label><select id=\"province\"><option value=\"\">All provinces</option></select><label>Settlement</label><select id=\"settlement\"><option value=\"\">All settlements</option></select><div class=\"grid2\"><button id=\"showTravel\" type=\"button\">Travel Board</button><button id=\"showRumors\" type=\"button\">Rumors</button></div><div id=\"stats\" class=\"notice\"></div></aside>\n<section class=\"panel\"><div id=\"output\" class=\"empty\">No saved player world found yet. Generate and save in WorldForge, or import a player-safe <code>world.json</code>.</div></section>\n</main>\n<script>\n(function(){\nconst STORAGE_KEY='source_world_worldforge';\nlet world={settlements:[]};\nconst $=id=>document.getElementById(id);\nconst e=v=>String(v??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nfunction scrub(s){const c=JSON.parse(JSON.stringify(s));delete c.dmSummary;delete c.botRaw;delete c.command;(c.locations||[]).forEach(l=>{delete l.intrigue;delete l.associatedNPCs});(c.npcs||[]).forEach(n=>{delete n.dmSecret;delete n.secret;if(Array.isArray(n.relationships))n.relationships=n.relationships.slice(0,3).map(r=>({npcName:r.npcName||r.name,type:r.type}))});return c}\nfunction load(){try{world=JSON.parse(localStorage.getItem(STORAGE_KEY)||'{\"settlements\":[]}')}catch{world={settlements:[]}};world.settlements=(world.settlements||[]).map(scrub);fillFilters();render()}\nfunction fillFilters(){const provinces=[...new Set(world.settlements.map(s=>s.provinceName).filter(Boolean))].sort();$('province').innerHTML='<option value=\"\">All provinces</option>'+provinces.map(p=>`<option>${e(p)}</option>`).join('');fillSettlements();stats()}\nfunction fillSettlements(){const p=$('province').value;const sets=world.settlements.filter(s=>!p||s.provinceName===p).map(s=>s.name).sort();$('settlement').innerHTML='<option value=\"\">All settlements</option>'+sets.map(s=>`<option>${e(s)}</option>`).join('')}\nfunction stats(){const locs=world.settlements.reduce((a,s)=>a+(s.locations||[]).length,0);const npcs=world.settlements.reduce((a,s)=>a+(s.npcs||[]).length,0);$('stats').innerHTML=`<b>${world.settlements.length}</b> settlements<br><b>${locs}</b> public locations<br><b>${npcs}</b> public NPC records`}\nfunction filtered(){const q=$('q').value.toLowerCase(),p=$('province').value,set=$('settlement').value;return world.settlements.filter(s=>(!p||s.provinceName===p)&&(!set||s.name===set)&&(!q||JSON.stringify(s).toLowerCase().includes(q)))}\nfunction render(mode){const list=filtered();if(!list.length){$('output').innerHTML='<div class=\"empty\">No matching public records.</div>';return}$('output').innerHTML=list.map(s=>settlementCard(s,mode)).join('')}\nfunction settlementCard(s,mode){const travel=(s.routes||[]).map(r=>`<article class=\"card\"><h3>${e(r.name)}</h3><p>${e(r.mode)} · ${e(r.frequency)}</p><p>${e(r.playerText||r.security||'')}</p></article>`).join('');const rumors=(s.locations||[]).filter(l=>l.plotHook).slice(0,80).map(l=>`<article class=\"card\"><h3>${e(l.name)}</h3><p>${e(l.plotHook)}</p></article>`).join('');const locs=(s.locations||[]).slice(0,80).map(l=>`<article class=\"card result\"><h3>${e(l.name)}</h3><p>${e(l.type||l.category)} · ${e(l.district||'')}</p><p>${e(l.description||'')}</p><p><b>Services:</b> ${e((l.services||[]).join(', '))}</p></article>`).join('');const npcs=(s.npcs||[]).slice(0,80).map(n=>`<article class=\"card result\"><h3>${e(n.name||n.fullName)}</h3><p>${e(n.race)} · ${e(n.genderIdentity||'')} · ${e(n.occupation||n.role||'')}</p><p>${e(n.publicBio||n.attitude||'')}</p></article>`).join('');return `<section class=\"card hero2\"><h2>${e(s.name)}</h2><p>${e(s.provinceName)} · ${e(s.type)} · ${e(s.biome)} · ${Number(s.population||0).toLocaleString()} people</p><p>${e(s.publicSummary||s.summary||'')}</p><p>${(s.transport||[]).map(t=>`<span class=\"pill\">${e(t)}</span>`).join('')}</p></section>${mode==='travel'?`<h2>Travel Board</h2><div class=\"gridcards\">${travel||'<p>No public travel records.</p>'}</div>`:mode==='rumors'?`<h2>Public Rumors</h2><div class=\"gridcards\">${rumors||'<p>No public rumors.</p>'}</div>`:`<h2>Places</h2><div class=\"gridcards\">${locs}</div><h2>NPCs</h2><div class=\"gridcards\">${npcs}</div>`}`}\n$('q').oninput=()=>render();$('province').onchange=()=>{fillSettlements();render()};$('settlement').onchange=()=>render();$('showTravel').onclick=()=>render('travel');$('showRumors').onclick=()=>render('rumors');$('importBtn').onclick=()=>$('fileInput').click();$('fileInput').onchange=async ev=>{const f=ev.target.files[0];if(!f)return;const j=JSON.parse(await f.text());world=j.kind&&Array.isArray(j.settlements)?j:j.world||{settlements:[]};world.settlements=(world.settlements||[]).map(scrub);fillFilters();render()};load();\n})();\n</script>\n</body>\n</html>"
}