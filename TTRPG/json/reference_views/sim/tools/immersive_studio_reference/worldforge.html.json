  "source": "tools/immersive_studio_reference/worldforge.html",
  "viewHTML": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>the source world WorldForge Immersive Studio</title>\n<link rel=\"stylesheet\" href=\"worldforge.css\">\n</head>\n<body>\n<header class=\"topbar\"> <div> <h1>the source world WorldForge Immersive Studio</h1> <p>Main DM creation board: tell the studio what you want, generate settlements/NPCs/locations, then export player-safe or full DM bundles.</p> </div> <nav> <a href=\"source_world_studio.html\">Studio Home</a> <a href=\"player_explorer.html\" target=\"_blank\">Player Explorer</a> <a href=\"life_generator.html\" target=\"_blank\">Life Simulator</a> <a href=\"rulebot/rulebot.html\" target=\"_blank\">RuleBot Standalone</a> <a href=\"globe.html#dm-editor\" target=\"_blank\">Globe DM Editor</a> <button id=\"exportZipBtn\" type=\"button\">Export DM ZIP</button> <button id=\"exportPlayerZipBtn\" type=\"button\">Export Player ZIP</button> </nav>\n</header>\n<main class=\"layout\"> <aside class=\"panel wizard\"> <h2>Creation Board</h2> <p class=\"hint\">Choose controls or write a command. The embedded RuleBot fills districts, NPCs, schedules, secrets, travel, player text, and GeoJSON-ready pins.</p> <section class=\"botbox\"> <h3>Studio Bot</h3> <label for=\"botCommand\">Tell the studio what you want</label> <textarea id=\"botCommand\" rows=\"5\" placeholder=\"Example: create a gloomy rail town in Kharvathen named Coalveil with vampire doctors, black-market ferry pilots, regulated portal checkpoint, population 4200\"></textarea> <div class=\"grid2\"> <button id=\"runBotBtn\" class=\"primary\" type=\"button\">Build From Text</button> <button id=\"helpBotBtn\" type=\"button\">Bot Help</button> </div> <div class=\"grid2\"> <button class=\"exampleBtn\" data-example=\"create a high danger deep mountain mining town in Kharvathen named Coalveil with train and regulated portal, population 4200\" type=\"button\">Example: Mine Town</button> <button class=\"exampleBtn\" data-example=\"create a fog coast occult nautical town in Thalryss named Lanternwake with ferry, steamship, smugglers, haunted docks, population 3600\" type=\"button\">Example: Haunted Port</button> </div> <div id=\"botStatus\" class=\"notice\">RuleBot is loading from <code>/rulebot</code>…</div> </section> <section> <h3>Structured Controls</h3> <label>Scale</label><select id=\"scope\"><option>Settlement</option><option>Province</option><option>Whole World</option></select> <label>Province</label><select id=\"provinceSelect\"></select> <label>Settlement name</label><input id=\"settlementName\" placeholder=\"e.g., Veyrwatch Hollow\"> <label>Settlement type</label><select id=\"settlementType\"><option value=\"capital\">Capital</option><option value=\"city\">City</option><option value=\"town\">Town</option><option value=\"village\">Village</option><option value=\"fortress\">Fortress</option><option value=\"port\">Port</option><option value=\"mining colony\">Mining Colony</option><option value=\"haunted ruin\">Haunted Ruin</option></select> <label>Biome</label><select id=\"biome\"><option>temperate rainforest</option><option>black pine forest</option><option>fog coast</option><option>deep mountain</option><option>swamp</option><option>desert</option><option>tundra</option><option>urban industrial</option><option>underdark-adjacent caverns</option></select> <label>Tone</label><select id=\"tone\"><option>Steampunk Dark Fantasy</option><option>Gothic Horror</option><option>Arcane Industrial</option><option>Haunted Fairy-Tale</option><option>Dieselpunk Warfront</option><option>Occult Nautical</option></select> <label>Danger level</label><select id=\"danger\"><option value=\"safe\">Safe but suspicious</option><option value=\"low\">Low</option><option value=\"moderate\" selected>Moderate</option><option value=\"high\">High</option><option value=\"severe\">Nightmare</option><option value=\"cursed\">Cursed</option></select> <label>Population</label><input id=\"population\" type=\"number\" min=\"20\" value=\"2400\"> <label>Primary travel</label><select id=\"travel\"><option value=\"caravan\">Caravan</option><option value=\"train\">Train</option><option value=\"ferry\">Ferry</option><option value=\"steamship\">Steamship</option><option value=\"skyship\">Skyship</option><option value=\"regulated portal\">Portal - regulated ATA pass required</option><option value=\"mixed hub\">Mixed hub</option></select> <label>Location count cap</label><input id=\"locationCount\" type=\"number\" min=\"5\" max=\"1600\" placeholder=\"Auto by settlement type\"> <label>NPC count cap</label><input id=\"npcCap\" type=\"number\" min=\"1\" max=\"1000\" value=\"180\"> <label>Seed</label><input id=\"seed\" placeholder=\"Optional repeatable seed\"> <label>Extra DM intent</label><textarea id=\"intent\" rows=\"5\" placeholder=\"Secrets, factions, player-facing mood, needed services, or specific NPC types.\"></textarea> <div class=\"grid2\"><button id=\"generateBtn\" class=\"primary\" type=\"button\">Generate / Reroll</button><button id=\"saveBtn\" type=\"button\">Save to World</button></div> <div class=\"grid2\"><button id=\"importBtn\" type=\"button\">Import JSON</button><button id=\"clearBtn\" class=\"bad\" type=\"button\">Clear Local Data</button></div> <input id=\"fileInput\" type=\"file\" accept=\".json,.geojson,application/json\"> </section> <section> <h3>DM Edit Current</h3> <p class=\"hint\">For exact manual control, edit the current settlement JSON and apply it. This keeps the easy board while still allowing full DM override.</p> <textarea id=\"editJson\" rows=\"7\" spellcheck=\"false\" placeholder=\"Generate or select a settlement, then edit JSON here.\"></textarea> <div class=\"grid2\"><button id=\"refreshEditBtn\" type=\"button\">Refresh JSON</button><button id=\"applyEditBtn\" type=\"button\">Apply Edited JSON</button></div> </section> </aside> <section class=\"panel output\"> <div class=\"tabs\"> <button data-tab=\"summary\" class=\"active\" type=\"button\">Summary</button> <button data-tab=\"playerView\" type=\"button\">Player View</button> <button data-tab=\"dmView\" type=\"button\">DM Secrets</button> <button data-tab=\"districts\" type=\"button\">Locations</button> <button data-tab=\"npcs\" type=\"button\">NPCs</button> <button data-tab=\"travelTab\" type=\"button\">Travel</button> <button data-tab=\"botLog\" type=\"button\">Bot Log</button> <button data-tab=\"geojson\" type=\"button\">GeoJSON</button> </div> <div id=\"summary\" class=\"tab active\"></div> <div id=\"playerView\" class=\"tab\"></div> <div id=\"dmView\" class=\"tab\"></div> <div id=\"districts\" class=\"tab\"></div> <div id=\"npcs\" class=\"tab\"></div> <div id=\"travelTab\" class=\"tab\"></div> <div id=\"botLog\" class=\"tab\"><div class=\"chat\"></div></div> <pre id=\"geojson\" class=\"tab code\"></pre> </section> <aside class=\"panel library\"> <h2>Saved World</h2> <input id=\"search\" placeholder=\"Search provinces, settlements, NPCs, services...\"> <div class=\"grid2 compact\"><button id=\"saveAsPlayerBtn\" type=\"button\">Open Player View</button><button id=\"downloadCurrentBtn\" type=\"button\">Current JSON</button></div> <div id=\"savedList\"></div> </aside>\n</main>\n<footer>Portals stay regulated by the Arcane Transportation Authority. Travel uses caravans, trains, ferries, steamships, skyships, and licensed portals—not cars or planes.</footer>\n<script src=\"js/vendor/jszip.min.js\"></script>\n<script src=\"rulebot/js/lore_seed.js\"></script>\n<script src=\"rulebot/js/rulebot_engine.js\"></script>\n<script src=\"worldforge_data.js\"></script>\n<script src=\"worldforge.js\"></script>\n</body>\n</html>"
}