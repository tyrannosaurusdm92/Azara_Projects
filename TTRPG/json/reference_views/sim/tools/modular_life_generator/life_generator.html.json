{
  "source": "tools/modular_life_generator/life_generator.html",
  "viewHTML": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<title>Life Simulator Life Generator</title>\n<link rel=\"stylesheet\" href=\"css/life_generator.css\" />\n</head>\n<body>\n<header>\n  <h1>Life Simulator Life Generator</h1>\n  <p class=\"subtitle\">All-in-one settlement, province, and world generator for living locations, NPCs, relationships, schedules, travel, map pins, GeoJSON shells, imports, and export packages.</p>\n  <div class=\"top-actions\">\n    <button id=\"generateBtn\" class=\"gold\">Generate / Refresh Current Scope</button>\n    <button id=\"exportZipBtn\" class=\"secondary\">Export ZIP Package</button>\n    <button id=\"saveBtn\" class=\"secondary\">Save Browser State</button>\n    <button id=\"clearStateBtn\" class=\"warning\">Clear Browser State</button>\n  </div>\n</header>\n<main class=\"layout\">\n  <aside class=\"sidebar card\">\n    <h2>Controls + Imports</h2>\n    <div class=\"panel form-grid\">\n      <section>\n        <label for=\"fileInput\">Import JSON, GeoJSON, HTML, DOCX, PDF, or map image</label>\n        <div id=\"dropzone\" class=\"dropzone\">Drop files here or choose files below. Parsed text and JSON will be scanned into the fill boxes.</div>\n        <input id=\"fileInput\" type=\"file\" multiple accept=\".json,.geojson,.html,.htm,.docx,.pdf,image/*\" />\n        <div id=\"fileList\" class=\"file-list\"></div>\n      </section>\n      <section>\n        <h3>Generation Scope</h3>\n        <div class=\"row\">\n          <div><label for=\"scopeMode\">Scope</label><select id=\"scopeMode\"><option value=\"settlement\">One settlement</option><option value=\"province\">Whole province</option><option value=\"world\">Whole world</option></select></div>\n          <div><label for=\"generationMode\">Mode</label><select id=\"generationMode\"><option value=\"generateSettlement\">Generate Settlement</option><option value=\"generateCategory\">Generate Category</option><option value=\"singleLocation\">Generate Single Location</option><option value=\"missingOnly\">Generate Missing Locations</option><option value=\"expandSettlement\">Expand Existing Settlement</option></select></div>\n        </div>\n        <div class=\"row\">\n          <div><label for=\"provinceSelect\">Province</label><select id=\"provinceSelect\"></select></div>\n          <div><label for=\"settlementSelect\">Settlement</label><select id=\"settlementSelect\"></select></div>\n        </div>\n        <div class=\"row\">\n          <div><label for=\"settlementType\">Settlement Type</label><select id=\"settlementType\"><option>Capital City</option><option>City</option><option>Town</option><option>Village</option></select></div>\n          <div><label for=\"biomeSelect\">Biome</label><select id=\"biomeSelect\"></select></div>\n        </div>\n        <div class=\"row\">\n          <div><label for=\"locationCount\">Locations</label><input id=\"locationCount\" type=\"number\" min=\"1\" max=\"5000\" value=\"60\" /></div>\n          <div><label for=\"npcCount\">Named NPCs</label><input id=\"npcCount\" type=\"number\" min=\"1\" max=\"15000\" value=\"160\" /></div>\n        </div>\n        <div class=\"row\">\n          <div><label for=\"populationInput\">Population</label><input id=\"populationInput\" type=\"number\" min=\"1\" value=\"1600\" /></div>\n          <div><label for=\"areaInput\">Square mi / km²</label><input id=\"areaInput\" type=\"text\" placeholder=\"e.g. 18 sq mi\" /></div>\n        </div>\n        <div class=\"row\">\n          <div><label for=\"timezoneInput\">Time Zone</label><input id=\"timezoneInput\" type=\"text\" placeholder=\"UTC-4\" /></div>\n          <div><label for=\"dangerLevel\">Danger Level</label><select id=\"dangerLevel\"><option>Low</option><option selected>Moderate</option><option>High</option><option>Severe</option><option>Hidden / Political</option></select></div>\n        </div>\n        <label for=\"governmentType\">Government Type</label><input id=\"governmentType\" type=\"text\" placeholder=\"Participatory Democracy, Consensus, Noocracy...\" />\n        <label for=\"alignmentPreference\">Visitor Alignment Preference</label><select id=\"alignmentPreference\"></select>\n        <label for=\"primaryDeities\">Primary Deities</label><input id=\"primaryDeities\" type=\"text\" placeholder=\"Nebyrr, Sigrananna, Horundar...\" />\n        <label for=\"settlementTags\">Settlement Tags</label><textarea id=\"settlementTags\" placeholder=\"guild-heavy, coastal, rail hub, shrine city, dangerous docks...\"></textarea>\n      </section>\n      <section>\n        <h3>Race + Alignment Dropdowns</h3>\n        <div class=\"row\">\n          <div><label for=\"raceMode\">Race Mode</label><select id=\"raceMode\"><option value=\"weighted\">Life Simulator weighted mix</option><option value=\"category\">Selected category</option><option value=\"race\">Selected race</option><option value=\"allInCategory\">Generate all races in category</option></select></div>\n          <div><label for=\"raceCategory\">Race Category</label><select id=\"raceCategory\"></select></div>\n        </div>\n        <label for=\"racePick\">Specific Race / Bloodline</label><select id=\"racePick\"></select>\n        <div class=\"btns\">\n          <button id=\"btnAllCategory\" class=\"secondary\" type=\"button\">Generate All Races In Category</button>\n          <button id=\"btnSelectedRace\" class=\"secondary\" type=\"button\">Generate Selected Race</button>\n          <button id=\"btnMixedPopulation\" class=\"secondary\" type=\"button\">Generate Mixed Population</button>\n        </div>\n      </section>\n      <section>\n        <h3>Living-World Rules</h3>\n        <div class=\"checkbox\"><input id=\"includeFivePercent\" type=\"checkbox\" checked /><span>Apply 5% rare variation to locations, NPCs, relationships, and schedules.</span></div>\n        <div class=\"checkbox\"><input id=\"includeTravelers\" type=\"checkbox\" checked /><span>Create travelers, commuters, vacations, work trips, and transit-worker routes for province/world scopes.</span></div>\n        <div class=\"checkbox\"><input id=\"includeGeojsonPins\" type=\"checkbox\" checked /><span>Auto-fill blank GeoJSON/SVG pin shells with 2px-style map pin data.</span></div>\n        <div class=\"checkbox\"><input id=\"preserveExisting\" type=\"checkbox\" checked /><span>Preserve existing generated records unless a selected record is rerolled or edited.</span></div>\n      </section>\n      <section>\n        <h3>Exports</h3>\n        <div class=\"btns\">\n          <button id=\"exportJsonBtn\" class=\"secondary\" type=\"button\">Export JSON</button>\n          <button id=\"exportGeoJsonBtn\" class=\"secondary\" type=\"button\">Export GeoJSON</button>\n          <button id=\"exportHtmlBtn\" class=\"secondary\" type=\"button\">Export HTML</button>\n          <button id=\"exportDocxBtn\" class=\"secondary\" type=\"button\">Export DOCX</button>\n        </div>\n      </section>\n      <div id=\"controlMeta\" class=\"notice\">Ready. Generate a settlement, province, or world, or import existing files to restore data.</div>\n    </div>\n  </aside>\n  <section class=\"card\">\n    <h2>Generated World Data</h2>\n    <nav class=\"tabs\">\n      <button class=\"tab active\" data-tab=\"overview\">Overview</button>\n      <button class=\"tab\" data-tab=\"locations\">Locations</button>\n      <button class=\"tab\" data-tab=\"npcs\">NPCs</button>\n      <button class=\"tab\" data-tab=\"relationships\">Relationships</button>\n      <button class=\"tab\" data-tab=\"travel\">Travel</button>\n      <button class=\"tab\" data-tab=\"map\">Map / GeoJSON</button>\n      <button class=\"tab\" data-tab=\"imports\">Imports</button>\n      <button class=\"tab\" data-tab=\"json\">JSON</button>\n    </nav>\n    <div class=\"panel\">\n      <div class=\"toolbar\">\n        <input id=\"filterInput\" class=\"search\" type=\"text\" placeholder=\"Filter visible generated data...\" />\n        <div id=\"resultCount\" class=\"mini\">Nothing generated yet.</div>\n      </div>\n      <div id=\"overview\" class=\"tabpane\"></div>\n      <div id=\"locations\" class=\"tabpane hidden\"></div>\n      <div id=\"npcs\" class=\"tabpane hidden\"></div>\n      <div id=\"relationships\" class=\"tabpane hidden\"></div>\n      <div id=\"travel\" class=\"tabpane hidden\"></div>\n      <div id=\"map\" class=\"tabpane hidden\"></div>\n      <div id=\"imports\" class=\"tabpane hidden\"></div>\n      <pre id=\"json\" class=\"tabpane hidden item codebox\"></pre>\n    </div>\n  </section>\n</main>\n<div id=\"editorBackdrop\" class=\"modal-backdrop\">\n  <div class=\"modal\">\n    <header><h2 id=\"editorTitle\">Edit Record</h2><button id=\"editorClose\" class=\"secondary small\" type=\"button\">Close</button></header>\n    <div class=\"panel form-grid\">\n      <div class=\"hint\">Edit the JSON directly. Saving only changes the selected record and never rerolls unrelated records.</div>\n      <textarea id=\"editorText\"></textarea>\n      <div class=\"btns\"><button id=\"editorSave\" class=\"gold\" type=\"button\">Save Record</button><button id=\"editorReroll\" class=\"secondary\" type=\"button\">Reroll Selected Record</button></div>\n    </div>\n  </div>\n</div>\n<div id=\"status\" class=\"status\"></div>\n<p class=\"footer-note\">Generated NPCs and locations stay in memory and browser storage until you clear, edit, import over, or reroll them. ZIP exports include HTML, JSON, GeoJSON, DOCX, schedule, relationship, travel, CSS, and JavaScript files.</p>\n<script src=\"js/vendor/jszip.min.js\"></script>\n<script src=\"js/data/generator_rules.js\"></script>\n<script src=\"js/data/life_simulator_race_dropdown_data.js\"></script>\n<script src=\"js/data/settlement_assignments.js\"></script>\n<script src=\"js/data/life_simulator_time_model.js\"></script>\n<script src=\"js/data/life_simulator_location_catalog.js\"></script>\n<script src=\"js/utils.js\"></script>\n<script src=\"js/importers.js\"></script>\n<script src=\"js/generator_core.js\"></script>\n<script src=\"js/renderers.js\"></script>\n<script src=\"js/exporters.js\"></script>\n<script src=\"js/life_generator_app.js\"></script>\n</body>\n</html>\n"
}