{
  "source": "tools/map_asset_packager/templates/interactive_map_builder/index.html",
  "viewHTML": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<title>the source world Blank Settlement Map Builder Templates</title>\n<style>\n:root{ --map-w:2048px; --map-h:1239px; --text:#f5ecdc; --muted:#d3c4b4; --teal:#3d9fa0; --teal2:#8de0dc; --bronze:#b07a3a; --gold:#d7aa63; --danger:#ff6b86; --ok:#8cffc1; --warn:#ffd166; --panel:rgba(13,18,26,.94); --panel2:rgba(21,29,40,.96); --line:rgba(124,231,255,.18); --line2:rgba(124,231,255,.42); --shadow:0 18px 46px rgba(0,0,0,.42); --radius:18px;\n}\n*{box-sizing:border-box}\nhtml,body{margin:0;min-height:100%}\nbody{font:16px/1.48 Georgia,'Times New Roman',serif;color:var(--text);background:#07090a;overflow-x:hidden}\nbody:before{content:\"\";position:fixed;inset:0;z-index:-2;background:radial-gradient(circle at 50% -10%,rgba(141,224,220,.17),transparent 28%),linear-gradient(180deg,rgba(3,7,9,.92),rgba(3,7,9,.78)),linear-gradient(135deg,#0b1118,#19130e 55%,#071014);}\nbody:after{content:\"\";position:fixed;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(124,231,255,.05),transparent 18%,transparent 82%,rgba(215,170,99,.05));pointer-events:none}\nbutton,input,select,textarea{font:inherit}\nbutton,.button{border:0;border-radius:13px;padding:11px 13px;min-height:43px;font-weight:900;cursor:pointer;background:linear-gradient(145deg,var(--teal2),#2fbed8);color:#07111a;box-shadow:0 12px 24px rgba(7,111,140,.2);text-decoration:none;display:inline-flex;align-items:center;justify-content:center;gap:8px}\nbutton:hover,.button:hover{filter:brightness(1.06)}\nbutton.secondary{background:linear-gradient(145deg,rgba(181,138,73,.98),rgba(111,71,32,.98));color:#fff}\nbutton.ghost{background:rgba(255,255,255,.055);color:var(--text);border:1px solid rgba(255,255,255,.1);box-shadow:none}\nbutton.danger{background:rgba(255,107,134,.14);color:#fff;border:1px solid rgba(255,107,134,.45);box-shadow:none}\nbutton.small{min-height:31px;padding:6px 9px;border-radius:10px;font-size:.82rem}\ninput,select,textarea{width:100%;border-radius:13px;border:1px solid var(--line);background:rgba(5,9,14,.82);color:var(--text);padding:11px 12px;min-height:43px;outline:none}\ntextarea{min-height:88px;resize:vertical}\nlabel{display:block;margin:12px 0 6px;color:var(--teal2);font-weight:900;font-size:.9rem}\ncode{color:var(--teal2);font-family:Consolas,monospace}.hidden{display:none!important}\n.shell{width:min(1760px,calc(100% - 24px));margin:16px auto 34px}.topbar{position:sticky;top:10px;z-index:30;display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:center;border:1px solid rgba(255,255,255,.11);border-radius:22px;background:rgba(9,13,18,.88);backdrop-filter:blur(14px);box-shadow:var(--shadow);padding:12px 14px}.seal{width:56px;height:56px;border-radius:50%;border:1px solid var(--line2);background:radial-gradient(circle at 33% 32%,rgba(141,224,220,.55),transparent 30%),linear-gradient(145deg,rgba(25,148,182,.55),rgba(111,71,32,.42));box-shadow:0 0 24px rgba(141,224,220,.18)}\nh1{font-size:clamp(1.25rem,2.4vw,1.9rem);margin:0;text-transform:uppercase;letter-spacing:.09em}.subtitle{margin:3px 0 0;color:var(--muted);font-size:.94rem}.top-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.layout{display:grid;grid-template-columns:390px minmax(0,1fr) 390px;gap:18px;align-items:start;margin-top:18px}@media(max-width:1320px){.layout{grid-template-columns:380px minmax(0,1fr)}.right-col{grid-column:1/-1}.topbar{grid-template-columns:auto 1fr}.top-actions{grid-column:1/-1;justify-content:flex-start}}@media(max-width:920px){.layout{grid-template-columns:1fr}.topbar{position:relative;top:auto}.top-actions{display:grid}}\n.window{border:1px solid var(--line);border-radius:var(--radius);background:linear-gradient(180deg,var(--panel2),var(--panel));box-shadow:var(--shadow);overflow:hidden}.window+.window{margin-top:16px}.window-header{padding:13px 16px;background:rgba(255,255,255,.045);border-bottom:1px solid var(--line);font-weight:900;letter-spacing:.09em;text-transform:uppercase;color:var(--teal2)}.window-header.bronze{color:var(--gold)}.window-body{padding:16px}.button-row,.toolbar{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.toolbar{margin-top:0;margin-bottom:12px}.toolbar>*{flex:1 1 130px}.drop-zone{border:2px dashed rgba(141,224,220,.48);border-radius:18px;padding:20px 16px;text-align:center;background:rgba(255,255,255,.04);cursor:pointer;box-shadow:inset 0 0 30px rgba(61,159,160,.08)}.drop-zone.dragover{border-color:var(--teal2);background:rgba(61,159,160,.18);transform:scale(1.01)}.tiny,.note{font-size:.86rem;color:var(--muted)}.stats,.pill-row{display:flex;gap:8px;flex-wrap:wrap}.pill{border:1px solid var(--line);border-radius:999px;padding:6px 10px;background:rgba(255,255,255,.045);font-size:.82rem;color:var(--muted)}.pill.good{color:var(--ok);border-color:rgba(140,255,193,.35)}.pill.warn{color:var(--warn);border-color:rgba(255,209,102,.35)}.pill.danger{color:var(--danger);border-color:rgba(255,107,134,.35)}.split{display:grid;grid-template-columns:1fr 1fr;gap:10px}.three{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}@media(max-width:760px){.split,.three{grid-template-columns:1fr}.shell{width:calc(100% - 12px)}}\n.list{display:grid;gap:8px;max-height:54vh;overflow:auto;padding-right:4px}.record{border:1px solid var(--line);border-radius:14px;background:linear-gradient(180deg,rgba(18,24,34,.98),rgba(14,19,27,.99));padding:10px}.record.active{border-color:var(--line2);background:linear-gradient(180deg,rgba(25,148,182,.2),rgba(14,19,27,.99))}.record-title{font-weight:900;color:#fff;word-break:break-word}.record-meta{font-size:.8rem;color:var(--muted);display:flex;gap:6px;flex-wrap:wrap}.record-actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:7px}.empty{border:1px dashed rgba(124,231,255,.25);border-radius:14px;padding:24px;min-height:120px;display:grid;place-items:center;text-align:center;color:var(--muted);background:rgba(255,255,255,.03)}\n/* ========================= CENTER MAP MODULE\n========================= */\n.map-module{ width:100%; max-width:var(--map-w); min-height:calc(var(--map-h) + 122px);\n}\n.map-toolbar{ display:flex; align-items:center; justify-content:flex-end; gap:10px; flex-wrap:wrap; margin-bottom:10px;\n}\n.map-scroll{ width:100%; overflow:auto; border:1px solid rgba(124,231,255,.18); border-radius:18px; background:rgba(5,8,12,.86); box-shadow:inset 0 0 45px rgba(0,0,0,.55);\n}\n.map-viewer{ position:relative; width:var(--map-w); height:var(--map-h); min-width:var(--map-w); min-height:var(--map-h); overflow:hidden; background: linear-gradient(45deg,rgba(255,255,255,.04) 25%,transparent 25%), linear-gradient(-45deg,rgba(255,255,255,.04) 25%,transparent 25%), linear-gradient(45deg,transparent 75%,rgba(255,255,255,.04) 75%), linear-gradient(-45deg,transparent 75%,rgba(255,255,255,.04) 75%), rgba(5,8,12,.86); background-size:28px 28px; background-position:0 0,0 14px,14px -14px,-14px 0px;\n}\n.map-coordinate-mask{ position:absolute; left:0; top:1024px; right:0; bottom:0; pointer-events:none; background:linear-gradient(180deg,rgba(77,54,88,.12),rgba(0,0,0,.36)); border-top:1px dashed rgba(215,170,99,.38);\n}\n.map-placeholder{ position:absolute; inset:0; display:grid; place-items:center; text-align:center; padding:28px; color:var(--muted); pointer-events:none;\n}\n.map-placeholder strong{ display:block; color:var(--teal2); font-size:clamp(1.3rem,3vw,2.4rem); text-transform:uppercase; letter-spacing:.08em;\n}\n.map-placeholder span{ display:block; max-width:62ch; margin-top:8px;\n}\n#mapImage,\n#mapFrame{ position:absolute; inset:0; width:100%; height:100%; border:0; object-fit:contain; background:#07090a;\n}\n#mapFrame{display:none}\n.map-pin{ position:absolute; width:24px; height:24px; min-width:24px; min-height:24px; padding:0; border-radius:50%; transform:translate(-50%,-50%); background: radial-gradient(circle at 35% 35%,#fff,transparent 24%), linear-gradient(145deg,var(--teal2),var(--teal)); border:2px solid #07111a; box-shadow:0 6px 16px rgba(0,0,0,.55),0 0 18px rgba(124,231,255,.22); cursor:grab; z-index:5;\n}\n.map-pin:active{cursor:grabbing}\n.map-pin::after{ content:attr(data-label); position:absolute; left:50%; top:100%; transform:translateX(-50%); margin-top:4px; white-space:nowrap; padding:3px 7px; border-radius:999px; font-size:.72rem; color:#061113; background:rgba(141,224,220,.92); border:1px solid rgba(0,0,0,.25); box-shadow:0 4px 12px rgba(0,0,0,.4);\n}\n.map-status{ color:var(--muted); font-size:.9rem;\n}\n.toast{position:fixed;right:18px;bottom:18px;z-index:100;background:#0f1115;border:1px solid var(--line2);box-shadow:0 20px 60px rgba(0,0,0,.5);padding:12px 14px;border-radius:13px;color:var(--text);max-width:460px;opacity:0;transform:translateY(10px);pointer-events:none;transition:.2s}.toast.show{opacity:1;transform:translateY(0)}\n.report{white-space:pre-wrap;font-family:Consolas,monospace;background:rgba(0,0,0,.25);border:1px solid var(--line);border-radius:13px;padding:12px;max-height:340px;overflow:auto;color:#dfe}.import-table{width:100%;border-collapse:collapse;font-size:.82rem}.import-table th,.import-table td{border-bottom:1px solid rgba(124,231,255,.14);padding:6px;text-align:left;vertical-align:top}.import-table th{color:var(--teal2)} .index-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px;margin-top:18px}.template-card{border:1px solid var(--line);border-radius:18px;background:linear-gradient(180deg,var(--panel2),var(--panel));padding:18px;box-shadow:var(--shadow)}.template-card h2{margin:0 0 8px;color:var(--teal2);text-transform:uppercase;letter-spacing:.08em}.template-card p{color:var(--muted)}.template-card .button{margin-top:8px}\n</style>\n</head>\n<body>\n<div class=\"shell\">\n<header class=\"topbar\"><div class=\"seal\"></div><div><h1>Blank Settlement Map Builder Templates</h1><p class=\"subtitle\">Four clean template starters with no named NPCs, no named locations, no attached map, and export-ready placeholder capacity.</p></div></header>\n<main class=\"index-grid\">\n<section class=\"template-card\"><h2>Capital City</h2><p><strong>1,312</strong> location slots<br><strong>3,588</strong> named NPC slots<br><strong>753</strong> NPC world-travel slots (21%)</p><a class=\"button\" href=\"templates/capital_city_map_builder_template.html\">Open Capital City Template</a></section>\n<section class=\"template-card\"><h2>City</h2><p><strong>1,000</strong> location slots<br><strong>2,700</strong> named NPC slots<br><strong>486</strong> NPC world-travel slots (18%)</p><a class=\"button\" href=\"templates/city_map_builder_template.html\">Open City Template</a></section>\n<section class=\"template-card\"><h2>Town</h2><p><strong>220</strong> location slots<br><strong>600</strong> named NPC slots<br><strong>54</strong> NPC world-travel slots (9%)</p><a class=\"button\" href=\"templates/town_map_builder_template.html\">Open Town Template</a></section>\n<section class=\"template-card\"><h2>Village</h2><p><strong>60</strong> location slots<br><strong>160</strong> named NPC slots<br><strong>5</strong> NPC world-travel slots (3%)</p><a class=\"button\" href=\"templates/village_map_builder_template.html\">Open Village Template</a></section>\n<section class=\"card\"><h2>Embedded biome JSON merge</h2><p>Each template now includes hidden biome profile JSON for its settlement size. Pick up to three biome profiles and use <strong>Populate Location Types</strong> to divide the allotted location slots evenly across those selected biome profiles. Three choices use approximately 33.33% from each biome JSON, while keeping names blank.</p></section><section class=\"card\"><h2>Coordinate Tracking Added</h2><p>Each template now detects latitude/longitude from uploaded settlement JSON, stores lat/lon on location pins, resolves NPC current coordinates, and prepares skyship, rail, steamship, portal, ferry, submarine, and caravan route records as coordinate paths.</p></section>\n</main></div></body></html>"
}