{
  "source": "tools/map_scanner_generator/name_generator.html",
  "viewHTML": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<title>the source world Settlement Name Generator Asset</title>\n<style> :root { --bg: #071014; --panel: rgba(8, 22, 28, 0.92); --panel-2: rgba(12, 34, 42, 0.95); --cyan: #00ffff; --cyan-soft: rgba(0,255,255,.16); --ink: #f5fbff; --muted: #a9c8d0; --gold: #e8c76e; --danger: #ff5a7a; --ok: #69ffb0; --border: rgba(0,255,255,.35); --shadow: 0 18px 55px rgba(0,0,0,.55);\n}\n* { box-sizing: border-box; }\nbody { margin: 0; min-height: 100vh; font-family: Georgia, \"Times New Roman\", serif; color: var(--ink); background: radial-gradient(circle at 15% 20%, rgba(0,255,255,.12), transparent 28%), radial-gradient(circle at 80% 10%, rgba(232,199,110,.08), transparent 20%), linear-gradient(135deg, #020607 0%, #071014 45%, #101013 100%);\n}\nbody::before { content:\"\"; position: fixed; inset: 0; pointer-events: none; background-image: linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px); background-size: 34px 34px; mask-image: radial-gradient(circle at center, black 0%, transparent 82%);\n}\nheader { padding: 34px 22px 18px; text-align: center;\n}\nh1 { margin: 0; font-size: clamp(2rem, 5vw, 4.4rem); letter-spacing: .07em; color: var(--cyan); text-shadow: 0 0 22px rgba(0,255,255,.35);\n}\n.subtitle { max-width: 980px; margin: 12px auto 0; color: var(--muted); line-height: 1.55; font-size: 1.02rem;\n}\n.shell { width: min(1240px, calc(100% - 28px)); margin: 0 auto 34px; display: grid; grid-template-columns: 390px 1fr; gap: 18px;\n}\n.card { border: 1px solid var(--border); background: var(--panel); border-radius: 22px; box-shadow: var(--shadow); overflow: hidden;\n}\n.card h2 { margin: 0; padding: 16px 18px; color: var(--cyan); border-bottom: 1px solid rgba(0,255,255,.22); background: linear-gradient(90deg, rgba(0,255,255,.13), transparent); font-size: 1.25rem;\n}\n.form { padding: 18px; display: grid; gap: 14px;\n}\nlabel { display: block; color: var(--gold); font-weight: bold; margin-bottom: 7px; letter-spacing: .025em;\n}\nselect, input[type=\"number\"], input[type=\"text\"], textarea { width: 100%; padding: 12px 13px; border-radius: 13px; border: 1px solid rgba(0,255,255,.36); background: #08171d; color: var(--ink); outline: none; font-size: 1rem; font-family: inherit;\n}\ntextarea { min-height: 90px; resize: vertical; }\nselect:focus, input:focus, textarea:focus { box-shadow: 0 0 0 3px rgba(0,255,255,.13);\n}\n.row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px;\n}\n.checkbox { display: flex; gap: 10px; align-items: center; color: var(--muted); line-height: 1.35;\n}\n.checkbox input { transform: scale(1.15); accent-color: var(--cyan); }\n.btns { display: grid; grid-template-columns: 1fr 1fr; gap: 10px;\n}\nbutton { border: 1px solid rgba(0,255,255,.45); color: #031014; background: linear-gradient(180deg, #64ffff, #00c6c6); padding: 12px 14px; border-radius: 14px; font-weight: 800; cursor: pointer; font-family: inherit; font-size: .98rem; box-shadow: 0 8px 22px rgba(0,255,255,.12);\n}\nbutton.secondary { background: transparent; color: var(--cyan);\n}\nbutton.warning { background: transparent; color: var(--danger); border-color: rgba(255,90,122,.45);\n}\nbutton:hover { filter: brightness(1.08); transform: translateY(-1px); }\n.meta { margin-top: 6px; border: 1px dashed rgba(0,255,255,.28); border-radius: 16px; padding: 12px; background: rgba(0,255,255,.06); color: var(--muted); line-height: 1.5;\n}\n.meta strong { color: var(--ink); }\n.results { padding: 18px;\n}\n.toolbar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: space-between; margin-bottom: 14px;\n}\n.search { max-width: 310px;\n}\n.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(245px, 1fr)); gap: 12px;\n}\n.name-card { position: relative; border: 1px solid rgba(0,255,255,.24); border-radius: 18px; padding: 14px; background: linear-gradient(145deg, rgba(0,255,255,.08), rgba(255,255,255,.025)), rgba(255,255,255,.025); min-height: 150px;\n}\n.name { font-size: 1.36rem; color: #fff; margin: 0 0 7px; line-height: 1.2;\n}\n.name small { display: block; color: var(--cyan); font-size: .78rem; margin-top: 5px; letter-spacing: .04em;\n}\n.tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0;\n}\n.tag { border: 1px solid rgba(232,199,110,.35); color: var(--gold); border-radius: 999px; padding: 4px 8px; font-size: .8rem;\n}\n.mini { color: var(--muted); font-size: .9rem; line-height: 1.4;\n}\n.copy { margin-top: 11px; width: 100%; padding: 8px 9px; border-radius: 11px;\n}\n.history { padding: 16px 18px 20px; border-top: 1px solid rgba(0,255,255,.16);\n}\n.history-list { display: grid; gap: 8px; max-height: 250px; overflow: auto; padding-right: 5px;\n}\n.history-item { border: 1px solid rgba(255,255,255,.08); background: rgba(255,255,255,.035); border-radius: 12px; padding: 9px 10px; color: var(--muted);\n}\n.history-item b { color: var(--ink); }\n.footer-note { width: min(1240px, calc(100% - 28px)); margin: 0 auto 30px; color: var(--muted); text-align: center; line-height: 1.5; font-size: .92rem;\n}\n@media (max-width: 920px) { .shell { grid-template-columns: 1fr; } .row, .btns { grid-template-columns: 1fr; } header { padding-top: 24px; }\n}\n@media print { body { background: white; color: black; } .card { box-shadow: none; border-color: #333; background: white; } h1, .card h2, label { color: black; text-shadow: none; } button, .toolbar, .form, .history { display: none !important; } .shell { display:block; width: 100%; }\n} /* Asset-mode refinements */\nbody.bng-embedded { min-height: auto; background: transparent;\n}\nbody.bng-embedded::before { display: none;\n}\n.bng-asset-note { width: min(1240px, calc(100% - 28px)); margin: 0 auto 16px; border: 1px dashed rgba(0,255,255,.32); border-radius: 18px; padding: 12px 16px; background: rgba(0,255,255,.06); color: var(--muted); line-height: 1.45;\n}\n.bng-json-tools { display: grid; gap: 10px;\n}\n.bng-json-tools textarea { min-height: 160px; font-family: Consolas, Monaco, monospace; font-size: .88rem;\n}\n.bng-output-table { width: 100%; border-collapse: collapse; overflow: hidden; border-radius: 16px;\n}\n.bng-output-table th,\n.bng-output-table td { border-bottom: 1px solid rgba(0,255,255,.14); padding: 10px 9px; text-align: left; vertical-align: top;\n}\n.bng-output-table th { color: var(--gold); background: rgba(0,255,255,.08);\n}\n.bng-output-table td { color: var(--ink);\n}\n.bng-output-table small { color: var(--muted);\n}\n.bng-pill { display: inline-block; border: 1px solid rgba(232,199,110,.35); color: var(--gold); border-radius: 999px; padding: 3px 8px; margin: 2px 3px 2px 0; font-size: .78rem;\n}\n</style>\n</head>\n<body class=\"bng-embedded\">\n<header> <h1>the source world Settlement Name Generator</h1> <p class=\"subtitle\">Embed-ready asset for settlement generators. It reads racial data from JSON, creates enough NPC names for the requested population, and returns name, race, gender identity, and pronouns for interactive map display.</p>\n</header> <div class=\"bng-asset-note\"> <strong>Asset usage:</strong> include <code>name_generator.js</code>, then call <code>the source worldNameGenerator.generateNPCs(settlementData)</code> from your settlement generator. This HTML file provides an optional in-generator panel and demo harness.\n</div> <main class=\"shell\" id=\"source_world-name-generator-panel\" data-source_world-name-generator> <section class=\"card\"> <h2>Settlement Generator Input</h2> <div class=\"form bng-json-tools\"> <div> <label for=\"bngJsonInput\">Settlement / NPC JSON</label> <textarea id=\"bngJsonInput\" spellcheck=\"false\"></textarea> </div> <div class=\"row\"> <div> <label for=\"bngNpcCount\">Fallback NPC Count</label> <input type=\"number\" id=\"bngNpcCount\" min=\"1\" max=\"2000\" value=\"25\" /> </div> <div> <label for=\"bngSurnameMode\">Surname Style</label> <select id=\"bngSurnameMode\"> <option value=\"category\">Category-based</option> <option value=\"race\">Race-flavored</option> <option value=\"mixed\">Mixed fantasy</option> </select> </div> </div> <div class=\"checkbox\"> <input type=\"checkbox\" id=\"bngTitles\" /> <span>Add occasional steampunk-dark-fantasy honorifics and epithets</span> </div> <div class=\"checkbox\"> <input type=\"checkbox\" id=\"bngFantasyMarks\" checked /> <span>Allow apostrophes, hyphens, and accents in appropriate fantasy names</span> </div> <div class=\"btns\"> <button id=\"bngGenerate\">Generate NPC Names</button> <button class=\"secondary\" id=\"bngCopyJson\">Copy NPC JSON</button> <button class=\"secondary\" id=\"bngDownloadJson\">Download NPC JSON</button> <button class=\"warning\" id=\"bngClear\">Clear Output</button> </div> <div class=\"meta\" id=\"bngStatus\"></div> </div> </section> <section class=\"card\"> <h2>NPC Names for Settlement Map</h2> <div class=\"results\"> <div class=\"toolbar\"> <input class=\"search\" id=\"bngFilter\" type=\"text\" placeholder=\"Filter NPC names, races, pronouns...\" /> <div class=\"mini\" id=\"bngResultCount\">No NPCs generated yet.</div> </div> <div id=\"bngResults\"></div> </div> </section>\n</main> <p class=\"footer-note\">This file is intentionally not a standalone world site. It is an embeddable generator panel for settlement creation workflows.</p> <script src=\"name_generator.js\"></script>\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function () { if (window.the source worldNameGenerator) { window.the source worldNameGenerator.init(\"#source_world-name-generator-panel\"); }\n});\n</script>\n</body>\n</html>"
}