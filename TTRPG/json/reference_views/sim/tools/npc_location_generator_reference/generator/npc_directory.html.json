{
  "source": "tools/npc_location_generator_reference/generator/npc_directory.html",
  "viewHTML": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n<link rel=\"stylesheet\" href=\"generator/site.css\" />\n<script src=\"generator/data-bundle.js\"></script>\n<script src=\"generator/core.js\"></script>\n<script src=\"generator/simulation.js\"></script>\n<script src=\"generator/opents2-life-simulator.js\"></script>\n<script src=\"generator/render.js\"></script>\n<script src=\"generator/structured-npc-location-system.js\"></script>\n<title>the source world Settlement Alignment + NPC Generation</title>\n<style>\n:root{ --align-cyan:#00ffff; --align-cyan-soft:rgba(0,255,255,.16); --align-gold:#e2b866; --align-ink:#090e12; --align-muted:#bfc8c9;\n}\n.alignment-grid{display:grid;gap:14px;}\n.alignment-grid.two{grid-template-columns:repeat(2,minmax(0,1fr));}\n.alignment-tool-panel{border:1px solid rgba(0,255,255,.22);border-radius:16px;padding:12px;background:linear-gradient(180deg,rgba(0,255,255,.07),rgba(0,0,0,.16));box-shadow:inset 0 0 20px rgba(0,0,0,.18);}\n.alignment-tool-panel .subhead{margin:0 0 8px;color:var(--align-cyan);font-size:.78rem;text-transform:uppercase;letter-spacing:.16em;}\n.alignment-axis-card{display:grid;gap:8px;padding:10px;border:1px solid rgba(226,184,102,.35);border-radius:14px;background:rgba(255,255,255,.035);}\n.alignment-axis-heading{display:flex;justify-content:space-between;gap:10px;align-items:baseline;}\n.alignment-axis-heading strong{text-transform:uppercase;letter-spacing:.07em;color:#fff5db;}\n.alignment-axis-heading span{color:var(--align-muted);font-size:.84rem;}\n.alignment-phase-label{color:#f7ead1;font-size:.84rem;}\n.alignment-track{position:relative;height:16px;border-radius:999px;overflow:hidden;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);}\n.alignment-track:after{content:\"\";position:absolute;top:-1px;bottom:-1px;left:50%;width:2px;background:rgba(255,255,255,.22);}\n.alignment-fill{height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--align-gold),var(--align-cyan));transition:width .2s ease;}\n.alignment-phase-cells{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:4px;margin-top:4px;}\n.alignment-phase-cells span{padding:5px 6px;border-radius:10px;text-align:center;font-size:.66rem;line-height:1.14;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.08);color:var(--align-muted);}\n.alignment-phase-cells span.active{background:var(--align-cyan-soft);border-color:rgba(0,255,255,.45);color:#fff;box-shadow:0 0 14px rgba(0,255,255,.12);}\n.alignment-slider-row{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center;}\n.alignment-range{width:100%;accent-color:var(--align-cyan);}\n.alignment-number{min-width:74px;text-align:right;color:#fff5db;font-variant-numeric:tabular-nums;}\n.alignment-poles{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;font-size:.72rem;color:var(--align-muted);text-align:center;text-transform:uppercase;letter-spacing:.05em;}\n.alignment-history{display:grid;gap:6px;max-height:220px;overflow:auto;padding-right:4px;}\n.alignment-history-row{border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:7px 8px;background:rgba(255,255,255,.035);}\n.alignment-history-row b{color:#fff5db;}\n.alignment-history-row small{display:block;color:var(--align-muted);margin-top:2px;}\n.alignment-choice-grid{display:grid;grid-template-columns:repeat(4,minmax(80px,1fr));gap:8px;}\n.alignment-inline-card{margin:-6px 0 12px 0;border:1px solid rgba(0,255,255,.18);border-radius:0 0 14px 14px;padding:10px;background:rgba(0,255,255,.045);}\n.alignment-inline-card .mini-axis{display:grid;grid-template-columns:96px 1fr auto;gap:8px;align-items:center;margin:5px 0;}\n.alignment-inline-card .mini-axis b{font-size:.72rem;color:#fff5db;text-transform:uppercase;}\n.alignment-inline-card .mini-axis span{font-size:.72rem;color:var(--align-muted);}\n.alignment-actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center;}\n.alignment-notice{padding:10px;border-radius:12px;border:1px solid rgba(0,255,255,.22);background:rgba(0,255,255,.06);color:#f2eadb;}\n@media (max-width:900px){.alignment-grid.two{grid-template-columns:1fr}.alignment-choice-grid{grid-template-columns:repeat(2,minmax(0,1fr));}.alignment-inline-card .mini-axis{grid-template-columns:1fr;}}\n</style>\n<script src=\"generator/npc-page.js\" defer></script>\n</head>\n<body>\n<div class=\"site-shell\"> <header class=\"topbar\"> <div class=\"brand\"> <div class=\"seal\"></div> <div> <h1>the source world Settlement Alignment + NPC Generation</h1> <p>Generate NPC lives, track each NPC alignment from generation onward, and maintain the settlement alignment preference for visitors on the same settlement management page.</p> </div> </div> <nav class=\"nav\"> <a class=\"\" href=\"source_world_map_PLAYER.html\">Map + settlement</a> <a class=\"active\" href=\"npc_directory.html\">NPC generation</a> <a class=\"\" href=\"location_directory.html\">Location generation</a> <a class=\"\" href=\"family_tree.html\">Family trees</a> <a class=\"\" href=\"dm_editor.html#dm-editor\">DM editor</a> </nav> </header> <div class=\"grid two\"> <aside> <section class=\"panel\"> <div class=\"panel-head\"><h2>NPC generation</h2></div> <div class=\"panel-body\"> <label><span>NPC count</span><input id=\"npcTargetPage\" type=\"number\" min=\"1\" max=\"1200\"></label> <div class=\"button-row\"> <button class=\"primary\" id=\"generateNpcPageBtn\">Generate NPC lives</button> <button id=\"refreshNpcPageBtn\">Refresh living indexes</button> </div> <p id=\"npcPageStatus\" class=\"small\">Uses the current settlement and locations from page 1, or creates locations first if needed.</p> </div> </section> <section class=\"panel\"> <div class=\"panel-head\"><h2>NPC alignment choices</h2></div> <div class=\"panel-body\" id=\"npcChoiceControls\"> <label><span>Choice preset</span><select id=\"alignmentChoicePreset\"></select></label> <label><span>Choice note</span><input id=\"alignmentChoiceNote\" placeholder=\"Example: protected a visitor during a dispute\"></label> <div class=\"alignment-choice-grid\"> <label><span>Altruism</span><input id=\"delta-altruism\" type=\"number\" step=\"25\" value=\"0\"></label> <label><span>Lawfulness</span><input id=\"delta-lawfulness\" type=\"number\" step=\"25\" value=\"0\"></label> <label><span>Cooperation</span><input id=\"delta-cooperation\" type=\"number\" step=\"25\" value=\"0\"></label> <label><span>Honor</span><input id=\"delta-honor\" type=\"number\" step=\"25\" value=\"0\"></label> </div> <div class=\"button-row\"> <button class=\"primary\" id=\"applyNpcAlignmentChoiceBtn\">Apply to selected NPC</button> <button id=\"undoNpcAlignmentChoiceBtn\">Undo last NPC change</button> </div> <p class=\"small\">Click an NPC card first, then apply a choice. Each change is saved into that NPC’s alignment history.</p> </div> </section> <section class=\"panel\"> <div class=\"panel-head\"><h2>Filters</h2></div> <div class=\"panel-body\"> <label><span>Search NPCs</span><input id=\"npcSearch\" placeholder=\"library, date, dragonborn, rail attendant...\"></label> <label><span>Race</span><select id=\"raceFilter\"></select></label> <label><span>Current scenario</span><select id=\"scenarioFilter\"></select></label> <label><span>Alignment leaning</span><select id=\"alignmentFilter\"></select></label> <div class=\"button-row\"><button id=\"exportBtn\">Export JSON</button></div> <label class=\"file-input\"><span>Import JSON state</span><input id=\"importFile\" type=\"file\" accept=\"application/json,.json\"></label> <div id=\"summaryBox\" class=\"stat-grid\"></div> </div> </section> </aside> <main> <section class=\"panel\"> <div class=\"panel-head\"><h2>Settlement alignment preference for visitors</h2></div> <div class=\"panel-body\"> <div id=\"settlementAlignmentPreferencePanel\" class=\"alignment-grid\"></div> </div> </section> <section class=\"panel\"> <div class=\"panel-head\"><h2>Selected NPC alignment</h2></div> <div class=\"panel-body\"> <div id=\"npcAlignmentTrackerPanel\" class=\"alignment-grid\"></div> </div> </section> <section class=\"panel\"> <div class=\"panel-head\"><h2>Generated people</h2></div> <div class=\"panel-body\"><div id=\"npcList\" class=\"card-list\"></div></div> </section> </main> </div>\n</div>\n</body>\n</html>"
}