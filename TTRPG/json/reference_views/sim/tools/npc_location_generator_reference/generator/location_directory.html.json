  "viewHTML": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n<link rel=\"stylesheet\" href=\"assets/css/site.css\" />\n<script src=\"assets/js/data-bundle.js\"></script>\n<script src=\"assets/js/core.js\"></script>\n<script src=\"assets/js/simulation.js\"></script>\n<script src=\"assets/js/opents2-life-simulator.js\"></script>\n<script src=\"assets/js/render.js\"></script>\n<script src=\"assets/js/structured-npc-location-system.js\"></script>\n<title>the source world Location Generation</title></head><body><div class=\"site-shell\"><header class=\"topbar\"><div class=\"brand\"><div class=\"seal\"></div><div><h1>the source world Location Generation</h1><p>Generate visitable locations and verify generated NPCs are assigned as residents, employees, scheduled visitors, travelers, and home occupants.</p></div></div><nav class=\"nav\"><a class=\"\" href=\"source_world_map_PLAYER.html\">Map + settlement</a><a class=\"\" href=\"npc_directory.html\">NPC generation</a><a class=\"active\" href=\"location_directory.html\">Location generation</a><a class=\"\" href=\"family_tree.html\">Family trees</a><a class=\"\" href=\"dm_editor.html#dm-editor\">DM editor</a></nav></header>\n<div class=\"grid two\"><aside><section class=\"panel\"><div class=\"panel-head\"><h2>Location generation</h2></div><div class=\"panel-body\"><label><span>Location count</span><input id=\"locationTargetPage\" type=\"number\" min=\"1\" max=\"600\"></label><div class=\"button-row\"><button class=\"primary\" id=\"generateLocationPageBtn\">Generate locations + assign NPCs</button><button id=\"assignNpcLocationsBtn\">Assign existing NPCs</button></div><p id=\"locationPageStatus\" class=\"small\">Regenerates locations and keeps existing NPCs assigned to homes, jobs, and visits whenever possible.</p></div></section><section class=\"panel\"><div class=\"panel-head\"><h2>Filters</h2></div><div class=\"panel-body\"><label><span>Search locations and inventory</span><input id=\"locationSearch\" placeholder=\"breakfast, armor, room, dagger, ferry, library...\"></label><label><span>Category</span><select id=\"categoryFilter\"></select></label><div class=\"button-row\"><button id=\"exportBtn\">Export JSON</button></div><label class=\"file-input\"><span>Import JSON state</span><input id=\"importFile\" type=\"file\" accept=\"application/json,.json\"></label><div id=\"summaryBox\" class=\"stat-grid\"></div></div></section></aside><main><section class=\"panel\"><div class=\"panel-head\"><h2>Visitable places</h2></div><div class=\"panel-body\"><div id=\"locationList\" class=\"card-list\"></div></div></section></main></div></div><script src=\"assets/js/location-page.js\"></script></body></html>"
