  "viewHTML": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n<link rel=\"stylesheet\" href=\"assets/css/site.css\" />\n<script src=\"assets/js/data-bundle.js\"></script>\n<script src=\"assets/js/core.js\"></script>\n<script src=\"assets/js/simulation.js\"></script>\n<script src=\"assets/js/opents2-life-simulator.js\"></script>\n<script src=\"assets/js/render.js\"></script>\n<script src=\"assets/js/structured-npc-location-system.js\"></script>\n<title>the source world DM Editor</title></head><body id=\"dm-editor\"><div class=\"site-shell\"><header class=\"topbar\"><div class=\"brand\"><div class=\"seal\"></div><div><h1>the source world DM Editor</h1><p>Back-door management tools for import, export, raw JSON inspection, diagnostics, regeneration, and player-state snapshots.</p></div></div><nav class=\"nav\"><a class=\"\" href=\"source_world_map_PLAYER.html\">Map + settlement</a><a class=\"\" href=\"npc_directory.html\">NPC generation</a><a class=\"\" href=\"location_directory.html\">Location generation</a><a class=\"\" href=\"family_tree.html\">Family trees</a><a class=\"active\" href=\"dm_editor.html#dm-editor\">DM editor</a></nav></header>\n<div class=\"grid two\"><aside><section class=\"panel\"><div class=\"panel-head\"><h2>Actions</h2></div><div class=\"panel-body\"><label class=\"file-input\"><span>Import JSON state</span><input id=\"importFile\" type=\"file\" accept=\"application/json,.json\"></label><div class=\"button-row\"><button class=\"primary\" id=\"regenBtn\">Regenerate using saved settings</button><button id=\"exportBtn\">Export JSON</button><button id=\"snapshotBtn\">Export state loader HTML</button><button class=\"danger\" id=\"clearBtn\">Clear browser data</button></div><p id=\"statusLine\" class=\"small\">Ready.</p></div></section><section class=\"panel\"><div class=\"panel-head\"><h2>Diagnostics</h2></div><div class=\"panel-body\"><div id=\"diagnostics\" class=\"stat-grid\"></div></div></section><section class=\"panel\"><div class=\"panel-head\"><h2>Log</h2></div><div class=\"panel-body\"><div id=\"logBox\" class=\"codebox\"></div></div></section></aside><main><section class=\"panel\"><div class=\"panel-head\"><h2>Raw saved JSON</h2><span class=\"small\">Edit carefully. Invalid JSON will not save.</span></div><div class=\"panel-body\"><textarea id=\"rawState\" class=\"codebox\" style=\"width:100%;min-height:680px\"></textarea></div></section></main></div></div><script src=\"assets/js/dm-page.js\"></script></body></html>"
