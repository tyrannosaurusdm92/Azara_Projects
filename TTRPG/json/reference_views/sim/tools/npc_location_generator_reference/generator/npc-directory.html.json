{
  "source": "tools/npc_location_generator_reference/generator/npc-directory.html",
  "viewHTML": "<!doctype html>\n<html lang=\"en\">\n<head> <meta charset=\"utf-8\" /> <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" /> <title>the source world NPC Directory + Family Tree</title> <meta name=\"description\" content=\"Standalone NPC directory, relationship generator, and auto-filled family tree creator for the source world.\" /> <link rel=\"stylesheet\" href=\"npc-all.css\" />\n</head>\n<body> <div class=\"site-shell\"> <header class=\"hero\"> <div class=\"brand\"> <div class=\"seal\" aria-hidden=\"true\"></div> <div> <h1>NPC Directory + Family Tree Studio</h1> <p id=\"projectSubtitle\" class=\"subtitle\">Generate NPC households, layered relationships, and auto-filled family trees from relationship records.</p> </div> </div> <div class=\"hero-actions\"> <button id=\"generateBtn\" class=\"primary\" type=\"button\">Generate network</button> <button id=\"rebuildBtn\" type=\"button\">Rebuild tree fields</button> <button id=\"exportBtn\" type=\"button\">Export JSON</button> </div> </header> <div class=\"page-links\"><a href=\"npc-directory.html\">NPC Directory</a><a href=\"family-tree.html\">Family Tree</a></div> <nav class=\"tabs\" aria-label=\"Studio sections\"> <button class=\"active\" data-tab=\"studio\" type=\"button\">Studio</button> <button data-tab=\"relationships\" type=\"button\">Relationship table</button> <button data-tab=\"json\" type=\"button\">JSON / import</button> </nav> <main data-tab-panel=\"studio\"> <div class=\"layout\"> <aside class=\"panel\"> <div class=\"panel-head\"><h2>Generator controls</h2><span>local browser state</span></div> <div class=\"panel-body controls\"> <label class=\"field\"><span>Seed</span><input id=\"seedInput\" value=\"the source world-family-demo\" /></label> <label class=\"field\"><span>Households to generate</span><input id=\"householdCount\" type=\"number\" min=\"1\" max=\"30\" value=\"6\" /></label> <div class=\"button-row\"> <button id=\"generateBtnSide\" class=\"primary\" type=\"button\" onclick=\"document.getElementById('generateBtn').click()\">Generate</button> <button id=\"clearBtn\" class=\"danger\" type=\"button\">Clear</button> </div> <div id=\"noticeBox\" class=\"notice\">Family-tree fields are rebuilt from relationship records after every generation/import.</div> <div id=\"statsBox\" class=\"stat-grid\"></div> <label class=\"field\"><span>Search households / NPCs</span><input id=\"householdSearch\" placeholder=\"Surname, role, name, home, alignment...\" /></label> <label class=\"field\"><span>Alignment leaning filter</span><select id=\"alignmentFilter\"></select></label> <div id=\"npcChoiceControls\" class=\"alignment-tool-panel alignment-control-block\"> <div class=\"subhead\">NPC alignment choices</div> <label class=\"field\"><span>Choice preset</span><select id=\"alignmentChoicePreset\"></select></label> <label class=\"field\"><span>Choice note</span><input id=\"alignmentChoiceNote\" placeholder=\"Example: protected a visitor during a dispute\" /></label> <div class=\"alignment-choice-grid\"> <label class=\"field\"><span>Altruism</span><input id=\"delta-altruism\" type=\"number\" step=\"25\" value=\"0\" /></label> <label class=\"field\"><span>Lawfulness</span><input id=\"delta-lawfulness\" type=\"number\" step=\"25\" value=\"0\" /></label> <label class=\"field\"><span>Cooperation</span><input id=\"delta-cooperation\" type=\"number\" step=\"25\" value=\"0\" /></label> <label class=\"field\"><span>Honor</span><input id=\"delta-honor\" type=\"number\" step=\"25\" value=\"0\" /></label> </div> <div class=\"button-row\"> <button class=\"primary\" id=\"applyNpcAlignmentChoiceBtn\" type=\"button\">Apply to selected NPC</button> <button id=\"undoLastNpcAlignmentChoiceBtn\" type=\"button\">Undo last NPC change</button> </div> <p class=\"small\">Select an NPC, then apply a choice. Each change is saved into that NPC’s alignment history.</p> </div> </div> </aside> <section class=\"panel\"> <div class=\"panel-head\"><h2>Households</h2><span>select a household or NPC</span></div> <div class=\"panel-body\"> <div id=\"householdList\" class=\"household-list\"></div> </div> </section> </div> <div class=\"grid-two\" style=\"margin-top:16px\"> <section class=\"panel\"> <div class=\"panel-head\"><h2>Selected NPC</h2><span><select id=\"npcSelect\" aria-label=\"Select NPC\"></select></span></div> <div class=\"panel-body\" id=\"npcDetail\"></div> </section> <section class=\"panel\"> <div class=\"panel-head\"><h2>Tree view</h2><span><select id=\"treeMode\" aria-label=\"Tree mode\"><option value=\"household\">Household tree</option><option value=\"npc\">Selected NPC tree</option></select></span></div> <div class=\"panel-body\"> <div class=\"button-row\" style=\"margin-bottom:12px\"><button id=\"downloadSvgBtn\" type=\"button\">Download current SVG tree</button></div> <div id=\"treeCanvas\"></div> </div> </section> </div> <div class=\"grid-two alignment-section-grid\" style=\"margin-top:16px\"> <section class=\"panel\"> <div class=\"panel-head\"><h2>Settlement alignment preference for visitors</h2><span>same settlement page</span></div> <div class=\"panel-body\"> <div id=\"settlementAlignmentPreferencePanel\" class=\"alignment-grid\"></div> </div> </section> <section class=\"panel\"> <div class=\"panel-head\"><h2>Selected NPC alignment</h2><span>generation + choice history</span></div> <div class=\"panel-body\"> <div id=\"npcAlignmentTrackerPanel\" class=\"alignment-grid\"></div> </div> </section> </div> </main> <main data-tab-panel=\"relationships\" hidden> <section class=\"panel\"> <div class=\"panel-head\"><h2>Layered relationship table</h2><span>shown for selected NPC</span></div> <div class=\"panel-body\"> <label class=\"field\" style=\"margin-bottom:12px\"><span>Search current NPC relationships</span><input id=\"relationshipSearch\" placeholder=\"friend, parent, conflict, coworker...\" /></label> <div id=\"relationshipTable\" class=\"table-wrap\"></div> </div> </section> </main> <main data-tab-panel=\"json\" hidden> <div class=\"grid-two\"> <section class=\"panel\"> <div class=\"panel-head\"><h2>Import / export</h2><span>state JSON</span></div> <div class=\"panel-body controls\"> <label class=\"file-input\"><span>Import relationship state JSON</span><input id=\"importFile\" type=\"file\" accept=\"application/json,.json\" /></label> <div class=\"button-row\"> <button type=\"button\" onclick=\"document.getElementById('exportBtn').click()\">Export full JSON</button> <button type=\"button\" onclick=\"document.getElementById('rebuildBtn').click()\">Rebuild from relationships</button> </div> <div class=\"notice\">Imports can be generated by this site or adapted from your existing NPC relationship state. The rebuilt <code>familyTree</code> fields come from relationship edges like Parent, Child, Guardian, Ward, Partner, Sibling, Grandparent, and Chosen family. Alignment tracking is also saved in the exported state: the settlement keeps a visitor preference profile, every NPC keeps an alignment record, and NPC choices retain before/after scores and deltas.</div> </div> </section> <section class=\"panel\"> <div class=\"panel-head\"><h2>Compact JSON preview</h2><span>selected NPC tree data</span></div> <div class=\"panel-body\"><pre id=\"jsonPreview\"></pre></div> </section> </div> </main> <p class=\"footer\">Standalone static site. Open <strong>npc-directory.html</strong> for the NPC directory or <strong>family-tree.html</strong> for the tree view. No server or external libraries required.</p> </div> <script src=\"structured-npc-location-system.js\"></script> <script src=\"simulation.js\"></script> <script src=\"opents2-life-simulator.js\"></script> <script src=\"family-page.js\"></script> <script src=\"npc-page.js\"></script>\n</body>\n</html>"
}