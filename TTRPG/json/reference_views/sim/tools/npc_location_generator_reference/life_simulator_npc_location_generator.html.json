{
  "source": "tools/npc_location_generator_reference/life_simulator_npc_location_generator.html",
  "viewHTML": "<!doctype html>\n<html lang=\"en\">\n<head> <meta charset=\"utf-8\" /> <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" /> <title>the source world NPC & Location Generator</title> <link rel=\"stylesheet\" href=\"generator/source_world-npc-location-generator.css\" />\n</head>\n<body> <div class=\"app-shell\"> <header class=\"hero\"> <div> <p class=\"eyebrow\">the source world DM Generator</p> <h1>NPC & Location Generator</h1> <p class=\"lead\">Generate, edit, reroll, import, restore, and export settlement, province, or world-scale NPC/location data. Blank GeoJSON/SVG pins are auto-filled from generated location records.</p> </div> <div class=\"hero-actions\"> <button id=\"saveStateBtn\" class=\"btn secondary\">Save Browser State</button> <button id=\"exportZipBtn\" class=\"btn primary\">Export ZIP Package</button> <button id=\"exportJsonBtn\" class=\"btn secondary\">Export State JSON</button> </div> </header> <nav class=\"tabs\" aria-label=\"Generator sections\"> <button class=\"tab active\" data-tab=\"workspace\">Workspace</button> <button class=\"tab\" data-tab=\"imports\">Imports & Autofill</button> <button class=\"tab\" data-tab=\"locations\">Locations</button> <button class=\"tab\" data-tab=\"npcs\">NPCs</button> <button class=\"tab\" data-tab=\"relationships\">Relationships & Schedules</button> <button class=\"tab\" data-tab=\"geojson\">Map Pins / GeoJSON</button> <button class=\"tab\" data-tab=\"export\">Export Preview</button> </nav> <main> <section id=\"workspace\" class=\"panel active\"> <div class=\"grid two\"> <article class=\"card\"> <h2>Generation Scope</h2> <div class=\"form-grid\"> <label>Scope <select id=\"scopeSelect\"> <option value=\"settlement\">Single settlement</option> <option value=\"province\">Whole province</option> <option value=\"world\">Whole world</option> </select> </label> <label>Province <select id=\"provinceSelect\"></select> </label> <label>Settlement from province <select id=\"settlementSelect\"></select> </label> <label>Settlement name <input id=\"settlementName\" placeholder=\"Settlement name\" /> </label> <label>Settlement type <select id=\"settlementType\"></select> </label> <label>Biome <select id=\"biomeSelect\"></select> </label> <label>Government type <input id=\"governmentType\" placeholder=\"Participatory Democracy\" /> </label> <label>Time zone <input id=\"timeZone\" placeholder=\"UTC-5\" /> </label> <label>Population <input id=\"population\" type=\"number\" min=\"0\" step=\"1\" /> </label> <label>Square miles <input id=\"squareMiles\" type=\"number\" min=\"0\" step=\"0.01\" /> </label> <label>Square kilometers <input id=\"squareKilometers\" type=\"number\" min=\"0\" step=\"0.01\" /> </label> <label>Danger level <select id=\"dangerLevel\"> <option>Low</option><option>Guarded</option><option>Moderate</option><option>High</option><option>Extreme</option> </select> </label> <label class=\"wide\">Settlement tags <input id=\"settlementTags\" placeholder=\"transit hub, coastal, political center\" /> </label> <label class=\"wide\">Settlement alignment preference for visitors <input id=\"alignmentPreference\" placeholder=\"Altruistic • Lawful • Cooperative • Honorable\" /> </label> <label class=\"wide\">Primary deities / sacred influences <input id=\"primaryDeities\" placeholder=\"comma-separated\" /> </label> <label class=\"wide\">Races that live there <textarea id=\"residentRaces\" rows=\"3\" placeholder=\"comma-separated race list\"></textarea> </label> <label class=\"wide\">Seed <input id=\"seedInput\" placeholder=\"the source world-seed\" /> </label> </div> </article> <article class=\"card\"> <h2>Generation Controls</h2> <div class=\"form-grid\"> <label>Location generation mode <select id=\"locationMode\"> <option value=\"settlement\">Generate Settlement</option> <option value=\"category\">Generate Category</option> <option value=\"single\">Generate Single Location</option> <option value=\"missing\">Generate Missing Locations Only</option> <option value=\"expand\">Expand Existing Settlement</option> </select> </label> <label>Location category <select id=\"locationCategorySelect\"></select> </label> <label>Location subcategory <select id=\"locationSubcategorySelect\"></select> </label> <label>Location target <input id=\"locationTarget\" type=\"number\" min=\"1\" step=\"1\" value=\"60\" /> </label> <label>Expansion count <input id=\"expandCount\" type=\"number\" min=\"1\" step=\"1\" value=\"12\" /> </label> <label>NPC target <input id=\"npcTarget\" type=\"number\" min=\"1\" step=\"1\" value=\"160\" /> </label> <label>Scale preset <select id=\"scalePreset\"> <option value=\"custom\">Use custom targets</option> <option value=\"table\">Use NPC scaling table</option> </select> </label> <label>Population race tool <select id=\"raceToolMode\"> <option value=\"mixed\">Generate Mixed Population</option> <option value=\"category\">Generate All Races In Category</option> <option value=\"selected\">Generate Selected Race</option> </select> </label> <label>Race category <select id=\"raceCategorySelect\"></select> </label> <label>Selected race <select id=\"raceSelect\"></select> </label> <label class=\"check\"><input id=\"preserveExisting\" type=\"checkbox\" checked /> Preserve existing records unless selected for reroll</label> <label class=\"check\"><input id=\"includeFivePercent\" type=\"checkbox\" checked /> Apply 5% variance layer</label> <label class=\"check\"><input id=\"generateRelationships\" type=\"checkbox\" checked /> Generate relationships, schedules, travel</label> </div> <div class=\"button-row\"> <button id=\"generateLocationsBtn\" class=\"btn primary\">Generate Locations</button> <button id=\"generateNpcsBtn\" class=\"btn primary\">Generate NPCs</button> <button id=\"generateAllBtn\" class=\"btn primary\">Generate All</button> <button id=\"clearGeneratedBtn\" class=\"btn danger\">Clear Current Settlement</button> </div> <div id=\"statusLine\" class=\"status\">Ready.</div> </article> </div> <section class=\"stats\" id=\"statsBox\"></section> </section> <section id=\"imports\" class=\"panel\"> <div class=\"grid two\"> <article class=\"card\"> <h2>Drag & Drop File Intake</h2> <div id=\"dropZone\" class=\"drop-zone\" tabindex=\"0\"> <strong>Drop files here</strong> <span>JSON, GeoJSON, HTML, DOCX, PDF, SVG, and map images. Files are scanned and used to fill settlement fields and generator context.</span> <input id=\"fileInput\" type=\"file\" multiple accept=\".json,.geojson,.html,.htm,.docx,.pdf,.svg,image/*\" /> </div> <div class=\"button-row\"> <button id=\"scanAutofillBtn\" class=\"btn primary\">Scan & Autofill Boxes</button> <button id=\"applyImportedStateBtn\" class=\"btn secondary\">Restore Imported State JSON</button> <button id=\"clearImportsBtn\" class=\"btn secondary\">Clear Imported Context</button> </div> <ul id=\"fileList\" class=\"file-list\"></ul> </article> <article class=\"card\"> <h2>Map Image Preview</h2> <div id=\"mapPreview\" class=\"map-preview\"><span>No uploaded map image yet.</span></div> <h3>Extracted scan text</h3> <textarea id=\"scanText\" rows=\"14\" placeholder=\"Parsed text appears here. You can also paste lore or settlement notes here before autofill.\"></textarea> </article> </div> </section> <section id=\"locations\" class=\"panel\"> <div class=\"toolbar\"> <input id=\"locationSearch\" placeholder=\"Search locations, items, services, employees...\" /> <select id=\"locationFilterCategory\"><option value=\"\">All categories</option></select> <select id=\"locationRerollField\"> <option value=\"all\">Reroll entire location</option> <option value=\"name\">Name only</option> <option value=\"description\">Description only</option> <option value=\"inventory\">Inventory only</option> <option value=\"services\">Services only</option> <option value=\"employees\">Employees only</option> <option value=\"visitors\">Visitors only</option> </select> <button id=\"rerollSelectedLocationBtn\" class=\"btn secondary\">Reroll Selected Location</button> <button id=\"addLocationBtn\" class=\"btn secondary\">Add Blank Location</button> </div> <div id=\"locationsTable\" class=\"table-wrap\"></div> </section> <section id=\"npcs\" class=\"panel\"> <div class=\"toolbar\"> <input id=\"npcSearch\" placeholder=\"Search NPCs, race, job, relationships, rumors...\" /> <select id=\"npcRoleFilter\"><option value=\"\">All roles</option></select> <select id=\"npcRerollField\"> <option value=\"all\">Reroll entire NPC</option> <option value=\"name\">Name only</option> <option value=\"race\">Race only</option> <option value=\"traits\">Traits only</option> <option value=\"personality\">Personality only</option> <option value=\"rumors\">Rumors only</option> <option value=\"relationships\">Relationships only</option> <option value=\"schedule\">Schedule only</option> <option value=\"employment\">Employment only</option> <option value=\"residence\">Residence only</option> </select> <button id=\"rerollSelectedNpcBtn\" class=\"btn secondary\">Reroll Selected NPC</button> <button id=\"addNpcBtn\" class=\"btn secondary\">Add Blank NPC</button> </div> <div id=\"npcsTable\" class=\"table-wrap\"></div> </section> <section id=\"relationships\" class=\"panel\"> <div class=\"grid two\"> <article class=\"card\"> <h2>Relationship Network</h2> <div class=\"button-row\"> <button id=\"regenerateRelationshipsBtn\" class=\"btn primary\">Regenerate Relationships Only</button> <button id=\"regenerateSchedulesBtn\" class=\"btn primary\">Regenerate Schedules Only</button> </div> <div id=\"relationshipList\"></div> </article> <article class=\"card\"> <h2>Living Schedule / Travel Board</h2> <div id=\"scheduleBoard\"></div> </article> </div> </section> <section id=\"geojson\" class=\"panel\"> <div class=\"grid two\"> <article class=\"card\"> <h2>GeoJSON / SVG Pin Autofill</h2> <p>Imported blank pins keep their geometry. Generated location data fills properties such as name, category, overlay color, employees, visitors, inventory, services, and immersive panel text.</p> <div class=\"button-row\"> <button id=\"fillGeojsonBtn\" class=\"btn primary\">Autofill Imported GeoJSON Pins</button> <button id=\"makeGeojsonBtn\" class=\"btn secondary\">Create GeoJSON From Locations</button> <button id=\"copyGeojsonBtn\" class=\"btn secondary\">Copy GeoJSON</button> </div> <pre id=\"geojsonPreview\" class=\"code-preview\"></pre> </article> <article class=\"card\"> <h2>Overlay Standards</h2> <table class=\"mini-table\"> <thead><tr><th>State</th><th>Opacity</th><th>Border</th></tr></thead> <tbody><tr><td>Default</td><td>0.15</td><td>1.5px</td></tr><tr><td>Hover</td><td>0.30</td><td>2px</td></tr><tr><td>Selected</td><td>0.45</td><td>3px</td></tr><tr><td>District</td><td>0.08</td><td>Inherited</td></tr></tbody> </table> <div id=\"colorLegend\" class=\"legend\"></div> </article> </div> </section> <section id=\"export\" class=\"panel\"> <div class=\"grid two\"> <article class=\"card\"> <h2>ZIP Export Contents</h2> <p>Each export includes settlement HTML, settlement JSON, GeoJSON, NPC data, location data, relationship data, schedule data, embedded CSS, embedded JavaScript, DOCX summary files, uploaded context notes, and restored map assets when available.</p> <div class=\"button-row\"> <button id=\"refreshExportPreviewBtn\" class=\"btn secondary\">Refresh Preview</button> <button id=\"exportZipBtn2\" class=\"btn primary\">Export ZIP Package</button> </div> <ul id=\"exportManifest\" class=\"file-list\"></ul> </article> <article class=\"card\"> <h2>Current State JSON</h2> <textarea id=\"statePreview\" rows=\"22\"></textarea> </article> </div> </section> </main> </div> <script src=\"generator/data-bundle.js\"></script> <script src=\"generator/source_world-generator-extra-data.js\"></script> <script src=\"generator/source_world-npc-location-generator.js\"></script>\n</body>\n</html>"
}